<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App updates: a new version of this app (Settings → App, the notice). Not Project Diablo 2's updates. -->
    <string name="app_update_you_have">You have %1$s</string>
    <string name="app_update_idle">PD2 Launcher has not looked for a new version yet.</string>
    <string name="app_update_checking">Looking for a new version…</string>
    <!-- Under "You have": when the last check was. -->
    <string name="app_update_checked_now">Checked just now.</string>
    <string name="app_update_checked_minutes">Checked %1$d min ago.</string>
    <string name="app_update_checked_one_hour">Checked 1 hour ago.</string>
    <!-- 2 to 47 hours. -->
    <string name="app_update_checked_hours">Checked %1$d hours ago.</string>
    <string name="app_update_checked_days">Checked %1$d days ago.</string>
    <!-- The last check that worked is more than 7 days old, or more than 5 min ahead of the clock (it was set back). -->
    <string name="app_update_not_checked_lately">PD2 Launcher has not looked for a new version for more than a week.</string>
    <string name="app_update_check_offline">Could not look for a new version. Check your connection, then try again.</string>
    <string name="app_update_check_busy">GitHub asks the app to wait before it looks again. Try again in %1$d min.</string>
    <string name="app_update_check_busy_over">The wait is over. Tap Check now to look for a new version.</string>
    <string name="app_update_check_failed">Could not look for a new version. Try again later.</string>
    <string name="app_update_paused">Version %1$s: %2$d of %3$d MB downloaded.</string>
    <string name="app_update_downloading">Downloading: %1$d of %2$d MB</string>
    <string name="app_update_then_android">Then Android asks you to install %1$s.</string>
    <string name="app_update_kept">The app keeps the downloaded %1$d MB.</string>
    <string name="app_update_download_network">The download stopped. Check your connection.</string>
    <string name="app_update_download_failed">The download stopped. Try again.</string>
    <string name="app_update_no_space">Not enough free space. The update needs about %1$d MB, and %2$d MB are free. To free space, go to Settings → Files and saves → Storage.</string>
    <string name="app_update_refused">The download failed the app\'s check and was deleted. Tap the download sign to get it again.</string>
    <string name="app_update_unchecked">This version cannot be checked.</string>
    <string name="app_update_verifying">Checking the download…</string>
    <!-- TalkBack: the progress ring of a running download on a row that is not selected. -->
    <string name="app_update_ring">Downloading %1$s, %2$d %%</string>
    <string name="app_update_ready">Version %1$s is ready to install.</string>
    <string name="app_update_android_asks">Android asks you to install %1$s.</string>
    <string name="app_update_app_closes">The app closes while Android updates it. Your game, characters and settings stay.</string>
    <string name="app_update_allow_note">First, let PD2 Launcher install updates: in Android\'s settings, turn on \"Allow from this source\", then come back. Android can restart the app when you do this.</string>
    <string name="app_update_cancelled">The update was cancelled. Nothing changed.</string>
    <string name="app_update_put_off">The update stopped because the game or other work started. Tap the install sign again when it ends.</string>
    <string name="app_update_install_no_space">Android needs more free space to install the update. Free some space, then tap the install sign.</string>
    <string name="app_update_install_failed">Android did not install the update. Tap the install sign to try again.</string>
    <string name="app_update_wait_game">Close the game first. The update closes the app, and the game with it.</string>
    <string name="app_update_wait_launcher">Close the official PD2 launcher first. The update closes the app, and the launcher with it.</string>
    <string name="app_update_wait_work">Wait until the game\'s download or install ends, or stop it. The update closes the app.</string>
    <string name="app_update_wait_starting">Wait a moment: the game is starting.</string>
    <string name="app_update_wait_preparing">Wait a moment: the app is getting ready.</string>
    <string name="app_update_check_now">Check now</string>
    <string name="app_update_allow">Open Android settings</string>
    <!-- Settings → App → Update channel: the group, its two rows and what each row can say. Stable: GitHub releases. Beta: only GitHub pre-releases. Never "Preview". -->
    <string name="app_update_channel_choice">Update channel</string>
    <string name="app_update_channel_stable">Stable</string>
    <string name="app_update_channel_beta">Beta</string>
    <string name="app_update_none_out">none out now</string>
    <!-- Beta while no beta is out that this build can take (AppUpdate.betaOpen): beside "Beta", greyed. Text for the owner's approval (as Loot filters' line). -->
    <string name="app_update_channel_closed">not available yet</string>
    <!-- On the selected Beta row: the beta has a lower version code than the app, so Android refuses it. %1$s: the version that runs. -->
    <string name="app_update_cannot_install">You cannot install this beta over %1$s. Wait for the next beta.</string>
    <!-- TalkBack: the version chip, and the sign at a row's end. -->
    <string name="app_update_chip">%1$s, what is new, opens in the browser</string>
    <string name="app_update_sign_download">Download %1$s</string>
    <string name="app_update_sign_retry">Try again, %1$s</string>
    <string name="app_update_sign_install">Install %1$s</string>
    <string name="app_update_installed">Installed</string>
    <!-- A build that gets no updates. -->
    <string name="settings_updates_none">This build of PD2 Launcher gets no app updates.</string>
    <!-- TalkBack, after "Version" on Play and after a version chip, while the dot shows: a new version is out and not installed yet. -->
    <string name="app_update_dot">New version available</string>
    <!-- The notice: an Android notification, once per version. Its notification channel's name (not the update channel). -->
    <string name="app_update_channel">App updates</string>
    <string name="app_update_notice_title">A new version of PD2 Launcher is out</string>
    <string name="app_update_notice_text">Version %1$s. Tap to see it in Settings → App.</string>
</resources>
