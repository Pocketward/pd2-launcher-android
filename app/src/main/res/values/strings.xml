    <!-- Session notification. -->
    <string name="notification_channel_name">Session</string>
    <string name="notification_title">PD2 Launcher is running</string>
    <string name="notification_text">The Launcher runs in the background.</string>
    <!-- The notification's button: stops what runs safely and closes the app. -->
    <string name="notification_close">Close</string>
    <!-- While Close runs. -->
    <string name="notification_closing_title">PD2 Launcher is closing</string>
