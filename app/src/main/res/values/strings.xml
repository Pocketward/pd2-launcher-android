    <string name="key_problem_length">This key is too short or too long. A key has 26 letters and numbers.</string>
    <string name="key_problem_16_characters">This is a 16-character key. Only 26-character keys work.</string>
    <string name="key_problem_character">This key has a character that keys never use. Check the key.</string>
    <string name="key_problem_is_lod_key">This is a Lord of Destruction key. Type it in the second field.</string>
    <string name="key_problem_is_d2_key">This is a Diablo II key. Type it in the first field.</string>
    <string name="key_problem_not_valid">This is not a valid key. Check each character.</string>
