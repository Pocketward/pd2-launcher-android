    <string name="check_grant_notifications">Turn on</string>
    <string name="check_grant_battery">Allow</string>

    <!-- Step 1: Check. -->
    <string name="check_title">Checking this device</string>
    <string name="check_intro">First, let\'s make sure this device can run the game.</string>
    <!-- The rows in plain words: the App userland is "Game support files" (its build id shows in
