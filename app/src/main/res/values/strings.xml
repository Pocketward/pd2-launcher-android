    <!-- The Game view before its X screen is up. -->
    <string name="game_view_waiting">Waiting for the X screen. Start the game environment first.</string>

    <!-- Key screen. -->
    <string name="keys_title">Your CD keys</string>
    <string name="keys_intro">Diablo II needs your own two keys. The app keeps them only in its memory until the install uses them. The installed game keeps them, as Diablo II requires.</string>
    <string name="keys_d2_label">Diablo II key</string>
    <string name="keys_lod_label">Lord of Destruction key</string>
    <string name="keys_placeholder">XXXX-XXXX-XXXX-XXXX-XXXX-XX</string>
    <string name="keys_hint">Enter both keys: letters, numbers and dashes.</string>
    <string name="keys_terms_notice">Installing means you accept Blizzard\'s End User License Agreement for both games.</string>
    <string name="keys_where_label">Where to find them</string>
    <string name="keys_where">Blizzard account → Games &amp; Subscriptions → Diablo II, or the manual and CD case.</string>
    <string name="keys_example_label">A key looks like</string>
    <string name="keys_example">ABCD-EFGH-JKLM-NPQR-STVW-XY</string>
    <string name="keys_terms_link">Read Blizzard\'s terms</string>
    <string name="keys_show">Show keys</string>
    <string name="keys_show_body">Keys are hidden unless you choose to see them.</string>
    <string name="keys_install">Agree and install</string>
    <!-- Download (Blizzard's two small downloaders and Project Diablo 2's files) while the keys are typed (KeysWhileDownloading.line): one small line under the intro. -->
    <string name="keys_installers_running">Getting the installers ready…</string>
    <string name="keys_installers_percent">Getting the installers ready: %1$d%%</string>
    <string name="keys_installers_done">The installers are ready.</string>
    <string name="keys_installers_stopped">Getting the installers ready has stopped.</string>
