    <string name="settings_renderer_direct_draw_body">The game\'s own older way to draw. Use it only when Glide does not start.</string>
    <!-- Display → Game resolution: the row shows the size; its sheet says what it does at the top. -->
    <string name="settings_section_resolution">Game resolution</string>
    <string name="settings_resolution_body">Applies at the next Play. The size the game draws at, also for the official PD2 launcher and a game it starts. The game\'s own size shows the game as PD2 made it. Its graphics options are in the game: Options, Video Options, D2GL.</string>
    <string name="settings_resolution_running">The game or the official launcher that runs now has another size. The new size applies when you start it again.</string>
    <string name="settings_resolution_game_size">Game\'s own size (%1$d × %2$d)</string>
    <string name="settings_resolution_game_size_body">The size PD2 was made for. Recommended.</string>
    <string name="settings_resolution_full_body">The full size of this screen, which is smaller than the size PD2 was made for.</string>
    <string name="settings_resolution_custom">Custom (%1$d × %2$d)</string>
    <string name="settings_resolution_custom_choice">Custom…</string>
    <string name="settings_resolution_custom_body">A width and a height that you type, up to the size of this screen.</string>
    <string name="settings_resolution_custom_width">Width</string>
    <string name="settings_resolution_custom_height">Height</string>
    <string name="settings_resolution_custom_range">Width from %1$d to %3$d, an even number. Height from %2$d to %4$d, a multiple of 4.</string>
    <!-- Under Game resolution and in Custom, only for a size with fewer than 800 columns or 600 lines. -->
    <string name="settings_resolution_launcher_cut">The official PD2 launcher does not get smaller than 800 × 600. At a smaller size, part of its window is cut off.</string>
    <string name="settings_resolution_custom_wrong">This size is not possible. Width from %1$d to %3$d, an even number. Height from %2$d to %4$d, a multiple of 4.</string>
    <string name="settings_section_display">Picture size</string>
