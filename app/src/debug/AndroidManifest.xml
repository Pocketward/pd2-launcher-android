<?xml version="1.0" encoding="utf-8"?>
<!-- The development build only: its app update test feed may be served over HTTP from this
     device's own localhost (res/xml/test_feed_network.xml). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/test_feed_network">
        <!-- The in-game overlay with fake state over a neutral background, for design reviews
             (OverlayPreviewActivity.kt). In a process of its own, so it shares no state with the
             app's screens or a running game. Landscape, as the Game view always is. -->
        <activity
            android:name="com.pd2launcher.app.OverlayPreviewActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:process=":overlay_preview"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- The debug pad injector (DebugPadReceiver.kt): device tests
             play the game with a scripted controller. The sender must hold
             android.permission.DUMP, which the shell has and no installed app gets unless the shell
             grants it. Sent to by name (am broadcast -n), so it needs no intent filter. -->
        <receiver
            android:name="com.pd2launcher.app.input.DebugPadReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
