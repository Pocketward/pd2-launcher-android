+#ifdef __ANDROID__
+#include <android/hardware_buffer.h>
+#include <sys/socket.h>
+
+#include "vkr_image.h"
+#include "vulkan/vulkan_android.h"
+
+/* The dma-buf behind an AHardwareBuffer as another process gets it: the NDK has no call that
+ * reads the buffer's native handle, so it goes over a socket pair
+ * (AHardwareBuffer_sendHandleToUnixSocket) and the first fd of its SCM_RIGHTS message is kept.
+ * Returns -1 on failure.
+ */
+static int
+vkr_ahb_dma_buf_fd(AHardwareBuffer *ahb)
+{
+   int sv[2];
+   if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) < 0) {
+      vkr_log("AHardwareBuffer: socketpair failed (%s)", strerror(errno));
+      return -1;
+   }
+
+   int fd = -1;
+   const int ret = AHardwareBuffer_sendHandleToUnixSocket(ahb, sv[0]);
+   if (ret) {
+      vkr_log("AHardwareBuffer_sendHandleToUnixSocket failed (%d)", ret);
+   } else {
+      char data[4096];
+      union {
+         struct cmsghdr align;
+         char buf[CMSG_SPACE(sizeof(int) * 32)];
+      } control;
+      struct iovec iov = { .iov_base = data, .iov_len = sizeof(data) };
+      struct msghdr msg = {
+         .msg_iov = &iov,
+         .msg_iovlen = 1,
+         .msg_control = control.buf,
+         .msg_controllen = sizeof(control.buf),
+      };
+      if (recvmsg(sv[1], &msg, MSG_CMSG_CLOEXEC) > 0) {
+         for (struct cmsghdr *c = CMSG_FIRSTHDR(&msg); c; c = CMSG_NXTHDR(&msg, c)) {
+            if (c->cmsg_level != SOL_SOCKET || c->cmsg_type != SCM_RIGHTS)
+               continue;
+            const size_t count = (c->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+            for (size_t i = 0; i < count; i++) {
+               int received;
+               memcpy(&received, CMSG_DATA(c) + i * sizeof(int), sizeof(received));
+               if (fd < 0)
+                  fd = received;
+               else
+                  close(received);
+            }
+         }
+         if (msg.msg_flags & MSG_CTRUNC) {
+            vkr_log("AHardwareBuffer: its handle message was cut short");
+            if (fd >= 0)
+               close(fd);
+            fd = -1;
+         }
+      }
+      if (fd < 0)
+         vkr_log("AHardwareBuffer: no fd from its handle message");
+   }
+   close(sv[0]);
+   close(sv[1]);
+   return fd;
+}
+
+/* A BLOB may back a buffer, never an image: an allocation dedicated to an image loses its
+ * VkMemoryDedicatedAllocateInfo when the driver does not require one for that image, and fails
+ * when it does.
+ */
+static VkResult
+vkr_ahb_drop_dedicated_image(struct vkr_device *dev, VkMemoryAllocateInfo *alloc_info)
+{
+   VkMemoryDedicatedAllocateInfo *dedicated =
+      vkr_find_struct(alloc_info->pNext, VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO);
+   if (!dedicated || dedicated->image == VK_NULL_HANDLE)
+      return VK_SUCCESS;
+
+   struct vkr_image *image = vkr_image_from_handle(dedicated->image);
+   VkMemoryDedicatedRequirements dedicated_reqs = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_REQUIREMENTS,
+   };
+   VkMemoryRequirements2 reqs = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+      .pNext = &dedicated_reqs,
+   };
+   const VkImageMemoryRequirementsInfo2 info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+      .image = image->base.handle.image,
+   };
+   dev->proc_table.GetImageMemoryRequirements2(dev->base.handle.device, &info, &reqs);
+   if (dedicated_reqs.requiresDedicatedAllocation) {
+      vkr_log("AHardwareBuffer: an image that requires a dedicated allocation cannot have "
+              "host-visible memory");
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   void *prev = vkr_find_prev_struct(alloc_info, VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO);
+   vkr_pnext_set_next(prev, dedicated->pNext);
+   return VK_SUCCESS;
+}
+
+/* Allocates the page-rounded size as an AHardwareBuffer BLOB and fills out_info to import it;
+ * its dma-buf (vkr_ahb_dma_buf_fd) is kept in out_fd for the blob export, as the udmabuf path
+ * keeps its udmabuf.  The type it goes into is vkr_pick_import_memory_type's, and the CPU
+ * usage, so the client's mapping of the dma-buf, follows that type: OFTEN (cached) for a
+ * HOST_CACHED type, else RARELY; a buffer allocated for the requested type is allocated again
+ * when the type it can go into differs there.
+ */
+static VkResult
+vkr_ahb_get_import_info(struct vkr_device *dev,
+                        VkMemoryAllocateInfo *alloc_info,
+                        uint32_t property_flags,
+                        AHardwareBuffer **out_ahb,
+                        int *out_fd,
+                        VkImportAndroidHardwareBufferInfoANDROID *out_info)
+{
+   struct vkr_physical_device *physical_dev = dev->physical_device;
+   const PFN_vkGetAndroidHardwareBufferPropertiesANDROID get_props =
+      (PFN_vkGetAndroidHardwareBufferPropertiesANDROID)dev->get_ahb_properties;
+   if (!get_props)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   VkResult result = vkr_ahb_drop_dedicated_image(dev, alloc_info);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const uint64_t size = align64(alloc_info->allocationSize, getpagesize());
+   if (size > UINT32_MAX) {
+      vkr_log("AHardwareBuffer: %" PRIu64 " bytes is too large for a BLOB", size);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   bool cached = property_flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+   AHardwareBuffer *ahb = NULL;
+   VkAndroidHardwareBufferPropertiesANDROID props;
+   uint32_t type = UINT32_MAX;
+   for (int attempt = 0; attempt < 2; attempt++) {
+      const AHardwareBuffer_Desc desc = {
+         .width = (uint32_t)size,
+         .height = 1,
+         .layers = 1,
+         .format = AHARDWAREBUFFER_FORMAT_BLOB,
+         .usage = AHARDWAREBUFFER_USAGE_GPU_DATA_BUFFER |
+                  (cached ? AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN |
+                               AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN
+                          : AHARDWAREBUFFER_USAGE_CPU_READ_RARELY |
+                               AHARDWAREBUFFER_USAGE_CPU_WRITE_RARELY),
+      };
+      const int ret = AHardwareBuffer_allocate(&desc, &ahb);
+      if (ret) {
+         vkr_log("AHardwareBuffer_allocate of %" PRIu64 " bytes failed (%d)", size, ret);
+         return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      }
+
+      props = (VkAndroidHardwareBufferPropertiesANDROID){
+         .sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID,
+      };
+      result = get_props(dev->base.handle.device, ahb, &props);
+      if (result != VK_SUCCESS) {
+         vkr_log("vkGetAndroidHardwareBufferPropertiesANDROID failed (vk ret %d)", result);
+         AHardwareBuffer_release(ahb);
+         return result;
+      }
+
+      type = vkr_pick_import_memory_type(physical_dev, alloc_info->memoryTypeIndex,
+                                         props.memoryTypeBits, true);
+      if (type == UINT32_MAX) {
+         vkr_log("no host-visible memory type of the heap imports an AHardwareBuffer (bits 0x%x)",
+                 props.memoryTypeBits);
+         AHardwareBuffer_release(ahb);
+         return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      }
+
+      const bool type_cached = vkr_driver_memory_type(physical_dev, type)->propertyFlags &
+                               VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+      if (type_cached == cached || attempt)
+         break;
+      AHardwareBuffer_release(ahb);
+      ahb = NULL;
+      cached = type_cached;
+   }
+
+   const int fd = vkr_ahb_dma_buf_fd(ahb);
+   const off_t fd_size = fd >= 0 ? lseek(fd, 0, SEEK_END) : -1;
+   if (fd_size < 0 || (uint64_t)fd_size < size) {
+      vkr_log("AHardwareBuffer: its dma-buf is %lld bytes, %" PRIu64 " needed",
