+/* The driver's memory type [i] (its own index) in physical_dev->memory_properties, which is the
+ * client's view: with mem_type_spoof, the driver's type i is its entry i + 1.
+ */
+static inline const VkMemoryType *
+vkr_driver_memory_type(const struct vkr_physical_device *physical_dev, uint32_t i)
+{
+   return &physical_dev->memory_properties.memoryTypes[i + (physical_dev->mem_type_spoof ? 1 : 0)];
+}
+
+/* The driver's memory type (its own index) to import external memory into for a host-visible
+ * allocation of the driver's type [requested], when the import allows only [bits]: [requested]
+ * itself, else a host-visible type of the same heap in [bits], best one with the same HOST_*
+ * flags, else one with the same HOST_CACHED.  With [keep_coherent], a coherent request takes only
+ * a coherent type: the client does no flush for it, and only the type keeps the client's mapping
+ * coherent (a dma-buf heap's uncached pages do that by themselves).  UINT32_MAX when none.  The
+ * client keeps the requested type's properties: it only maps the external memory.
+ */
+static uint32_t
+vkr_pick_import_memory_type(const struct vkr_physical_device *physical_dev,
+                            uint32_t requested,
+                            uint32_t bits,
+                            bool keep_coherent)
+{
+   if (bits & (1u << requested))
+      return requested;
+
+   const VkPhysicalDeviceMemoryProperties *props = &physical_dev->memory_properties;
+   const uint32_t shift = physical_dev->mem_type_spoof ? 1 : 0;
+   const VkMemoryPropertyFlags host = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                      VK_MEMORY_PROPERTY_HOST_COHERENT_BIT |
+                                      VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+   const VkMemoryType *want = vkr_driver_memory_type(physical_dev, requested);
+   uint32_t best = UINT32_MAX;
+   int best_score = -1;
+   for (uint32_t i = 0; i + shift < props->memoryTypeCount && i < 32; i++) {
+      const VkMemoryType *type = vkr_driver_memory_type(physical_dev, i);
+      if (!(bits & (1u << i)) || type->heapIndex != want->heapIndex ||
+          !(type->propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+         continue;
+      if (keep_coherent && (want->propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) &&
+          !(type->propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT))
+         continue;
+      int score = 0;
+      if ((type->propertyFlags & host) == (want->propertyFlags & host))
+         score = 2;
+      else if ((type->propertyFlags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT) ==
+               (want->propertyFlags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT))
+         score = 1;
+      if (score > best_score) {
+         best = i;
+         best_score = score;
+      }
+   }
+   if (best != UINT32_MAX) {
+      static bool logged;
+      if (!logged) {
+         vkr_log("external memory goes into memory type %u in place of %u", best, requested);
+         logged = true;
+      }
+   }
+   return best;
+}
