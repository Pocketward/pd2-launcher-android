+/* PD2 Launcher: the client's front buffer [res handle] into the app's buffers
+ * (vtest_app_present.c); the answer is one word, VCMD_PD2_APP_PRESENT_*. */
+int vtest_pd2_app_present(uint32_t length_dw)
+{
+   struct vtest_context *ctx = vtest_get_current_context();
+   uint32_t buf[VCMD_PD2_APP_PRESENT_SIZE];
+   uint32_t resp_buf[VTEST_HDR_SIZE + 1];
+   int ret;
+
+   if (length_dw != VCMD_PD2_APP_PRESENT_SIZE)
+      return -1;
+   ret = ctx->input->read(ctx->input, buf, sizeof(buf));
+   if (ret != sizeof(buf))
+      return -1;
+
+   resp_buf[VTEST_CMD_LEN] = 1;
+   resp_buf[VTEST_CMD_ID] = VCMD_PD2_APP_PRESENT;
+   resp_buf[VTEST_CMD_DATA_START] = VCMD_PD2_APP_PRESENT_OFF;
+#ifdef __ANDROID__
+   struct vtest_resource *res = util_hash_table_get(ctx->resource_table,
+                                                    intptr_to_pointer(buf[VCMD_PD2_APP_PRESENT_RES_HANDLE]));
+   resp_buf[VTEST_CMD_DATA_START] = res ? vtest_app_present(res->res_id, buf[VCMD_PD2_APP_PRESENT_FLAGS], ctx->ctx_id)
+                                        : VCMD_PD2_APP_PRESENT_COPY;
+#endif
+
+   ret = vtest_block_write(ctx->out_fd, resp_buf, sizeof(resp_buf));
+   if (ret < 0)
+      return -1;
+
+   return 0;
+}
