# Build image for Wine and wowbox64.dll (build/wine.sh, build/wowbox64.sh): Wine's build tools for
# amd64, then Wine for ARM64 in WoW64 mode (only the game's 32-bit x86 code is emulated, by Box64's
# wowbox64.dll), cross-built on amd64 through Debian multiarch. The PE parts use llvm-mingw, which
# ../config.sh pins and the scripts unpack into the cache. The Debian image and snapshot are
# ../config.sh's pins, so every package version is fixed.
ARG DEBIAN_IMAGE
FROM ${DEBIAN_IMAGE}

ARG DEBIAN_SNAPSHOT
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
        'Types: deb' \
        "URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" \
        'Suites: trixie trixie-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        '' \
        'Types: deb' \
        "URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" \
        'Suites: trixie-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/snapshot.sources \
    && dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates xz-utils file make cmake python3 pkgconf flex bison gettext patch patchelf \
        libfreetype-dev \
        gcc g++ gcc-aarch64-linux-gnu g++-aarch64-linux-gnu libc6-dev-arm64-cross \
        libx11-dev:arm64 libxext-dev:arm64 libxrender-dev:arm64 libxrandr-dev:arm64 libxi-dev:arm64 \
        libxcursor-dev:arm64 libxfixes-dev:arm64 libxcomposite-dev:arm64 libxinerama-dev:arm64 \
        libgl-dev:arm64 libegl-dev:arm64 libvulkan-dev:arm64 libfreetype-dev:arm64 \
        libfontconfig-dev:arm64 libpulse-dev:arm64 libgnutls28-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
