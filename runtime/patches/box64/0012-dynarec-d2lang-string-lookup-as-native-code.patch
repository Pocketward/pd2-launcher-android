index fa8c58d..79c0b9c 100644
--- a/src/dynarec/dynarec_native_functions.c
+++ b/src/dynarec/dynarec_native_functions.c
@@ -27,6 +27,7 @@
 #include "custommem.h"
 #include "bridge.h"
 #include "dynarec_native_functions.h"
+#include "d2lang_lookup.h"
 
 void native_fstp(x64emu_t* emu, void* p)
 {
@@ -270,6 +271,32 @@ void native_gpf(x64emu_t* emu)
     EmitSignal(emu, X64_SIGSEGV, (void*)R_RIP, 0xbad0); // same effect has private opcode?
 }
 
+// D2Lang.dll's string-key lookup, as native code (d2lang_lookup.h). A block that starts at that
+// function calls this first. It returns 1 when it did what the function does, up to and with its
+// return; the block then goes on at the return address. It returns 0, with nothing changed, when
+// the x86 code must run: the block then runs it.
+uint32_t native_d2lang_lookup(x64emu_t* emu)
+{
+    static int logged;
+    const uint32_t fn = R_EIP;
+    if (!d2lang_lookup_unchanged(fn)) return 0;
+    d2lang_cpu_t cpu = { R_EAX, R_ECX, R_EDX, R_EBX, R_ESP, R_EBP, R_ESI, R_EDI, 0 };
+    if (!d2lang_lookup_run(&cpu, fn)) return 0;
+    const uint32_t ret = *(uint32_t*)(uintptr_t)cpu.esp;
+    R_RAX = cpu.eax;
+    R_RCX = cpu.ecx;
+    R_RDX = cpu.edx;
+    R_RSP = cpu.esp + 4 + D2LANG_LOOKUP_RET;
+    R_RIP = ret;
+    emu->eflags.x64 = (emu->eflags.x64 & ~(uint64_t)D2LANG_FLAGS) | cpu.flags;
+    emu->df = d_none;
+    if (!logged) {
+        logged = 1;
+        printf_log(LOG_INFO, "D2Lang.dll's string lookup at %p runs as native code\n", (void*)(uintptr_t)fn);
+    }
+    return 1;
+}
+
 void native_int(x64emu_t* emu, int num)
 {
     emu->test.test = 0;
