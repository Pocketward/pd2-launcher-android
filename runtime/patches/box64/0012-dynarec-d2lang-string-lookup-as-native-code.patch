diff --git a/src/tools/d2lang_lookup.c b/src/tools/d2lang_lookup.c
new file mode 100644
index 0000000..cf4a040
--- /dev/null
+++ b/src/tools/d2lang_lookup.c
@@ -0,0 +1,209 @@
+// SPDX-License-Identifier: MIT
+#include "d2lang_lookup.h"
+
+// Both functions by their place in the DLL and by the FNV-1a hash of their bytes, with the one
+// relocated address in them taken back to its place in the image. A DLL's base is a multiple of
+// 64 KiB, so the low half of the function's address is known. tests: fingerprint.py prints these.
+#define LOOKUP_RVA      0x9360u
+#define LOOKUP_SIZE     0xe9u
+#define LOOKUP_FNV      0xdf4b41aa9a24ef38ull
+#define LOOKUP_RELOC    0xb8u    // offset of the relocated address in the lookup function
+#define LOOKUP_RELOC_TO 0xd274u  // its place in the image
+#define LOOKUP_AFTER_HASH 0x25u  // offset of the instruction after the call of the hash function
+#define HASH_RVA        0x8fe0u
+#define HASH_SIZE       0x42u
+#define HASH_FNV        0x3465414d4871733bull
+
+// A string table in memory (the .tbl file): a header, the index list, the hash entries, the strings.
+#define TBL_COUNT      0x02u // uint16: strings, and the length of the index list
+#define TBL_HASH_SIZE  0x04u // uint32: hash entries
+#define TBL_MAX_TRIES  0x0du // uint32: the most entries that one lookup tries
+#define TBL_INDEX_LIST 0x15u
+#define ENTRY_SIZE     17u
+#define ENTRY_USED     0u // uint8: 1 for an entry with a string
+#define ENTRY_NUMBER   1u // uint16: the string's number
+#define ENTRY_KEY      7u // uint32: the key's offset in the table
+
+static inline const uint8_t* at(uint32_t addr) { return (const uint8_t*)(uintptr_t)addr; }
+static inline uint8_t rd8(uint32_t addr) { return *at(addr); }
+static inline uint16_t rd16(uint32_t addr)
+{
+    uint16_t v;
+    __builtin_memcpy(&v, at(addr), sizeof(v));
+    return v;
+}
+static inline uint32_t rd32(uint32_t addr)
+{
+    uint32_t v;
+    __builtin_memcpy(&v, at(addr), sizeof(v));
+    return v;
+}
+static inline void wr32(uint32_t addr, uint32_t v) { __builtin_memcpy((void*)(uintptr_t)addr, &v, sizeof(v)); }
+
+static uint64_t fnv1a(uint64_t h, const uint8_t* p, uint32_t n)
+{
+    while (n--) h = (h ^ *p++) * 0x100000001b3ull;
+    return h;
+}
+
+// The copy of both functions' bytes that d2lang_lookup_at() saw, and where.
+static uint8_t seen[LOOKUP_SIZE + HASH_SIZE];
+static volatile uintptr_t seen_fn;
+
+int d2lang_lookup_at(uintptr_t fn)
+{
+    if ((fn & 0xffff) != LOOKUP_RVA) return 0;
+    const uint8_t* lookup = (const uint8_t*)fn;
+    const uint32_t base = (uint32_t)fn - LOOKUP_RVA;
+    // The lookup function first: it is in the page that the caller is about to run. The hash
+    // function is in the page before, which is surely there only once the lookup function is right.
+    uint32_t reloc;
+    __builtin_memcpy(&reloc, lookup + LOOKUP_RELOC, sizeof(reloc));
+    reloc -= base;
+    uint64_t h = fnv1a(0xcbf29ce484222325ull, lookup, LOOKUP_RELOC);
+    h = fnv1a(h, (const uint8_t*)&reloc, sizeof(reloc));
+    h = fnv1a(h, lookup + LOOKUP_RELOC + 4, LOOKUP_SIZE - LOOKUP_RELOC - 4);
+    if (h != LOOKUP_FNV) return 0;
+    const uint8_t* hash = (const uint8_t*)(uintptr_t)(base + HASH_RVA);
+    if (fnv1a(0xcbf29ce484222325ull, hash, HASH_SIZE) != HASH_FNV) return 0;
+    seen_fn = 0;
+    __builtin_memcpy(seen, lookup, LOOKUP_SIZE);
+    __builtin_memcpy(seen + LOOKUP_SIZE, hash, HASH_SIZE);
+    seen_fn = fn;
+    return 1;
+}
+
+int d2lang_lookup_unchanged(uintptr_t fn)
+{
+    if (seen_fn != fn) return 0;
+    return !__builtin_memcmp(seen, (const uint8_t*)fn, LOOKUP_SIZE)
+        && !__builtin_memcmp(seen + LOOKUP_SIZE, (const uint8_t*)(fn - LOOKUP_RVA + HASH_RVA), HASH_SIZE);
+}
+
+// The function's hash of a key (the DLL's export 10000), before the division by the table's size.
+static uint32_t key_hash(uint32_t key)
+{
+    uint32_t h = 0;
+    for (;; ++key) {
+        const int8_t c = (int8_t)rd8(key);
+        if (!c) return h;
+        h = (h << 4) + (uint32_t)(int32_t)c;
+        const uint32_t top = h & 0xf0000000u;
+        if (top) h = ((top >> 24) ^ h) & 0x0fffffffu;
+    }
+}
+
+static int key_equal(uint32_t a, uint32_t b)
+{
+    for (;; ++a, ++b) {
+        const uint8_t c = rd8(a);
+        if (c != rd8(b)) return 0;
+        if (!c) return 1;
+    }
+}
+
+// The first of n entries from p that is in use with this key, or 0. The key's first letter is
+// tried before the whole key: nearly every entry of a walk ends there.
+static const uint8_t* find_in_run(const uint8_t* p, uint32_t n, uint32_t tbl, uint32_t key, uint8_t first)
+{
+    for (; n; --n, p += ENTRY_SIZE) {
+        if (p[ENTRY_USED] != 1) continue;
+        uint32_t offset;
+        __builtin_memcpy(&offset, p + ENTRY_KEY, sizeof(offset));
+        const uint32_t entry_key = tbl + offset;
+        if (rd8(entry_key) == first && key_equal(entry_key, key)) return p;
+    }
+    return 0;
+}
+
+static uint32_t parity_flag(uint32_t v)
+{
+    v &= 0xff;
+    v ^= v >> 4;
+    v ^= v >> 2;
+    v ^= v >> 1;
+    return (v & 1) ? 0 : 0x4;
+}
+
+// The flags of the 32-bit `add` that is the last instruction with flags before the return of a
+// key that was found.
+static uint32_t add_flags(uint32_t a, uint32_t b)
+{
+    const uint32_t r = a + b;
+    return (r < a ? 0x1 : 0) | parity_flag(r) | ((a ^ b ^ r) & 0x10) | (r ? 0 : 0x40) | ((r >> 31) << 7)
+        | (((~(a ^ b) & (a ^ r)) >> 31) << 11);
+}
+
+int d2lang_lookup_run(d2lang_cpu_t* cpu, uint32_t fn)
+{
+    // At the first instruction: the return address at esp, then the table, the list of string
+    // pointers (one for each hash entry), the key, and where the string pointer goes.
+    const uint32_t sp = cpu->esp;
+    const uint32_t tbl = rd32(sp + 4), strings = rd32(sp + 8), key = rd32(sp + 12), out = rd32(sp + 16);
+    // The function writes below the return address and into its first argument's place before it
+    // reads the rest. An argument that points there, or below there into the stack, would make the
+    // order of this code show.
+    const uint32_t args[] = { tbl, strings, key, out };
+    for (unsigned i = 0; i < sizeof(args) / sizeof(args[0]); ++i)
+        if (sp + 19 - args[i] < 0x10000u) return 0;
+    const uint32_t size = rd32(tbl + TBL_HASH_SIZE);
+    // The function divides by the size, as an unsigned and as a signed number.
+    if (!size || size > 0x7fffffffu) return 0;
+    const uint32_t max_tries = rd32(tbl + TBL_MAX_TRIES);
+    const uint32_t entries = tbl + TBL_INDEX_LIST + 2u * rd16(tbl + TBL_COUNT);
+    // The function's addresses are 32 bits wide: entries that go past the end of the address space
+    // would come back at its start.
+    if ((uint64_t)entries + (uint64_t)size * ENTRY_SIZE > 0x100000000ull) return 0;
+
+    // The function goes from entry to entry and back to the first one after the last, for the
+    // table's number of tries. Here: one straight run of entries after the other.
+    uint32_t index = key_hash(key) % size;
+    uint32_t tries = 0, found = 0;
+    const uint8_t first = rd8(key);
+    for (uint32_t left = max_tries; left;) {
+        const uint32_t run = size - index < left ? size - index : left;
+        const uint8_t* const begin = at(entries + index * ENTRY_SIZE);
+        const uint8_t* const hit = find_in_run(begin, run, tbl, key, first);
+        if (hit) {
+            const uint32_t before = (uint32_t)(hit - begin) / ENTRY_SIZE;
+            tries += before + 1;
+            index += before;
+            found = 1;
+            break;
+        }
+        tries += run;
+        left -= run;
+        index = index + run == size ? 0 : index + run;
+    }
+    const uint32_t entry = entries + index * ENTRY_SIZE;
+    uint32_t string = 0;
+    if (found) {
+        string = rd32(strings + index * 4);
+        if (!string) return 0; // the function ends the game with an error here
+    }
+
+    // What the function's pushes and its call of the hash function leave below the return address.
+    wr32(sp - 0x04, tries ? tries : cpu->ecx);
+    wr32(sp - 0x08, cpu->ebx);
+    wr32(sp - 0x0c, cpu->ebp);
+    wr32(sp - 0x10, cpu->esi);
+    wr32(sp - 0x14, cpu->edi);
+    wr32(sp - 0x18, size);
+    wr32(sp - 0x1c, key);
+    wr32(sp - 0x20, fn + LOOKUP_AFTER_HASH);
+    wr32(sp + 4, entries);
+
+    if (found) {
+        wr32(out, string);
+        const uint32_t scaled = index << 4;
+        cpu->eax = ((scaled + entries) & 0xffff0000u) | rd16(entry + ENTRY_NUMBER);
+        cpu->edx = out;
+        cpu->flags = add_flags(scaled, entries);
+    } else {
+        cpu->eax = 0xffff; // `or ax, 0xffff` on a quotient of 0 or 1
+        cpu->edx = index;  // the remainder of its last division: the entry after the last one tried
+        cpu->flags = 0x84; // of that `or`: SF and PF
+    }
+    if (tries) cpu->ecx = tries; // its `pop ecx` takes the place that held the count
+    return 1;
+}
