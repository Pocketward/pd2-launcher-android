diff --git a/src/include/d2lang_lookup.h b/src/include/d2lang_lookup.h
new file mode 100644
index 0000000..9e6310a
--- /dev/null
+++ b/src/include/d2lang_lookup.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: MIT
+#ifndef __D2LANG_LOOKUP_H
+#define __D2LANG_LOOKUP_H
+
+#include <stdint.h>
+
+// The string-key lookup of D2Lang.dll (Diablo II 1.13c, as Project Diablo 2 ships it), as native
+// code. The x86 function finds a key in one string table: it hashes the key, then goes from table
+// entry to table entry and compares the key with each entry's key, until it finds the key or has
+// made the table's number of tries. PD2's tables are full and that number is nearly the table's
+// size, so a key that is not in a table costs a walk over the whole table, and the game asks three
+// tables in turn. This is the same search with the same reads, compiled; it keeps no state.
+//
+// It has no Box64 type in it, so a test can run it beside the x86 function itself.
+
+// The x86 registers that the function reads and leaves.
+typedef struct d2lang_cpu_s {
+    uint32_t eax, ecx, edx, ebx, esp, ebp, esi, edi;
+    uint32_t flags; // out: CF, PF, AF, ZF, SF and OF as the function leaves them
+} d2lang_cpu_t;
+
+#define D2LANG_FLAGS      0x8d5u // CF, PF, AF, ZF, SF and OF in EFLAGS
+#define D2LANG_LOOKUP_RET 0x10   // the argument bytes that the function's `ret` takes off the stack
+
+// Whether the x86 code at fn is that function, with the hash function it calls. It keeps a copy of
+// both for d2lang_lookup_unchanged().
+int d2lang_lookup_at(uintptr_t fn);
+
+// Whether both functions still have the bytes that d2lang_lookup_at(fn) saw.
+int d2lang_lookup_unchanged(uintptr_t fn);
+
+// Does what the function at fn does, from its first instruction up to its `ret`, which stays for
+// the caller: the registers in cpu (esp still at the return address), the result that it stores,
+// and what it leaves on the stack below the return address.
+// Returns 1 when done. Returns 0, with nothing changed, for a call that the x86 code must take
+// itself: one that the x86 code ends with an error or a fault, or with arguments in its own stack
+// area.
+int d2lang_lookup_run(d2lang_cpu_t* cpu, uint32_t fn);
+
+#endif // __D2LANG_LOOKUP_H
