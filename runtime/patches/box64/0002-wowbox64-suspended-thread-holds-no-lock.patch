+/*
+ * Threads that another thread suspends (SuspendThread; .NET's garbage collector does it at any
+ * point of a thread's code, then reads and sets its context).
+ *
+ * 1. A thread is not suspended while it holds one of Box64's locks (or the process heap's, in
+ *    Box64's own allocations): the thread that suspended it may need that lock before it resumes
+ *    it (to translate the code it runs, to change a page's protection, to allocate), and both
+ *    would wait for ever. Wine suspends a thread with SIGUSR1; it stays blocked while the thread
+ *    holds a lock, so the thread stops when it lets go of the last one.
+ * 2. Wine reports the x86 context that the thread's CPU area holds, which WowBox64 writes only at
+ *    a system call. For a thread stopped in translated code, BTCpuGetContext rebuilds the live
+ *    registers from its ARM64 context, as BTCpuResetToConsistentState does for an exception; a
+ *    thread stopped in Box64's own code runs on a moment and is stopped again. BTCpuSetContext
+ *    makes such a thread start again from the context set (its native context goes back to the
+ *    one BTCpuSimulate captured before it entered the translated code).
+ */
+#define WOW64_TLS_BOX64_HELD (WOW64_TLS_MAX_NUMBER - 4) /* slot 16 is ntdll's errno */
+#define HELD_WAS_MASKED ((ULONG_PTR)1 << 62)
+#define SIGUSR1_BIT ((uint64_t)1 << (10 - 1))
+#define SUSPEND_TRIES 200
+
+typedef struct {
+    NTSTATUS ExitStatus;
+    PVOID TebBaseAddress;
+    CLIENT_ID ClientId;
+    ULONG_PTR AffinityMask;
+    LONG Priority;
+    LONG BasePriority;
+} BOX64_THREAD_BASIC_INFORMATION;
+
+NTSTATUS WINAPI NtSuspendThread(HANDLE, ULONG*);
+NTSTATUS WINAPI NtResumeThread(HANDLE, ULONG*);
+NTSTATUS WINAPI NtGetContextThread(HANDLE, CONTEXT*);
+NTSTATUS WINAPI NtSetContextThread(HANDLE, const CONTEXT*);
+NTSTATUS WINAPI NtYieldExecution(void);
+void adjust_arch_context(dynablock_t* db, x64emu_t* emu, CONTEXT* p, uintptr_t x64pc);
+extern IMAGE_DOS_HEADER __ImageBase;
+
+/* rt_sigprocmask(2) of the Linux kernel under Wine (a 64-bit signal set): SIG_BLOCK 0, SIG_UNBLOCK 1. */
+static int64_t raw_sigprocmask(int64_t how, const uint64_t* set, uint64_t* old)
+{
+    register int64_t x0 __asm__("x0") = how;
+    register int64_t x1 __asm__("x1") = (int64_t)(uintptr_t)set;
+    register int64_t x2 __asm__("x2") = (int64_t)(uintptr_t)old;
+    register int64_t x3 __asm__("x3") = sizeof(uint64_t);
+    register int64_t x8 __asm__("x8") = 135; /* __NR_rt_sigprocmask */
+    __asm__ volatile("svc #0" : "+r"(x0) : "r"(x1), "r"(x2), "r"(x3), "r"(x8) : "memory");
+    return x0;
+}
+
+void WowHoldEnter(void)
+{
+    ULONG_PTR* held = (ULONG_PTR*)&NtCurrentTeb()->TlsSlots[WOW64_TLS_BOX64_HELD];
+    if (!(*held & ~HELD_WAS_MASKED)) {
+        uint64_t set = SIGUSR1_BIT, old = 0;
+        raw_sigprocmask(0, &set, &old);
+        *held = (old & SIGUSR1_BIT) ? HELD_WAS_MASKED : 0;
+    }
+    (*held)++;
+}
+
+void WowHoldLeave(void)
+{
+    ULONG_PTR* held = (ULONG_PTR*)&NtCurrentTeb()->TlsSlots[WOW64_TLS_BOX64_HELD];
+    if (!(*held & ~HELD_WAS_MASKED)) return;
+    if (!(--(*held) & ~HELD_WAS_MASKED)) {
+        if (!(*held & HELD_WAS_MASKED)) {
+            uint64_t set = SIGUSR1_BIT;
+            raw_sigprocmask(1, &set, NULL);
+        }
+        *held = 0;
+    }
+}
+
+NTSTATUS WowLockEnter(RTL_CRITICAL_SECTION* cs)
+{
+    WowHoldEnter();
+    return RtlEnterCriticalSection(cs);
+}
+
+NTSTATUS WowLockLeave(RTL_CRITICAL_SECTION* cs)
+{
+    NTSTATUS status = RtlLeaveCriticalSection(cs);
+    WowHoldLeave();
+    return status;
+}
+
+BOOL WowLockTry(RTL_CRITICAL_SECTION* cs)
+{
+    WowHoldEnter();
+    if (RtlTryEnterCriticalSection(cs)) return TRUE;
+    WowHoldLeave();
+    return FALSE;
+}
+
+/* [thread]'s TEB when it is another thread of this process; NULL otherwise. */
+static TEB* other_local_thread(HANDLE thread)
+{
+    BOX64_THREAD_BASIC_INFORMATION info, self;
+    if (thread == ((HANDLE)(LONG_PTR)-2)) return NULL;
+    if (NtQueryInformationThread(thread, ThreadBasicInformation, &info, sizeof(info), NULL)) return NULL;
+    if (NtQueryInformationThread(((HANDLE)(LONG_PTR)-2), ThreadBasicInformation, &self, sizeof(self), NULL)) return NULL;
+    if (info.ClientId.UniqueProcess != self.ClientId.UniqueProcess || info.TebBaseAddress == self.TebBaseAddress) return NULL;
+    return info.TebBaseAddress;
+}
+
+/* Whether [pc] is in WowBox64's own code (its C code, the interpreter, the jumps between blocks). */
+static BOOL in_wowbox64(DWORD64 pc)
+{
+    IMAGE_NT_HEADERS* nt = (IMAGE_NT_HEADERS*)((char*)&__ImageBase + __ImageBase.e_lfanew);
+    return pc >= (DWORD64)&__ImageBase && pc < (DWORD64)&__ImageBase + nt->OptionalHeader.SizeOfImage;
+}
+
+/* [ctx]'s integer and control registers (and the floating point ones asked for) from [emu]. */
+static void emu_to_context(x64emu_t* emu, WOW64_CONTEXT* ctx)
+{
+    if ((ctx->ContextFlags & WOW64_CONTEXT_INTEGER) == WOW64_CONTEXT_INTEGER) {
+        ctx->Eax = R_EAX;
+        ctx->Ecx = R_ECX;
+        ctx->Edx = R_EDX;
+        ctx->Ebx = R_EBX;
+        ctx->Esi = R_ESI;
+        ctx->Edi = R_EDI;
+    }
+    if ((ctx->ContextFlags & WOW64_CONTEXT_CONTROL) == WOW64_CONTEXT_CONTROL) {
+        ctx->Esp = R_ESP;
+        ctx->Ebp = R_EBP;
+        ctx->Eip = R_RIP;
+        ctx->EFlags = emu->eflags.x64;
+    }
+    if ((ctx->ContextFlags & (WOW64_CONTEXT_FLOATING_POINT & 0xffff)) || (ctx->ContextFlags & (WOW64_CONTEXT_EXTENDED_REGISTERS & 0xffff)))
+        box_to_fpu(ctx, emu);
+}
+
 NTSTATUS WINAPI BTCpuGetContext(HANDLE thread, HANDLE process, void* unknown, WOW64_CONTEXT* ctx)
 {
     printf_log(LOG_DEBUG, "BTCpuGetContext(%p, %p, %p, %p)\n", thread, process, unknown, ctx);
-    return NtQueryInformationThread(thread, ThreadWow64Context, ctx, sizeof(*ctx), NULL);
+    NTSTATUS status = NtQueryInformationThread(thread, ThreadWow64Context, ctx, sizeof(*ctx), NULL);
+    if (status || !(ctx->ContextFlags & 3)) return status;
+    TEB* teb = other_local_thread(thread);
+    x64emu_t* emu = teb ? teb->TlsSlots[WOW64_TLS_EMU] : NULL;
+    if (!emu) return status;
+    /* A hold of our own; [caller] is how many times it was suspended before (0: it runs). */
+    ULONG caller = 0;
+    if (NtSuspendThread(thread, &caller)) return status;
+    if (!caller) {
+        NtResumeThread(thread, NULL);
+        return status;
+    }
+    BOOL moved = FALSE;
+    for (int tries = 0;; tries++) {
+        CONTEXT native;
+        memset(&native, 0, sizeof(native));
+        native.ContextFlags = CONTEXT_ARM64_FULL;
+        if (NtGetContextThread(thread, &native)) break;
+        dynablock_t* db = FindDynablockFromNativeAddress((void*)native.Pc);
+        if (db) {
+            /* Stopped in translated code: its registers, flags and SSE/x87 values as they are now. */
+            x64emu_t live = *emu;
+            for (int i = 0; i < 8; i++)
+                live.regs[i].q[0] = (uint32_t)native.X[10 + i];
+            live.eflags.x64 = (uint32_t)native.X[26];
+            uintptr_t x64pc = getX64Address(db, native.Pc);
+            live.ip.q[0] = x64pc ? x64pc : (uint32_t)native.X[27];
+            if (x64pc) adjust_arch_context(db, &live, &native, x64pc);
+            CHECK_FLAGS((&live));
+            if (moved) NtQueryInformationThread(thread, ThreadWow64Context, ctx, sizeof(*ctx), NULL);
+            emu_to_context(&live, ctx);
+            break;
+        }
+        if (!in_wowbox64(native.Pc)) {
+            /* In Wine's code (a system call): the CPU area holds its x86 context. */
+            if (moved) NtQueryInformationThread(thread, ThreadWow64Context, ctx, sizeof(*ctx), NULL);
+            break;
+        }
+        if (caller != 1 || tries == SUSPEND_TRIES) {
+            /* In Box64's own code for long (the interpreter): the emulator holds the state. */
+            if (moved) NtQueryInformationThread(thread, ThreadWow64Context, ctx, sizeof(*ctx), NULL);
+            x64emu_t live = *emu;
+            CHECK_FLAGS((&live));
+            emu_to_context(&live, ctx);
+            break;
+        }
+        /* Between two blocks or in a helper: it runs on a moment and is stopped again. */
+        NtResumeThread(thread, NULL);
+        NtResumeThread(thread, NULL);
+        NtYieldExecution();
+        if (NtSuspendThread(thread, NULL)) return status;
+        NtSuspendThread(thread, NULL);
+        moved = TRUE;
+    }
+    NtResumeThread(thread, NULL);
+    return status;
 }
 
