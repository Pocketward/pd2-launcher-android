 {
     printf_log(LOG_DEBUG, "BTCpuSetContext(%p, %p, %p, %p)\n", thread, process, unknown, ctx);
-    return NtSetInformationThread(thread, ThreadWow64Context, ctx, sizeof(*ctx));
+    NTSTATUS status = NtSetInformationThread(thread, ThreadWow64Context, ctx, sizeof(*ctx));
+    if (status || !(ctx->ContextFlags & 3)) return status;
+    /* Another thread, suspended in translated code or in Box64's own code: it would go on from its
+       native registers and never read the context set. It starts again from the one BTCpuSimulate
+       captured before it entered the translated code, which loads the context set. */
+    TEB* teb = other_local_thread(thread);
+    CONTEXT* entry = teb ? teb->TlsSlots[WOW64_TLS_ENTRY_CONTEXT] : NULL;
+    if (!entry) return status;
+    CONTEXT native;
+    memset(&native, 0, sizeof(native));
+    native.ContextFlags = CONTEXT_ARM64_CONTROL;
+    if (NtGetContextThread(thread, &native)) return status;
+    if (FindDynablockFromNativeAddress((void*)native.Pc) || in_wowbox64(native.Pc)) {
+        CONTEXT restart = *entry;
+        restart.ContextFlags = CONTEXT_ARM64_FULL;
+        NtSetContextThread(thread, &restart);
+    }
+    return status;
 }
 
 void WINAPI BTCpuSimulate(void)
