Subject: [PATCH] wowbox64: BOX64_DYNAREC_PROGRAMS, the environment's dynarec settings for the named programs only

A Windows program gives its environment to the programs it starts. The BOX64_DYNAREC_* settings
that one program needs (the official PD2 launcher's .NET runtime: STRONGMEM=1 and WAIT=0) then
reached the game that it starts too, where they only cost time (the game's main thread used about
a fifth more of a core). A settings file with a section for each program is not a way out under
WowBox64: with a %USERPROFILE%\.box64rc, the launcher (an x86 program) stopped at its start,
waiting for ever on mutex_blocks, which no thread held.

BOX64_DYNAREC_PROGRAMS names the programs (file names, ';' or ',' between them, in any case) that
the environment's BOX64_DYNAREC_* settings are for. Any other program starts with Box64's defaults
for them (ResetEnvVariables). Without the variable, nothing changes.
---
--- a/src/include/env.h
+++ b/src/include/env.h
@@ -248,6 +248,7 @@
 const char* GetLastApplyEntryName();
 void InitializeEnv();
 void LoadEnvVariables();
+void ResetEnvVariables(const char* prefix);
 void PrintEnvVariables(box64env_t* env, int level);
 void RecordEnvMappings(uintptr_t addr, size_t length, int fd);
 void WillRemoveMapping(uintptr_t addr, size_t length);
--- a/src/tools/env.c
+++ b/src/tools/env.c
@@ -757,6 +757,36 @@
     applyCustomRules();
 }
 
+// The settings that the environment set and whose names start with prefix go back to their
+// defaults, as if the environment did not have them (WowBox64: BOX64_DYNAREC_PROGRAMS).
+void ResetEnvVariables(const char* prefix)
+{
+    size_t n = strlen(prefix);
+#ifdef _WIN32
+#define DEFAULT(wine, default) ((wine) ? (default) : 0)
+#else
+#define DEFAULT(wine, default) (default)
+#endif
+#define RESET(NAME, name, value)                                              \
+    if (box64env.is_##name##_overridden && !strncmp(#NAME, prefix, n)) {     \
+        box64env.name = value;                                                \
+        box64env.is_##name##_overridden = 0;                                  \
+    }
+#define INTEGER(NAME, name, default, min, max, wine, dynacache) RESET(NAME, name, DEFAULT(wine, default))
+#define INTEGER64(NAME, name, default, wine, dynacache)         RESET(NAME, name, DEFAULT(wine, default))
+#define BOOLEAN(NAME, name, default, wine, dynacache)           RESET(NAME, name, DEFAULT(wine, default))
+#define ADDRESS(NAME, name, wine, dynacache)                    RESET(NAME, name, 0)
+#define STRING(NAME, name, wine, dynacache)                     RESET(NAME, name, NULL)
+    ENVSUPER()
+#undef INTEGER
+#undef INTEGER64
+#undef BOOLEAN
+#undef ADDRESS
+#undef STRING
+#undef RESET
+#undef DEFAULT
+}
+
 void PrintEnvVariables(box64env_t* env, int level)
 {
     if (env->is_any_overridden) printf_log(level, "BOX64ENV: Variables overridden:\n");
--- a/wine/wow64/wowbox64.c
+++ b/wine/wow64/wowbox64.c
@@ -432,6 +432,34 @@
     invalidate_mapped_section(addr);
 }
 
+/* Whether the list (file names, ';' or ',' between them) has name, in any case (ASCII). */
+static int program_listed(const char* list, const char* name)
+{
+#define LOWER(c) ((c) >= 'A' && (c) <= 'Z' ? (c) - 'A' + 'a' : (c))
+    size_t n = strlen(name);
+    while (*list) {
+        const char* end = list;
+        while (*end && *end != ';' && *end != ',') ++end;
+        if ((size_t)(end - list) == n) {
+            size_t i = 0;
+            while (i < n && LOWER(list[i]) == LOWER(name[i])) ++i;
+            if (i == n) return 1;
+        }
+        list = *end ? end + 1 : end;
+    }
+    return 0;
+#undef LOWER
+}
+
+/* BOX64_DYNAREC_PROGRAMS: the BOX64_DYNAREC_* settings of the environment are for the programs it
+ * names only; any other program (a child that inherits the environment) starts with Box64's
+ * defaults for them. Unset, every program gets them. */
+static void dynarec_settings_for(const char* program)
+{
+    char* list = GetEnv("BOX64_DYNAREC_PROGRAMS");
+    if (list && !program_listed(list, program)) ResetEnvVariables("BOX64_DYNAREC_");
+}
+
 NTSTATUS WINAPI BTCpuProcessInit(void)
 {
     printf_log(LOG_DEBUG, "BTCpuProcessInit()\n");
@@ -461,6 +489,7 @@
         char* shortname = strrchr(filename, '\\');
         if (shortname) {
             shortname++;
+            dynarec_settings_for(shortname);
             ApplyEnvFileEntry(shortname);
         }
     }
