     for (unsigned k = 0; k < NPAIRS; ++k)
-        if (code_hash(base + pairs[k].write_rva, CB_SIZE, 0, 0, base) != pairs[k].fnv) return 0;
+        if (!native_x86_readable(base + pairs[k].write_rva, CB_SIZE)
+            || code_hash(base + pairs[k].write_rva, CB_SIZE, 0, 0, base) != pairs[k].fnv) return 0;
     seen_fn = 0;
     for (unsigned i = 0; i < sizeof(seen_code) / 8; ++i) seen_code[i] = rd64((uint32_t)fn + 8 * i);
     for (unsigned k = 0; k < NPAIRS; ++k)
diff --git a/wine/wow64/wowbox64.c b/wine/wow64/wowbox64.c
index 8b9d2d3..0bc2dba 100644
--- a/wine/wow64/wowbox64.c
+++ b/wine/wow64/wowbox64.c
@@ -23,6 +23,7 @@
 #include "box64cpu_util.h"
 #include "build_info.h"
 #include "rbtree.h"
+#include "native_x86.h"
 #include "wine/compiler.h"
 #include "wine/debug.h"
 #include "hostext.h"
@@ -152,6 +153,27 @@ void box_to_fpu(WOW64_CONTEXT* ctx, x64emu_t* emu)
     memcpy(fpu->XmmRegisters, emu->xmm, sizeof(emu->xmm));
 }
 
+// native_x86.h: whether all of [addr, addr + size) is committed memory that can be read now
+// (Windows' view of it), region by region, so that a check never reads past a mapping.
+int native_x86_readable(uintptr_t addr, uint32_t size)
+{
+    const uintptr_t end = addr + size;
+    if (end < addr) return 0;
+    while (addr < end) {
+        MEMORY_BASIC_INFORMATION mem_info;
+        if (NtQueryVirtualMemory(NtCurrentProcess(), (PVOID)addr, MemoryBasicInformation, &mem_info, sizeof(mem_info), NULL))
+            return 0;
+        if (mem_info.State != MEM_COMMIT || (mem_info.Protect & (PAGE_GUARD | PAGE_NOACCESS))
+            || !(mem_info.Protect & (PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ
+                                     | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)))
+            return 0;
+        const uintptr_t next = (uintptr_t)mem_info.BaseAddress + mem_info.RegionSize;
+        if (next <= addr) return 0;
+        addr = next;
+    }
+    return 1;
+}
+
 static NTSTATUS invalidate_mapped_section(PVOID addr)
 {
     MEMORY_BASIC_INFORMATION mem_info;
