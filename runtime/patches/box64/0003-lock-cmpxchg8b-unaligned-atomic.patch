+/*
+ * LOCK CMPXCHG8B at an address that is not 8-byte aligned. The dynarec calls it where CASP cannot
+ * do the 8 bytes (without LSE2, or across 16 bytes with it), the interpreter for every such
+ * address, so both agree for each address. A byte exclusive followed by a plain 8-byte store let a
+ * second CPU's compare-exchange land between the two and be lost (32-bit .NET has 4-byte aligned
+ * 64-bit counters that its thread pool changes only this way).
+ * - The 8 bytes inside one 16-byte block: an exclusive pair (LDAXP/STLXP) on the whole block, so
+ *   the compare and the write are one atomic access. A failed compare writes the same bytes back,
+ *   which makes the 16-byte read atomic.
+ * - Across a 16-byte boundary no exclusive access covers them: such compare-exchanges take one
+ *   lock, so they are atomic with each other (not with other instructions on the same bytes).
+ *   Under WowBox64 the thread is not suspended while it holds it (mypthread.h).
+ * The barriers before and after make it a full barrier, as an x86 locked instruction is.
+ */
+static uint32_t cmpxchg8b_split_lock;
+uint64_t arm64_lock_cmpxchg8b_unaligned(void* emu, void* addr, uint64_t expected, uint64_t desired)
+{
+    (void)emu;
+    uintptr_t a = (uintptr_t)addr;
+    uint64_t old, lo, hi, t, nlo, nhi;
+    uint32_t fail;
+    __asm__ volatile("dmb ish" ::: "memory");
+    if(!(a&7)) {
+        __asm__ volatile(
+            "1: ldaxr   %[old], [%[p]]\n"
+            "   cmp     %[old], %[exp]\n"
+            "   b.ne    2f\n"
+            "   stlxr   %w[fail], %[des], [%[p]]\n"
+            "   cbnz    %w[fail], 1b\n"
+            "   b       3f\n"
+            "2: clrex\n"
+            "3:\n"
+            : [old]"=&r"(old), [fail]"=&r"(fail)
+            : [p]"r"(a), [exp]"r"(expected), [des]"r"(desired)
+            : "memory", "cc");
+    } else if((a&15)<8) {
+        uint64_t sh = (a&15)*8;             // 8..56: the value is bits sh..sh+63 of the block
+        uint64_t rsh = 64-sh;
+        uint64_t lomask = (1ULL<<sh)-1;     // the block's bits below the value
+        uint64_t dlo = desired<<sh;
+        uint64_t dhi = desired>>rsh;
+        __asm__ volatile(
+            "1: ldaxp   %[lo], %[hi], [%[blk]]\n"
+            "   lsr     %[old], %[lo], %[sh]\n"
+            "   lsl     %[t], %[hi], %[rsh]\n"
+            "   orr     %[old], %[old], %[t]\n"
+            "   cmp     %[old], %[exp]\n"
+            "   b.ne    2f\n"
+            "   and     %[nlo], %[lo], %[lomask]\n"
+            "   orr     %[nlo], %[nlo], %[dlo]\n"
+            "   bic     %[nhi], %[hi], %[lomask]\n"
+            "   orr     %[nhi], %[nhi], %[dhi]\n"
+            "   stlxp   %w[fail], %[nlo], %[nhi], [%[blk]]\n"
+            "   cbnz    %w[fail], 1b\n"
+            "   b       3f\n"
+            "2: stlxp   %w[fail], %[lo], %[hi], [%[blk]]\n"
+            "   cbnz    %w[fail], 1b\n"
+            "3:\n"
+            : [lo]"=&r"(lo), [hi]"=&r"(hi), [old]"=&r"(old), [t]"=&r"(t), [nlo]"=&r"(nlo),
+              [nhi]"=&r"(nhi), [fail]"=&r"(fail)
+            : [blk]"r"(a&~(uintptr_t)15), [sh]"r"(sh), [rsh]"r"(rsh), [exp]"r"(expected),
+              [lomask]"r"(lomask), [dlo]"r"(dlo), [dhi]"r"(dhi)
+            : "memory", "cc");
+    } else {
+        typedef uint64_t __attribute__((aligned(1))) u64_unaligned_t;
+        volatile u64_unaligned_t* p = (volatile u64_unaligned_t*)a;
+        #ifdef _WIN32
+        WowHoldEnter();
+        #endif
+        while(arm64_lock_xchg_d(&cmpxchg8b_split_lock, 1))
+            __asm__ volatile("yield");
+        old = *p;
+        if(old==expected)
+            *p = desired;
+        arm64_lock_xchg_d(&cmpxchg8b_split_lock, 0);
+        #ifdef _WIN32
+        WowHoldLeave();
+        #endif
+    }
+    __asm__ volatile("dmb ish" ::: "memory");
+    return old;
+}
