diff --git a/src/include/native_x86.h b/src/include/native_x86.h
new file mode 100644
index 0000000..7bdc2af
--- /dev/null
+++ b/src/include/native_x86.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: MIT
+#ifndef __NATIVE_X86_H
+#define __NATIVE_X86_H
+
+#include <stdint.h>
+
+// x86 functions of Project Diablo 2's DLLs that run as native code, with the same results: Box64
+// knows each one by the bytes of its code. A block that starts at such a function calls its native
+// code first; when that refuses a call, the block runs the x86 code.
+//
+// No Box64 type is in this interface, so a test can run the native code beside the x86 code.
+
+// The x86 state that a native function reads and leaves, at its first instruction (esp at the
+// return address) and at its `ret` (esp still at the return address).
+typedef struct native_x86_cpu_s {
+    uint32_t eax, ecx, edx, ebx, esp, ebp, esi, edi;
+    uint32_t flags;       // out: CF, PF, AF, ZF, SF and OF as the function leaves them
+    uint32_t pop;         // out: the argument bytes that the function's `ret` takes off the stack
+    uint32_t xmm_written; // out: bit i set when xmm[i] holds what the function leaves in xmm<i>
+    uint32_t xmm[2][4];   // in and out: xmm0 and xmm1
+} native_x86_cpu_t;
+
+#define NATIVE_X86_FLAGS 0x8d5u // CF, PF, AF, ZF, SF and OF in EFLAGS
+
+// One known function.
+typedef struct native_x86_fn_s {
+    const char* name;
+    uint16_t pop; // the argument bytes that its `ret` takes off the stack
+    // Whether the x86 code at fn is that function. It keeps what it needs for unchanged().
+    int (*at)(uintptr_t fn);
+    // Whether at(fn) knew it and the code is as it saw it (cheap: it runs at each call).
+    int (*unchanged)(uintptr_t fn);
+    // Does what the function does up to its `ret`: returns 1, or 0 with nothing changed for a call
+    // that the x86 code must take itself.
+    int (*run)(native_x86_cpu_t* cpu, uint32_t fn);
+} native_x86_fn_t;
+
+// The known function at fn, or 0.
+const native_x86_fn_t* native_x86_at(uintptr_t fn);
+
+// The known function at fn whose code is unchanged since native_x86_at(fn), or 0.
+const native_x86_fn_t* native_x86_find(uintptr_t fn);
+
+#endif // __NATIVE_X86_H
