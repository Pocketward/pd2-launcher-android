+  // __tls_get_addr won't trip on bionic module ids any more.
   return true;
 }
 #endif  // !defined(__mips__)
diff --git a/hybris/common/q/linker_tls.cpp b/hybris/common/q/linker_tls.cpp
index a014bbb..f558a00 100644
--- a/hybris/common/q/linker_tls.cpp
+++ b/hybris/common/q/linker_tls.cpp
@@ -40,8 +40,15 @@
 #include "private/linker_native_bridge.h"
 #include "linker_main.h"
 #include "linker_soinfo.h"
+#include "tls_patcher.h"
 #include <stdint.h>
 
+// Set by linker_main.cpp from android_linker_init(); we read its
