+/* The external memory handle types the kernel backend shares: opaque fds and
+ * dma-bufs both ways, or only dma-bufs in (kbase: pan_kmod_dev_props.limits).
+ */
+static VkExternalMemoryHandleTypeFlags
+panvk_external_memory_handle_types(
+   const struct panvk_physical_device *physical_device, bool *can_export)
+{
+   const struct pan_kmod_dev_props *props = &physical_device->kmod.dev->props;
+
+   *can_export = !props->limits.no_fd_sharing;
+   if (*can_export)
+      return VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT |
+             VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+
+   return props->limits.dma_buf_import
+             ? VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT
+             : 0;
+}
