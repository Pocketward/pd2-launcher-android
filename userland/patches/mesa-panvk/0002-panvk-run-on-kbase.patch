+/* Arm's mali_kbase is not a DRM device, so drmGetDevices2() never lists it.
+ * When its node can be opened, it becomes the physical device; otherwise
+ * VK_ERROR_INCOMPATIBLE_DRIVER lets the runtime enumerate DRM devices. */
+static VkResult
+panvk_enumerate_kbase(struct vk_instance *vk_instance)
+{
+   struct panvk_instance *instance =
+      container_of(vk_instance, struct panvk_instance, vk);
+
+   if (access(panvk_kbase_device_path(), R_OK | W_OK))
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+
+   struct panvk_physical_device *device =
+      vk_zalloc(&instance->vk.alloc, sizeof(*device), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!device)
+      return panvk_error(instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   VkResult result = panvk_physical_device_init(device, instance, NULL);
+   if (result != VK_SUCCESS) {
+      vk_free(&instance->vk.alloc, device);
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   }
+
+   list_addtail(&device->vk.link, &instance->vk.physical_devices.list);
+   return VK_SUCCESS;
+}
