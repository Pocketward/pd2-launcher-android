+/* Command-stream ioctls (DRM_IOCTL_PANTHOR_GROUP_*, _TILER_HEAP_*) on any CSF
+ * backend.
+ */
+static inline int
+pan_kmod_dev_ioctl(struct pan_kmod_dev *dev, unsigned long request, void *arg)
+{
+   if (dev->ops->ioctl)
+      return dev->ops->ioctl(dev, request, arg);
+
+   return pan_kmod_ioctl(dev->fd, request, arg);
+}
+
+static inline const struct drm_panthor_csif_info *
+pan_kmod_dev_get_csif_props(const struct pan_kmod_dev *dev)
+{
+   if (dev->ops->get_csif_props)
+      return dev->ops->get_csif_props(dev);
+
+   return panthor_kmod_get_csif_props(dev);
+}
+
+static inline uint32_t
+pan_kmod_dev_get_flush_id(const struct pan_kmod_dev *dev)
+{
+   if (dev->ops->get_flush_id)
+      return dev->ops->get_flush_id(dev);
+
+   return panthor_kmod_get_flush_id(dev);
+}
+
+static inline void
+pan_kmod_dev_notify_sync_update(struct pan_kmod_dev *dev)
+{
+   if (dev->ops->notify_sync_update)
+      dev->ops->notify_sync_update(dev);
+}
+
 void pan_kmod_dev_destroy(struct pan_kmod_dev *dev);
 
