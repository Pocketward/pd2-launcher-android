+/* -fbfd: the framebuffer in the descriptor the parent passed (a memfd it
+ * also maps), sized here; memory only, so nothing is synced or removed. */
+static void
+vfbAllocateFramebufferInDescriptor(vfbScreenInfoPtr pvfb)
+{
+    pvfb->mmap_file[0] = '\0';
+    if (pvfb != vfbScreens) {
+        ErrorF("-fbfd holds screen 0 only; screen %d has no framebuffer\n",
+               (int) (pvfb - vfbScreens));
+        return;
+    }
+    pvfb->mmap_fd = fbfd;
+    if (-1 == ftruncate(fbfd, pvfb->sizeInBytes)) {
+        perror("ftruncate");
+        ErrorF("ftruncate descriptor %d failed, %s", fbfd, strerror(errno));
+        return;
+    }
+    pvfb->pXWDHeader = (XWDFileHeader *) mmap((caddr_t) NULL, pvfb->sizeInBytes,
+                                              PROT_READ | PROT_WRITE,
+                                              MAP_SHARED, fbfd, 0);
+    if (-1 == (long) pvfb->pXWDHeader) {
+        perror("mmap");
+        ErrorF("mmap descriptor %d failed, %s", fbfd, strerror(errno));
+        pvfb->pXWDHeader = NULL;
+    }
+}
