+#include <fcntl.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
 #include "util/os_mman.h"
 
 #include "virgl_vtest_winsys.h"
@@ -680,6 +687,67 @@
                                   virgl_hw_res(src));
 }
 
+#ifdef __linux__
+/* PD2 Launcher: the VirGL route's frames stay on the GPU. When
+ * PD2_PRESENT_SOCKET names the app's socket (the app's direct present, Mesa
+ * patch 0004's) and the server can (VCMD_PARAM_PD2_APP_PRESENT), a front
+ * buffer flush asks the server to copy the frame on the GPU into one of the
+ * app's buffers and give it to the app with a fence
+ * (VCMD_PD2_APP_PRESENT), instead of reading it back and putting it on the X
+ * screen. The word at byte 192 of PD2_PRESENT_COUNTER's page says whether
+ * the app shows its buffers now; a frame it does not want, one the server
+ * does not copy (_COPY) and every frame after _OFF go to the X screen as
+ * before. */
+#define VTEST_APP_PRESENT_PAGE 4096
+#define VTEST_APP_PRESENT_WANTED_WORD (192 / sizeof(uint32_t))
+
+static void
+virgl_vtest_app_present_open(struct virgl_vtest_winsys *vtws)
+{
+   const char *socket_path = getenv("PD2_PRESENT_SOCKET");
+   const char *counter = getenv("PD2_PRESENT_COUNTER");
+   if (socket_path == NULL || socket_path[0] == '\0' || counter == NULL || counter[0] == '\0')
+      return;
+   int fd = open(counter, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return;
+   struct stat st;
+   if (fstat(fd, &st) == 0 && st.st_size >= VTEST_APP_PRESENT_PAGE) {
+      void *map = mmap(NULL, VTEST_APP_PRESENT_PAGE, PROT_READ, MAP_SHARED, fd, 0);
+      if (map != MAP_FAILED)
+         vtws->app_present_page = map;
+   }
+   close(fd);
+   if (vtws->app_present_page == NULL)
+      return;
+   vtws->app_present = virgl_vtest_has_app_present(vtws);
+   if (!vtws->app_present) {
+      munmap((void *)vtws->app_present_page, VTEST_APP_PRESENT_PAGE);
+      vtws->app_present_page = NULL;
+   }
+}
+
+/* Whether the frame went to the app (else it goes to the X screen). */
+static bool
+virgl_vtest_app_present(struct virgl_vtest_winsys *vtws, struct virgl_hw_res *res)
+{
+   uint32_t wanted = __atomic_load_n(&vtws->app_present_page[VTEST_APP_PRESENT_WANTED_WORD], __ATOMIC_ACQUIRE);
+   uint32_t answer = virgl_vtest_send_app_present(vtws, res->res_handle,
+                                                  wanted ? VCMD_PD2_APP_PRESENT_WANTED : 0);
+   if (answer == VCMD_PD2_APP_PRESENT_SHOWN) {
+      if (!vtws->app_present_shown)
+         fprintf(stderr, "MESA: virgl direct present: %ux%u into the app's buffers\n", res->width, res->height);
+      vtws->app_present_shown = true;
+      return true;
+   }
+   if (answer == VCMD_PD2_APP_PRESENT_OFF) {
+      fprintf(stderr, "MESA: virgl direct present off: the X screen\n");
+      vtws->app_present = false;
+   }
+   return false;
+}
+#endif
+
 static void virgl_vtest_flush_frontbuffer(struct virgl_winsys *vws,
                                           UNUSED struct virgl_cmd_buf *cmdbuf,
                                           struct virgl_hw_res *res,
@@ -693,6 +761,11 @@
    if (!res->dt)
