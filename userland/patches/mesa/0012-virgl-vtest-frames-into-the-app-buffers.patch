    if (sub_box) {
@@ -722,6 +795,10 @@
    virgl_resource_cache_flush(&vtws->cache);
 
    mtx_destroy(&vtws->mutex);
+#ifdef __linux__
+   if (vtws->app_present_page != NULL)
+      munmap((void *)vtws->app_present_page, VTEST_APP_PRESENT_PAGE);
+#endif
    FREE(vtws);
 }
 
@@ -757,6 +834,9 @@
 
    virgl_vtest_connect(vtws);
    vtws->sws = sws;
+#ifdef __linux__
+   virgl_vtest_app_present_open(vtws);
+#endif
 
