+/* The VirGL route's direct present (patch 0012: the vtest server copies the
+ * frames into the app's buffers): at its first swap, a window names itself
+ * in its root window's _PD2_PRESENT_WINDOW property (one WINDOW), from which
+ * x-input-relay tells the app where it is on the X screen and whether
+ * anything else shows there, as a swapchain of the Vulkan direct present
+ * does (patch 0004). Only when PD2_PRESENT_SOCKET names the app's socket
+ * and GALLIUM_DRIVER is virpipe (the VirGL route), so that no other
+ * software-drawn window takes the name from a Vulkan direct present. A
+ * newer window names itself; the property is never removed. */
+static void
+drisw_present_name_window(struct drisw_drawable *pdp)
+{
+   static const char name[] = "_PD2_PRESENT_WINDOW";
+   if (!pdp->pd2_to_name)
+      return;
+   pdp->pd2_to_name = false;
+   const char *path = getenv("PD2_PRESENT_SOCKET");
+   const char *driver = getenv("GALLIUM_DRIVER");
+   if (path == NULL || path[0] == '\0' || driver == NULL || strcmp(driver, "virpipe") != 0)
+      return;
+   xcb_connection_t *conn = XGetXCBConnection(pdp->base.psc->dpy);
+   xcb_window_t window = (xcb_window_t) pdp->base.xDrawable;
+   xcb_intern_atom_cookie_t atom_cookie = xcb_intern_atom(conn, 0, strlen(name), name);
+   xcb_get_geometry_cookie_t geom_cookie = xcb_get_geometry(conn, window);
+   xcb_generic_error_t *error = NULL;
+   xcb_intern_atom_reply_t *atom = xcb_intern_atom_reply(conn, atom_cookie, &error);
+   free(error);
+   error = NULL;
+   xcb_get_geometry_reply_t *geom = xcb_get_geometry_reply(conn, geom_cookie, &error);
+   free(error);
+   if (atom != NULL && geom != NULL) {
+      /* Checked: an error stays here, never reaching the game's own error handler. */
+      free(xcb_request_check(conn, xcb_change_property_checked(conn, XCB_PROP_MODE_REPLACE, geom->root, atom->atom,
+                                                               XCB_ATOM_WINDOW, 32, 1, &window)));
+   }
+   free(atom);
+   free(geom);
+}
+
 static void
 drisw_present_counted(Display *dpy)
 {
@@ -643,6 +683,12 @@
 }
 #else
 static void
+drisw_present_name_window(struct drisw_drawable *pdp)
+{
+   (void) pdp;
+}
+
+static void
 drisw_present_counted(Display *dpy)
 {
    (void) dpy;
@@ -673,6 +719,7 @@
       CALL_Flush(GET_DISPATCH(), ());
    }
 
