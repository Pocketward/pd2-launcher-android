Subject: [PATCH] virgl/vtest, glx/drisw: the VirGL route's frames into the app's buffers

The VirGL route read each frame back from the vtest server (TRANSFER_GET) and put it on the X
screen (XPutImage), which the Game view then copied. With this patch the frames stay on the GPU:
- the vtest winsys asks the server once (GET_PARAM VCMD_PARAM_PD2_APP_PRESENT, 65, protocol
  version 3 or later) whether it can copy front buffers into the app's buffers (our server's
  patch virglrenderer-gl/0003), when PD2_PRESENT_SOCKET names the app's socket and
  PD2_PRESENT_COUNTER its page. The constants are in virgl_vtest_winsys.h, not in
  src/virtio/vtest/vtest_protocol.h, which mesa-sysdrv/0004 changes for the Venus build (its
  VCMD_PD2_RESOURCE_IMPORT_FD is 64);
- then each front-buffer flush of a whole frame sends VCMD_PD2_APP_PRESENT (65) with the resource and
  whether the app shows its buffers now (the word at byte 192 of the counter's page, as patch
  0004 reads it). The server blits the frame into a free AHardwareBuffer of the app and sends it
  to the app's present server with a fence; the answer SHOWN ends the flush. COPY (the app shows
  the X screen now, no free buffer in time) puts this frame on the X screen as before; OFF (an
  extension or a step failed in the server) puts every later frame there;
- a GLX window, at its first swap on the software path (not Zink's kopper), names itself in its
  root window's _PD2_PRESENT_WINDOW property, as a swapchain of patch 0004 does, so that
  x-input-relay tells the app where the game's window is and whether it is alone. Only when
  PD2_PRESENT_SOCKET is set and GALLIUM_DRIVER is virpipe (the VirGL route), so that no other
  software-drawn window takes the name from a Vulkan direct present.
Patch 0010's clock wait and frame count stay as they are: the frame count still follows each swap.

---
--- a/src/gallium/winsys/virgl/vtest/virgl_vtest_winsys.h
+++ b/src/gallium/winsys/virgl/vtest/virgl_vtest_winsys.h
@@ -34,6 +34,21 @@
 #include "vtest/vtest_protocol.h"
 #include "virgl_resource_cache.h"
 
+/* PD2 Launcher: the server copies a front buffer into the app's buffers (its
+ * patch virglrenderer-gl/0003). GET_PARAM VCMD_PARAM_PD2_APP_PRESENT says
+ * whether it can (an older server answers "not valid"); VCMD_PD2_APP_PRESENT
+ * takes the resource and flags, and the answer is one word. 64 is the Venus
+ * server's VCMD_PD2_RESOURCE_IMPORT_FD (mesa-sysdrv/0004). */
+#define VCMD_PARAM_PD2_APP_PRESENT 65
+#define VCMD_PD2_APP_PRESENT 65
+#define VCMD_PD2_APP_PRESENT_SIZE 2
+#define VCMD_PD2_APP_PRESENT_RES_HANDLE 0
+#define VCMD_PD2_APP_PRESENT_FLAGS 1
+#define VCMD_PD2_APP_PRESENT_WANTED (1u << 0) /* the app shows its buffers now, not the X screen */
+#define VCMD_PD2_APP_PRESENT_SHOWN 0 /* the frame went to the app */
+#define VCMD_PD2_APP_PRESENT_COPY 1  /* not this frame: the X screen */
+#define VCMD_PD2_APP_PRESENT_OFF 2   /* never again: the X screen for every frame */
+
 struct pipe_fence_handle;
 struct sw_winsys;
 struct sw_displaytarget;
@@ -51,6 +66,13 @@
 
    int32_t blob_id;
    unsigned protocol_version;
+
+   /* PD2 Launcher: the server copies front buffers into the app's buffers
+    * (VCMD_PD2_APP_PRESENT); the present counter's page, whose word at byte
+    * 192 says whether the app shows them now, or NULL. */
+   bool app_present;
+   bool app_present_shown;
+   const uint32_t *app_present_page;
 };
 
 struct virgl_hw_res {
@@ -151,6 +173,10 @@
                                        const struct pipe_box *box,
                                        uint32_t format);
 
+bool virgl_vtest_has_app_present(struct virgl_vtest_winsys *vws);
+uint32_t virgl_vtest_send_app_present(struct virgl_vtest_winsys *vws,
+                                      uint32_t handle, uint32_t flags);
+
 int virgl_vtest_busy_wait(struct virgl_vtest_winsys *vws, int handle,
                           int flags);
 
--- a/src/gallium/winsys/virgl/vtest/virgl_vtest_socket.c
+++ b/src/gallium/winsys/virgl/vtest/virgl_vtest_socket.c
@@ -542,6 +542,56 @@
    return 0;
 }
 
+/* PD2 Launcher: whether the server copies front buffers into the app's
+ * buffers (GET_PARAM VCMD_PARAM_PD2_APP_PRESENT; a server without it answers
+ * "not valid"). */
+bool virgl_vtest_has_app_present(struct virgl_vtest_winsys *vws)
+{
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   uint32_t param[VCMD_GET_PARAM_SIZE];
+   uint32_t result[2];
+   ASSERTED int ret;
+
+   /* GET_PARAM came with protocol version 3. */
+   if (vws->protocol_version < 3)
+      return false;
+   vtest_hdr[VTEST_CMD_LEN] = VCMD_GET_PARAM_SIZE;
+   vtest_hdr[VTEST_CMD_ID] = VCMD_GET_PARAM;
+   param[VCMD_GET_PARAM_PARAM] = VCMD_PARAM_PD2_APP_PRESENT;
+   virgl_block_write(vws->sock_fd, &vtest_hdr, sizeof(vtest_hdr));
+   virgl_block_write(vws->sock_fd, &param, sizeof(param));
+
+   ret = virgl_block_read(vws->sock_fd, vtest_hdr, sizeof(vtest_hdr));
+   assert(ret);
+   ret = virgl_block_read(vws->sock_fd, result, sizeof(result));
+   assert(ret);
+   return result[0] && result[1];
+}
+
+/* PD2 Launcher: the server copies front buffer [handle] into the app's
+ * buffers; its answer, VCMD_PD2_APP_PRESENT_SHOWN, _COPY or _OFF. */
+uint32_t virgl_vtest_send_app_present(struct virgl_vtest_winsys *vws,
+                                      uint32_t handle, uint32_t flags)
+{
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   uint32_t cmd[VCMD_PD2_APP_PRESENT_SIZE];
+   uint32_t result[1];
+   ASSERTED int ret;
+
+   vtest_hdr[VTEST_CMD_LEN] = VCMD_PD2_APP_PRESENT_SIZE;
+   vtest_hdr[VTEST_CMD_ID] = VCMD_PD2_APP_PRESENT;
+   cmd[VCMD_PD2_APP_PRESENT_RES_HANDLE] = handle;
+   cmd[VCMD_PD2_APP_PRESENT_FLAGS] = flags;
+   virgl_block_write(vws->sock_fd, &vtest_hdr, sizeof(vtest_hdr));
+   virgl_block_write(vws->sock_fd, &cmd, sizeof(cmd));
+
+   ret = virgl_block_read(vws->sock_fd, vtest_hdr, sizeof(vtest_hdr));
+   assert(ret);
+   ret = virgl_block_read(vws->sock_fd, result, sizeof(result));
+   assert(ret);
+   return result[0];
+}
+
 int virgl_vtest_busy_wait(struct virgl_vtest_winsys *vws, int handle,
                           int flags)
 {
--- a/src/gallium/winsys/virgl/vtest/virgl_vtest_winsys.c
+++ b/src/gallium/winsys/virgl/vtest/virgl_vtest_winsys.c
@@ -28,6 +28,13 @@
 #include "util/u_inlines.h"
 #include "util/os_time.h"
 #include "frontend/sw_winsys.h"
