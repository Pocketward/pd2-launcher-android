+#define SW_TAKEN_WORD (64 / sizeof(uint32_t))
+#define SW_PACED_WORD (128 / sizeof(uint32_t))
+/* A reader that has taken nothing for this long is not waited for again
+ * until it takes a frame: a stalled view never holds the game up.
+ */
+#define SW_PACING_TIMEOUT_NS (100 * 1000 * 1000)
+static bool sw_pacing_mapped;
+/* A stalled reader: SW_STALLED with its taken count in the low 32 bits, or
+ * 0. One word, loaded and stored atomically, so the present threads of
+ * several swapchains always see a matching flag and count.
+ */
+#define SW_STALLED (UINT64_C(1) << 32)
+static uint64_t sw_pacing_stall;
