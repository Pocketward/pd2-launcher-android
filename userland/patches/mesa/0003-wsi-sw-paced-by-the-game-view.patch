+/* Waits until the reader has taken the frame before (its taken count is
+ * the present count), so the game draws no more frames than the reader
+ * shows, one per display frame, in step with it. Every present mode: the
+ * reader shows at most one frame per display frame whatever the mode, so a
+ * frame an IMMEDIATE or MAILBOX swapchain (vsync off) draws beyond that is
+ * never seen. The X server gets the next frame only once the reader has
+ * read the last one, so no frame is written over while it is read. Not
+ * waited for: no reader pacing, and a reader that has stalled.
+ */
+static void
+sw_present_paced(void)
+{
+#if UTIL_FUTEX_SUPPORTED
+   call_once(&sw_present_counter_once, sw_present_counter_open);
+   if (!sw_pacing_mapped)
+      return;
+   uint32_t *taken = &sw_present_counter[SW_TAKEN_WORD];
+   const uint32_t *paced = &sw_present_counter[SW_PACED_WORD];
+   struct timespec deadline;
+   clock_gettime(CLOCK_MONOTONIC, &deadline);
+   timespec_add_nsec(&deadline, &deadline, SW_PACING_TIMEOUT_NS);
+   while (__atomic_load_n(paced, __ATOMIC_ACQUIRE)) {
+      uint32_t seen = __atomic_load_n(taken, __ATOMIC_ACQUIRE);
+      uint32_t presents = __atomic_load_n(sw_present_counter, __ATOMIC_RELAXED);
+      uint64_t stall = __atomic_load_n(&sw_pacing_stall, __ATOMIC_RELAXED);
+      if ((int32_t)(presents - seen) <= 0) {
+         if (stall)
+            __atomic_store_n(&sw_pacing_stall, 0, __ATOMIC_RELAXED);
+         return;
+      }
+      if (stall == (SW_STALLED | seen))
+         return;
+      if (stall)
+         __atomic_store_n(&sw_pacing_stall, 0, __ATOMIC_RELAXED);
+      if (futex_wait(taken, seen, &deadline) != 0 && errno == ETIMEDOUT) {
+         __atomic_store_n(&sw_pacing_stall,
+                          SW_STALLED | __atomic_load_n(taken, __ATOMIC_ACQUIRE),
+                          __ATOMIC_RELAXED);
+         return;
+      }
+   }
+#endif
+}
