+#ifdef __linux__
+/* The software present's back pixmap, while the Game view paces: the game must never wait for
+ * the Game view's take. PutImage sends the whole frame through the X socket, and with the view's
+ * pacing it could only start once the view had taken the frame before. When the PutImage took
+ * longer (about 13 ms instead of 7 for 1616 x 720 on a Mali-G715 in some runs), the PutImage and
+ * the view's copy no longer fitted into one display frame, every frame took two, and the game
+ * waited in acquire for the images the present thread held. So the frame goes into this pixmap
+ * in the X server while the view still reads the window, the image goes back to the game at
+ * once, and only the copy into the window, fast and inside the server, waits for the take
+ * (x11_sw_back_copy, outside the thread state lock). Made at the first such frame, at the
+ * swapchain's size (a resized window makes the swapchain again, and with it the pixmap); none
+ * when the server refuses it. A frame while the view does not pace (the app in the background)
+ * goes to the window as before: no copy and no round trip.
+ */
+static void
+x11_sw_back_prepare(struct x11_swapchain *chain)
+{
+   if (chain->sw_back != XCB_NONE || chain->sw_back_tried)
+      return;
+   chain->sw_back_tried = true;
+   xcb_pixmap_t back = xcb_generate_id(chain->conn);
+   xcb_generic_error_t *err =
+      xcb_request_check(chain->conn,
+                        xcb_create_pixmap_checked(chain->conn, chain->depth, back, chain->window,
+                                                  chain->extent.width, chain->extent.height));
+   if (err == NULL)
+      chain->sw_back = back;
+   free(err);
+}
+
+/* Whether the frame in hand goes to the back pixmap: the Game view paces (its word at byte 128
+ * is not 0) and the pixmap is there. */
+static bool
+x11_sw_back_wanted(struct x11_swapchain *chain)
+{
+   call_once(&sw_present_counter_once, sw_present_counter_open);
+   if (!sw_pacing_mapped ||
+       __atomic_load_n(&sw_present_counter[SW_PACED_WORD], __ATOMIC_ACQUIRE) == 0)
+      return false;
+   x11_sw_back_prepare(chain);
+   return chain->sw_back != XCB_NONE;
+}
+#else
+static bool
+x11_sw_back_wanted(struct x11_swapchain *chain)
+{
+   return false;
+}
+#endif
+
+/* The back pixmap's frame into the window, once the Game view has taken the frame before; a
+ * round trip makes sure that the window has it before the frame is counted. The X server takes
+ * the copy after the frame's PutImage, in request order. */
+static void
+x11_sw_back_copy(struct x11_swapchain *chain)
+{
+   chain->sw_copy_pending = false;
+   sw_present_paced();
+   if (chain->sw_copy_rect_count > 0) {
+      for (int i = 0; i < chain->sw_copy_rect_count; i++) {
+         const xcb_rectangle_t *rect = &chain->sw_copy_rects[i];
+         xcb_discard_reply(chain->conn,
+                           xcb_copy_area(chain->conn, chain->sw_back, chain->window, chain->gc,
+                                         rect->x, rect->y, rect->x, rect->y,
+                                         rect->width, rect->height).sequence);
+      }
+   } else {
+      xcb_discard_reply(chain->conn,
+                        xcb_copy_area(chain->conn, chain->sw_back, chain->window, chain->gc,
+                                      0, 0, 0, 0,
+                                      chain->extent.width, chain->extent.height).sequence);
+   }
+   free(xcb_get_input_focus_reply(chain->conn, xcb_get_input_focus(chain->conn), NULL));
+   sw_present_counted();
+}
