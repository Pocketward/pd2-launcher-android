+                words[SW_DIRECT_GB01_FORMAT] == SW_DIRECT_AHB_R8G8B8A8 &&
+                (uint32_t)words[SW_DIRECT_GB01_WIDTH] == chain->extent.width &&
+                (uint32_t)words[SW_DIRECT_GB01_HEIGHT] == chain->extent.height &&
+                (uint32_t)words[SW_DIRECT_GB01_STRIDE] >= chain->extent.width;
