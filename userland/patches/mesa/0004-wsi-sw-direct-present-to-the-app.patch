+         close(fds[f]);
+      if (!ok) {
+         why = "a buffer";
+         goto fail;
+      }
+      const int32_t *ints = words + SW_DIRECT_GB01_HEADER;
+      if (words[SW_DIRECT_GB01_NUM_INTS] >= 2 && ints[0] == SW_DIRECT_QCOM_MAGIC &&
+          (ints[1] & SW_DIRECT_QCOM_UBWC)) {
+         close(fds[0]);
+         why = "a compressed (UBWC) buffer";
+         goto fail;
+      }
+      buffer_fds[received] = fds[0];
+      strides[received] = (uint32_t)words[SW_DIRECT_GB01_STRIDE];
+   }
+   timeout.tv_sec = 0;
+   setsockopt(d->sock, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+   for (uint32_t b = 0; b < d->count; b++) {
+      if (!sw_direct_import(chain, d, b, buffer_fds[b], strides[b])) {
+         why = "the GPU refused a buffer";
+         goto fail;
+      }
+   }
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      for (uint32_t b = 0; b < d->count; b++) {
+         if (!sw_direct_record(chain, d, i, b)) {
+            why = "command buffers";
+            goto fail;
+         }
+      }
+   }
+   for (uint32_t i = 0; i < received; i++)
+      close(buffer_fds[i]);
+   received = 0;
+   if (thrd_create(&d->reader, sw_direct_reader, d) != thrd_success) {
+      why = "no thread";
+      goto fail;
+   }
+   d->reader_started = true;
+   chain->direct = d;
+   sw_direct_name_window(chain->conn, chain->window);
+   fprintf(stderr, "MESA: direct present: %ux%u, %u images into %u app buffers\n",
+           chain->extent.width, chain->extent.height, chain->base.image_count, d->count);
+   return;
+
+fail:
+   for (uint32_t i = 0; i < received; i++)
+      close(buffer_fds[i]);
+   fprintf(stderr, "MESA: direct present off (%s): the X screen\n", why);
+   sw_direct_free(chain, d);
+}
