+   struct sw_direct *d = vk_zalloc(&chain->base.alloc, sizeof(*d), 8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (d == NULL)
+      return;
+   d->sock = -1;
+   d->count = MIN2(chain->base.image_count, SW_DIRECT_MAX_BUFFERS);
+   d->cmd_buffer_count = wsi->queue_family_count;
+   for (uint32_t i = 0; i < SW_DIRECT_MAX_IMAGES; i++)
+      d->chosen[i] = -1;
+   mtx_init(&d->lock, mtx_plain);
+   u_cnd_monotonic_init(&d->freed);
+   int buffer_fds[SW_DIRECT_MAX_BUFFERS];
+   uint32_t strides[SW_DIRECT_MAX_BUFFERS];
+   uint32_t received = 0;
+   const char *why = NULL;
+
+   d->sock = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+   struct sockaddr_un addr = { .sun_family = AF_UNIX };
+   snprintf(addr.sun_path, sizeof(addr.sun_path), "%s", path);
+   /* The app answers at once or not at all: a second for the setup (a Unix
+    * connect honours the send timeout while the app's backlog is full). */
+   struct timeval timeout = { .tv_sec = 1 };
