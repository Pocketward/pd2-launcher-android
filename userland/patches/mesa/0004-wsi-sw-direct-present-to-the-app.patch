+/* wsi_swapchain::direct_blit: image [image_index] goes to a free app buffer
+ * when the app wants the frames, waiting for one at most SW_DIRECT_WAIT_NS. */
+static VkCommandBuffer
+x11_direct_blit(struct wsi_swapchain *wsi_chain, uint32_t image_index, uint32_t queue_family_index)
+{
+   struct x11_swapchain *chain = (struct x11_swapchain *)wsi_chain;
+   struct sw_direct *d = chain->direct;
+   if (d == NULL || image_index >= SW_DIRECT_MAX_IMAGES || queue_family_index >= d->cmd_buffer_count)
+      return VK_NULL_HANDLE;
+   bool wanted = sw_direct_wanted();
+   struct timespec deadline;
+   clock_gettime(CLOCK_MONOTONIC, &deadline);
+   timespec_add_nsec(&deadline, &deadline, SW_DIRECT_WAIT_NS);
+   int chosen = -1;
+   mtx_lock(&d->lock);
+   /* A reservation whose present never reached the queue thread (a failed submission) is free. */
+   int stale = d->chosen[image_index];
+   if (stale >= 0 && d->state[stale] == SW_DIRECT_RESERVED)
+      d->state[stale] = SW_DIRECT_FREE;
+   d->chosen[image_index] = -1;
+   while (wanted && !d->gone) {
+      for (uint32_t b = 0; b < d->count && chosen < 0; b++) {
+         if (d->state[b] == SW_DIRECT_FREE)
+            chosen = (int)b;
+      }
+      if (chosen >= 0 || u_cnd_monotonic_timedwait(&d->freed, &d->lock, &deadline) != thrd_success)
+         break;
+   }
+   if (chosen >= 0 && d->cmd_buffers[image_index][chosen][queue_family_index] == VK_NULL_HANDLE)
+      chosen = -1;
+   if (chosen >= 0)
+      d->state[chosen] = SW_DIRECT_RESERVED;
+   d->chosen[image_index] = chosen;
+   mtx_unlock(&d->lock);
+   return chosen >= 0 ? d->cmd_buffers[image_index][chosen][queue_family_index] : VK_NULL_HANDLE;
+}
+
+/* Whether this present of [image_index] went to an app buffer. */
+static bool
+sw_direct_chosen(struct x11_swapchain *chain, uint32_t image_index)
+{
+   struct sw_direct *d = chain->direct;
+   if (d == NULL || image_index >= SW_DIRECT_MAX_IMAGES)
+      return false;
+   mtx_lock(&d->lock);
+   bool chosen = d->chosen[image_index] >= 0;
+   mtx_unlock(&d->lock);
+   return chosen;
+}
+
+/* The frame is in the app's buffer (the WSI waited for the GPU): show it;
+ * the image is free again. */
+static VkResult
+x11_present_direct(struct x11_swapchain *chain, uint32_t image_index)
+{
+   struct sw_direct *d = chain->direct;
+   xcb_get_geometry_cookie_t geom_cookie = xcb_get_geometry(chain->conn, chain->window);
+   mtx_lock(&d->lock);
+   int b = d->chosen[image_index];
+   d->chosen[image_index] = -1;
+   d->state[b] = SW_DIRECT_HELD;
+   mtx_unlock(&d->lock);
+   if (!sw_direct_send(d->sock, SW_DIRECT_PRESENT, (uint32_t)b, chain->extent.width, chain->extent.height, 0)) {
+      /* The app has gone; the reader ends and the next presents use PutImage. */
+      mtx_lock(&d->lock);
+      d->gone = true;
+      mtx_unlock(&d->lock);
+   }
+   sw_present_counted();
+   wsi_queue_push(&chain->acquire_queue, image_index);
+
+   VkResult result = VK_SUCCESS;
+   xcb_generic_error_t *err = NULL;
+   xcb_get_geometry_reply_t *geom = xcb_get_geometry_reply(chain->conn, geom_cookie, &err);
+   if (geom) {
+      if (chain->extent.width != geom->width || chain->extent.height != geom->height)
+         result = VK_ERROR_OUT_OF_DATE_KHR;
+   } else {
+      result = VK_ERROR_SURFACE_LOST_KHR;
+   }
+   free(err);
+   free(geom);
+   return result;
+}
