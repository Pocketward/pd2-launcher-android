+/* Sets up the direct present for a new software swapchain; leaves
+ * chain->direct NULL (PutImage) when it is not wanted or anything fails. */
+static void
+sw_direct_open(struct x11_swapchain *chain)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+   const char *path = getenv("PD2_PRESENT_SOCKET");
