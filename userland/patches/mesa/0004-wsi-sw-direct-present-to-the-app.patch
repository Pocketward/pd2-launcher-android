+      goto fail;
+   }
+   setsockopt(d->sock, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+   if (!sw_direct_send(d->sock, SW_DIRECT_HELLO, 0, chain->extent.width, chain->extent.height, d->count)) {
+      why = "HELLO";
+      goto fail;
+   }
+   struct sw_direct_msg m;
