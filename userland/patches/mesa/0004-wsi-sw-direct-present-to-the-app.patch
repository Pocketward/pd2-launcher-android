+       chain->base.blit.type != WSI_SWAPCHAIN_BUFFER_BLIT || chain->base.blit.queue != NULL ||
+       chain->base.image_count > SW_DIRECT_MAX_IMAGES ||
+       wsi->CmdBlitImage == NULL || wsi->GetMemoryFdPropertiesKHR == NULL)
