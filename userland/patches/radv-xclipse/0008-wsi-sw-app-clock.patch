+/* The app's clock: the virtual display's vertical blank. The app counts its ticks in the 32-bit
+ * word at byte 256 of the present counter's page (and wakes its futex waiters) at the rate the
+ * player picked (Settings, Frame rate; Full: the panel's highest rate), and keeps the word at
+ * byte 320 non-zero while it ticks. A present of every mode (FIFO and FIFO_RELAXED: vsync on;
+ * IMMEDIATE and MAILBOX: vsync off) waits until a tick has come since this swapchain's present
+ * before, so the game shows at most one frame a tick, whatever rate the phone's screen runs at,
+ * and a late frame goes at once. The game is held at its acquire: while the clock ticks, the
+ * acquire waits until the game's last presented image has passed this wait (sw_clock_acquire), so
+ * at most one image waits for a tick (this present replaces no queued image, for MAILBOX too). A
+ * clock that has not ticked for SW_PACING_TIMEOUT_NS is not waited for again until it ticks: a
+ * stalled app never holds the game up. Every software present waits here, the app's buffers' and
+ * the X screen's alike.
+ */
+#define SW_TICK_WORD (256 / sizeof(uint32_t))
+#define SW_CLOCK_WORD (320 / sizeof(uint32_t))
+
+static void
+sw_present_clock(struct sw_clock_seen *seen)
+{
+#if UTIL_FUTEX_SUPPORTED
+   call_once(&sw_present_counter_once, sw_present_counter_open);
+   if (!sw_pacing_mapped)
+      return;
+   uint32_t *tick = &sw_present_counter[SW_TICK_WORD];
+   const uint32_t *running = &sw_present_counter[SW_CLOCK_WORD];
+   uint32_t now = __atomic_load_n(tick, __ATOMIC_ACQUIRE);
+   if (now != seen->tick)
+      seen->stalled = false;
+   if (!seen->stalled && now == seen->tick) {
+      struct timespec deadline;
+      clock_gettime(CLOCK_MONOTONIC, &deadline);
+      timespec_add_nsec(&deadline, &deadline, SW_PACING_TIMEOUT_NS);
+      while (now == seen->tick && __atomic_load_n(running, __ATOMIC_ACQUIRE)) {
+         if (futex_wait(tick, now, &deadline) != 0 && errno != EAGAIN && errno != EINTR) {
+            seen->stalled = true; /* the deadline, or a futex that fails: no spin */
+            break;
+         }
+         now = __atomic_load_n(tick, __ATOMIC_ACQUIRE);
+      }
+   }
+   seen->tick = now;
+#endif
+}
+
+/* At most one presented image waits for the app's clock. While the clock ticks, the game's acquire
+ * waits until each image it presented has passed sw_present_clock (sw_clock_waiting: counted by
+ * x11_queue_present, let go by the queue thread, sw_clock_passed). Then the game draws its next
+ * frame after the tick that shows its last frame, and that next frame shows at the next tick: the
+ * frame on the screen is at most about one tick old. Without this wait a game faster than the
+ * clock drew into each free image, and the presented images waited in the present queue, one
+ * tick each: with three images the newest frame showed about three ticks after the game drew it.
+ * The game still draws at most one frame a tick. An acquire that has no time to wait (timeout 0)
+ * does not wait here. [timeout] becomes the time that is left of it; VK_TIMEOUT when it ends
+ * first.
+ */
+static VkResult
+sw_clock_acquire(struct x11_swapchain *chain, uint64_t *timeout)
+{
+#if UTIL_FUTEX_SUPPORTED
+   if (!chain->base.sw || chain->has_mit_shm || *timeout == 0)
+      return VK_SUCCESS;
+   call_once(&sw_present_counter_once, sw_present_counter_open);
+   if (!sw_pacing_mapped || !__atomic_load_n(&sw_present_counter[SW_CLOCK_WORD], __ATOMIC_ACQUIRE))
+      return VK_SUCCESS;
+   int64_t until = os_time_get_absolute_timeout(*timeout);
+   bool forever = until == (int64_t)OS_TIMEOUT_INFINITE;
+   struct timespec deadline;
+   timespec_from_nsec(&deadline, (uint64_t)until);
+   VkResult result = VK_SUCCESS;
+   uint32_t waiting;
+   while ((waiting = __atomic_load_n(&chain->sw_clock_waiting, __ATOMIC_ACQUIRE)) != 0 &&
+          chain->status >= 0) {
+      if (futex_wait(&chain->sw_clock_waiting, (int32_t)waiting, forever ? NULL : &deadline) != 0 &&
+          errno != EAGAIN && errno != EINTR) {
+         if (errno == ETIMEDOUT)
+            result = VK_TIMEOUT;
+         break; /* the deadline, or a futex that fails: no spin */
+      }
+   }
+   if (!forever) {
+      int64_t left = until - os_time_get_nano();
+      *timeout = left > 0 ? (uint64_t)left : 0;
+   }
+   return result;
+#else
+   (void)chain;
+   (void)timeout;
+   return VK_SUCCESS;
+#endif
+}
+
+/* One presented image has passed the app's clock ([all]: the queue thread has stopped, none waits
+ * any more); when none waits, the game's acquire goes on (sw_clock_acquire). */
+static void
+sw_clock_passed(struct x11_swapchain *chain, bool all)
+{
+   uint32_t left = 0;
+   if (all)
+      __atomic_store_n(&chain->sw_clock_waiting, 0, __ATOMIC_RELEASE);
+   else
+      left = __atomic_sub_fetch(&chain->sw_clock_waiting, 1, __ATOMIC_RELEASE);
+#if UTIL_FUTEX_SUPPORTED
+   if (left == 0)
+      futex_wake(&chain->sw_clock_waiting, INT32_MAX);
+#else
+   (void)left;
+#endif
+}
+
+/* Detailed logging's frame times, for the app's split of the pointer's delay (its
+ * pointer_split.h). While the app keeps the word at byte 384 of the present counter's page
+ * non-zero, the software present takes four CLOCK_MONOTONIC times of each frame (enum sw_stamp):
+ * the game's acquire gives it the image, vkQueuePresentKHR queues the image, the queue thread's
+ * wait for the image's fence ends (the GPU has done the frame), and its wait for the app's clock
+ * ends (sw_present_clock). A frame for the app's buffers gets the next serial from the word at
+ * byte 448 (never 0), and x11_present_direct writes its times into slot [serial % 16] of a ring of
+ * 16 slots of 64 bytes from byte 512, before it sends the PRESENT with that serial in its last
+ * word. A slot: the serial (32 bits; 0 while the slot is written), 4 bytes not used, then the
+ * four times (64 bits each). The app reads the slot when it shows the frame. Nothing while the
+ * word is 0; no allocation and no system call other than clock_gettime.
+ */
+#define SW_STAMPS_WORD (384 / sizeof(uint32_t))
+#define SW_STAMPS_SERIAL_WORD (448 / sizeof(uint32_t))
+#define SW_STAMPS_RING 512
+#define SW_STAMPS_SLOT 64
+#define SW_STAMPS_SLOTS 16
+
+static void
+sw_stamp(struct x11_swapchain *chain, uint32_t image_index, enum sw_stamp which)
+{
+   uint64_t *stamp = &chain->images[image_index].sw_stamps[which];
+   *stamp = 0;
+   call_once(&sw_present_counter_once, sw_present_counter_open);
+   if (!sw_pacing_mapped || !__atomic_load_n(&sw_present_counter[SW_STAMPS_WORD], __ATOMIC_RELAXED))
+      return;
+   struct timespec now;
+   clock_gettime(CLOCK_MONOTONIC, &now);
+   *stamp = (uint64_t)now.tv_sec * 1000000000u + (uint64_t)now.tv_nsec;
+}
+
+/* Writes a frame's times [stamps] into the ring (sw_stamp); its serial, 0 when a time is missing. */
+static uint32_t
+sw_stamps_publish(const uint64_t *stamps)
+{
+   if (!sw_pacing_mapped)
+      return 0;
+   for (unsigned i = 0; i < SW_STAMPS; i++) {
+      if (stamps[i] == 0)
+         return 0;
+   }
+   uint32_t *next = &sw_present_counter[SW_STAMPS_SERIAL_WORD];
+   uint32_t serial = __atomic_add_fetch(next, 1, __ATOMIC_RELAXED);
+   if (serial == 0)
+      serial = __atomic_add_fetch(next, 1, __ATOMIC_RELAXED);
+   uint8_t *slot = (uint8_t *)sw_present_counter + SW_STAMPS_RING + (serial % SW_STAMPS_SLOTS) * SW_STAMPS_SLOT;
+   uint32_t *slot_serial = (uint32_t *)slot;
+   uint64_t *times = (uint64_t *)(slot + 8);
+   /* A reader that sees the same serial before and after its copy has all four times. */
+   __atomic_store_n(slot_serial, 0, __ATOMIC_RELAXED);
+   __atomic_thread_fence(__ATOMIC_RELEASE);
+   for (unsigned i = 0; i < SW_STAMPS; i++)
+      __atomic_store_n(&times[i], stamps[i], __ATOMIC_RELAXED);
+   __atomic_store_n(slot_serial, serial, __ATOMIC_RELEASE);
+   return serial;
+}
