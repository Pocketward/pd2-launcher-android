+void
+pan_kmod_kbase_abandon(struct pan_kmod_dev *dev)
+{
+   struct kbase_queue *q = kbase_queue(dev);
+
+   pthread_mutex_lock(&q->lock);
+   mesa_loge("kbase: the queue ends with %u submission(s) open (one is %" PRIu64 ", the newest "
+             "is %" PRIu64 "), %u in flight, %u callback(s) running", q->nr_open_seq,
+             q->nr_open_seq ? q->open_seq[0] : 0, q->next_seq - 1, q->in_flight, q->in_cb);
+   for (unsigned an = 1; an < 256; an++) {
+      if (!q->owner[an])
+         continue;
+      mesa_loge("kbase: atom %u (submission %" PRIu64 "%s) has not reported; its callback is "
+                "dropped", an, q->owner[an]->seq, q->is_fence[an] ? ", fence" : "");
+      q->owner[an]->done = NULL;
+   }
+   while (q->in_cb)
+      pthread_cond_wait(&q->cond, &q->lock);
+   pthread_mutex_unlock(&q->lock);
+}
