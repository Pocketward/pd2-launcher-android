--- a/src/panfrost/lib/kmod/kbase_kmod.h
+++ b/src/panfrost/lib/kmod/kbase_kmod.h
@@ -75,10 +75,21 @@
 void pan_kmod_kbase_wait_seq(struct pan_kmod_dev *dev, uint64_t seq);
 
 /* Wait for submission seq and every one before it, until abs_timeout_ns on CLOCK_MONOTONIC
- * (INT64_MAX: no limit). True when it has completed; seq 0 (never submitted) always has. */
+ * (INT64_MAX: no limit). True when it has completed. 0 waits for everything submitted so far. */
 bool pan_kmod_kbase_wait_seq_timeout(struct pan_kmod_dev *dev, uint64_t seq,
                                      int64_t abs_timeout_ns);
 
+/* The submissions still in flight run no more callback (their command buffers and queue can be
+ * gone); returns once no callback runs. For a queue that ends with work that did not report. */
+void pan_kmod_kbase_abandon(struct pan_kmod_dev *dev);
+
+/* JM: how long a queue waits for its work before it counts the device as lost (vkQueueWaitIdle)
+ * or ends without it (its destroy, which then abandons the callbacks), and how long the event
+ * thread then waits for atoms still in flight before it ends without them. So work that never
+ * reports does not keep a process from ending. */
+#define PAN_KMOD_KBASE_END_QUEUE_TIMEOUT_NS  (10ll * 1000000000ll)
+#define PAN_KMOD_KBASE_END_THREAD_TIMEOUT_NS (2ll * 1000000000ll)
+
 /* Submit atoms and wait for them. Returns false if the kernel refused the submission or an atom
  * completed with a fault. */
 bool pan_kmod_kbase_submit(struct pan_kmod_dev *dev,
