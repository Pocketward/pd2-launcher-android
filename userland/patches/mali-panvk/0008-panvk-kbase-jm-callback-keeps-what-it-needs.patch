-   return h && h <= ks_cap && ks_objs[h - 1].state != KS_FREE ? &ks_objs[h - 1] : NULL;
+   const uint32_t i = h & KS_INDEX_MASK;
+   return i && i <= ks_cap && ks_objs[i - 1].state != KS_FREE &&
+                ks_objs[i - 1].gen == h >> KS_INDEX_BITS
+             ? &ks_objs[i - 1]
+             : NULL;
 }
 
