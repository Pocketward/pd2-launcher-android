-      .state = (flags & DRM_SYNCOBJ_CREATE_SIGNALED) ? KS_SIGNALED : KS_UNSIGNALED, .fd = -1};
+      .state = (flags & DRM_SYNCOBJ_CREATE_SIGNALED) ? KS_SIGNALED : KS_UNSIGNALED,
+      .gen = ks_objs[i].gen, .fd = -1};
    ks_hint = i + 1;
-   *handle = i + 1;
+   *handle = ((uint32_t)ks_objs[i].gen << KS_INDEX_BITS) | (i + 1);
    pthread_mutex_unlock(&ks_lock);
    return 0;
 }
@@ -1000,7 +1015,8 @@
    struct ks_obj *o = ks_get(handle);
    if (o) {
