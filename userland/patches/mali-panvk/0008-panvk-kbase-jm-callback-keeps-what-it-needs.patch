+/* A handle is the slot's index + 1 in its low KS_INDEX_BITS bits and the slot's generation in the
+ * KS_GEN_BITS above them (bit 31 stays clear, and a handle is never 0). So a handle that is freed
+ * stays refused once its slot holds a new object, as a late signal of work that was abandoned
+ * (pan_kmod_kbase_abandon) must not signal or reset another object. */
+#define KS_INDEX_BITS 20
+#define KS_INDEX_MASK ((1u << KS_INDEX_BITS) - 1)
+#define KS_GEN_BITS 11
+#define KS_GEN_MASK ((1u << KS_GEN_BITS) - 1)
+
 /* The runtime (vk_drm_syncobj.c) tells a timeout from an error by errno == ETIME, the way
  * libdrm's wrappers leave it: every failure here sets errno too. Without it, a fence that was
  * merely not signaled yet read as a lost device -- which never happened while every submission
@@ -947,7 +957,11 @@
