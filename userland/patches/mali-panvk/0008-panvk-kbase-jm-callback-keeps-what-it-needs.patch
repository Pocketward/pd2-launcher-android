+      struct ks_obj *o = cap <= KS_INDEX_MASK ? realloc(ks_objs, cap * sizeof(*o)) : NULL;
       if (!o) {
          pthread_mutex_unlock(&ks_lock);
          return ks_ret(-ENOMEM);
@@ -986,9 +1000,10 @@
