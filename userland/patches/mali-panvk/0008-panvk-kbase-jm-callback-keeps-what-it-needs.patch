-      ks_hint = MIN2(ks_hint, handle - 1);
+      o->gen = (o->gen + 1) & KS_GEN_MASK;
+      ks_hint = MIN2(ks_hint, (handle & KS_INDEX_MASK) - 1);
    }
    pthread_mutex_unlock(&ks_lock);
    return ks_ret(o ? 0 : -EINVAL);
