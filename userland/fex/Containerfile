# FEX cross-build image (amd64 host, aarch64 target). Base image pinned by digest, every package
# pinned by exact version from the snapshot in ../config.sh. Built by build.sh.
#
#   stage sysroot  arm64 Debian 13 root with the target's development packages (installed natively
#                  under qemu-user binfmt); copied to /sysroot of the build image.
#   build image    clang/lld 19, CMake, Ninja; i386 and amd64 development packages for the guest
#                  thunk libraries (ThunkLibs/GuestLibs); qemu-user to run aarch64 results.
ARG DEBIAN_IMAGE

FROM --platform=linux/arm64 ${DEBIAN_IMAGE} AS sysroot
ARG DEBIAN_SNAPSHOT
COPY snapshot.sources /etc/apt/sources.list.d/snapshot.sources
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libc6-dev=2.41-12+deb13u4 \
        libstdc++-14-dev=14.2.0-19 \
        libgcc-14-dev=14.2.0-19 \
        llvm-19-dev=1:19.1.7-3+b1 \
        clang-19=1:19.1.7-3+b1 \
        libclang-19-dev=1:19.1.7-3+b1 \
        libclang-cpp19-dev=1:19.1.7-3+b1 \
        libssl-dev=3.5.7-1~deb13u3 \
        libgl-dev=1.7.0-1+b2 \
        libegl-dev=1.7.0-1+b2 \
        libx11-dev=2:1.8.12-1 \
        libxrandr-dev=2:1.5.4-1+b3 \
        libvulkan-dev=1.4.309.0-1 \
        libdrm-dev=2.4.124-2 \
        libwayland-dev=1.23.1-3 \
        libasound2-dev=1.2.14-1+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

FROM --platform=linux/amd64 ${DEBIAN_IMAGE}
ARG DEBIAN_SNAPSHOT
COPY snapshot.sources /etc/apt/sources.list.d/snapshot.sources
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        clang-19=1:19.1.7-3+b1 \
        lld-19=1:19.1.7-3+b1 \
        llvm-19=1:19.1.7-3+b1 \
        cmake=3.31.6-2 \
        ninja-build=1.12.1-1 \
        git=1:2.47.3-0+deb13u1 \
        python3=3.13.5-1 \
        pkgconf=1.8.1-4 \
        qemu-user=1:10.0.13+ds-0+deb13u1 \
        file=1:5.46-5 \
        ca-certificates=20250419 \
        libc6-dev=2.41-12+deb13u4 \
        libstdc++-14-dev=14.2.0-19 \
        libx11-dev=2:1.8.12-1 \
        libxrandr-dev=2:1.5.4-1+b3 \
        libgl-dev=1.7.0-1+b2 \
        libegl-dev=1.7.0-1+b2 \
        libvulkan-dev=1.4.309.0-1 \
        libdrm-dev=2.4.124-2 \
        libwayland-dev=1.23.1-3 \
        libasound2-dev=1.2.14-1+deb13u1 \
        libxrandr-dev:i386=2:1.5.4-1+b3 \
        libc6-dev:i386=2.41-12+deb13u4 \
        libgcc-14-dev:i386=14.2.0-19 \
        libstdc++-14-dev:i386=14.2.0-19 \
        libx11-dev:i386=2:1.8.12-1 \
        libgl-dev:i386=1.7.0-1+b2 \
        libegl-dev:i386=1.7.0-1+b2 \
        libglx-dev:i386=1.7.0-1+b2 \
        libvulkan-dev:i386=1.4.309.0-1 \
        libdrm-dev:i386=2.4.124-2 \
        libwayland-dev:i386=1.23.1-3 \
        libasound2-dev:i386=1.2.14-1+deb13u1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=sysroot /usr /sysroot/usr
RUN ln -s usr/lib /sysroot/lib && ln -s usr/bin /sysroot/bin
ENV PATH=/usr/lib/llvm-19/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
