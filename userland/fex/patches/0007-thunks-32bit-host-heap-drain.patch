FEX (32-bit guests): drain every small size class of the host heap below 4 GiB, not only the smallest.

For a 32-bit guest FEXInterpreter blocks the address space above 4 GiB, then drains what jemalloc
reserved before with malloc(1) until a pointer comes back below 4 GiB. Other size classes keep
slabs and thread-cache entries above 4 GiB, and a 32-bit thunk passes host pointers (a GLX context)
to the guest in 32 bits. The drain walks the size classes from 1 byte to 64 KiB, each until it
answers below 4 GiB, and leaks the upper blocks as the original loop does.

  Source/Tools/FEXInterpreter/FEXInterpreter.cpp | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)
diff --git a/Source/Tools/FEXInterpreter/FEXInterpreter.cpp b/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
index c2eb2fb..f164e7d 100644
--- a/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
+++ b/Source/Tools/FEXInterpreter/FEXInterpreter.cpp
@@ -52,6 +52,7 @@ $end_info$
 #include <cstring>
 #include <elf.h>
 #include <fcntl.h>
+#include <malloc.h>
 #include <mutex>
 #include <queue>
 #include <set>
@@ -178,11 +179,22 @@ fextl::unique_ptr<FEX::HLE::MemAllocator> InitAllocator(bool Is64Bit) {
   // TODO: This will likely consume one arena inside the 32-bit VA space.
   //   - (HdkR): I've noticed jemalloc consuming an 8MB arena commonly.
   FEXCore::Allocator::YesIKnowImNotSupposedToUseTheGlibcAllocator glibc;
-  void* data;
-  do {
-    data = malloc(0x1);
-  } while (reinterpret_cast<uintptr_t>(data) >> 32 != 0);
-  free(data);
+  // Each size class keeps its own partly used slab and thread-cache entries from before the
+  // hooks, so draining only the smallest one leaves upper-VA regions for the others, and a
+  // 32-bit thunk truncates such a host pointer (a GLXContext: glvnd's GLXBadContext). Drain
+  // every size class up to 64 KiB, each until it answers below 4 GiB.
+  constexpr size_t MaxDrainedSize = 64 * 1024;
+  for (size_t Size = 1; Size <= MaxDrainedSize;) {
+    void* data;
+    do {
+      data = malloc(Size);
+    } while (reinterpret_cast<uintptr_t>(data) >> 32 != 0);
+    if (!data) {
+      break;
+    }
+    Size = malloc_usable_size(data) + 1;
+    free(data);
+  }
 
   return Allocator;
 }
