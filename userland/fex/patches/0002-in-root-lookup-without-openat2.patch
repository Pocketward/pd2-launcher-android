@@ -0,0 +1,24 @@
+/*
+$info$
+tags: LinuxSyscalls|common
+desc: openat2(RESOLVE_IN_ROOT) in userspace, for hosts that do not allow the openat2 syscall
+$end_info$
+*/
+
+#pragma once
+
+#include <sys/types.h>
+
+namespace FEX::HLE {
+// Opens `Path` like openat2(RootFD, Path, {Flags, Mode, RESOLVE_IN_ROOT}), without the openat2
+// syscall (Android's app seccomp policy blocks it). Semantics, from openat2(2) RESOLVE_IN_ROOT:
+// - `RootFD` is the root directory of the lookup; an absolute `Path` is relative to it.
+// - Absolute symbolic links are interpreted relative to `RootFD`.
+// - `..` in the root stays in the root, as `/..` does.
+// - A magic link (a procfs link such as /proc/self/fd/N) fails with EXDEV. A symbolic link on
+//   procfs is treated as magic.
+// - More than 40 symbolic links fail with ELOOP.
+// The path is walked one component at a time with openat(O_PATH | O_NOFOLLOW); the last
+// component is opened with the caller's `Flags` and `Mode`. Returns the new fd, or -1 with errno.
+int OpenInRoot(int RootFD, const char* Path, int Flags, mode_t Mode);
+} // namespace FEX::HLE
