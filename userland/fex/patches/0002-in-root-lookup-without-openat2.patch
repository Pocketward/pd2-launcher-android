diff --git a/unittests/APITests/InRootResolver.cpp b/unittests/APITests/InRootResolver.cpp
new file mode 100644
index 0000000..276d4a2
--- /dev/null
+++ b/unittests/APITests/InRootResolver.cpp
@@ -0,0 +1,207 @@
+// Tests for FEX::HLE::OpenInRoot, the userspace openat2(RESOLVE_IN_ROOT) (LinuxSyscalls/InRootResolver.cpp).
+// Expected results follow openat2(2): RESOLVE_IN_ROOT treats the root fd as "/", re-roots absolute
+// symbolic links, clamps ".." at the root, refuses magic links (EXDEV) and stops after 40 links (ELOOP).
+
+#include "LinuxSyscalls/InRootResolver.h"
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <string>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace {
+// A scratch tree:
+//   <base>/etc/passwd                 "host"   (outside the root: reaching it is an escape)
+//   <base>/a/b/root/                  the root
+//     etc/passwd                      "guest"
+//     usr/lib/libfoo.so               "foo"
+//     lib -> usr/lib                  relative link
+//     abs_lib -> /usr/lib             absolute link (re-rooted)
+//     escape_rel -> ../../../etc      relative link that climbs past the root
+//     escape_abs -> /../../../etc     absolute link that climbs past the root
+//     dir/up -> ../etc/passwd         relative link with ".."
+//     loop1 -> loop2, loop2 -> loop1, self -> self
+//     dangling -> /newfile            link to a file that does not exist yet
+//     chain0 -> chain1 -> ... -> chain40 -> etc/passwd
+class Tree {
+public:
+  Tree() {
+    char Template[] = "/tmp/fex-inroot-XXXXXX";
+    REQUIRE(mkdtemp(Template) != nullptr);
+    Base = Template;
+    Root = Base + "/a/b/root";
+
+    for (auto Dir : {"/etc", "/a", "/a/b", "/a/b/root", "/a/b/root/etc", "/a/b/root/usr", "/a/b/root/usr/lib", "/a/b/root/dir"}) {
+      REQUIRE(mkdir((Base + Dir).c_str(), 0755) == 0);
+    }
+    Write(Base + "/etc/passwd", "host");
+    Write(Root + "/etc/passwd", "guest");
+    Write(Root + "/usr/lib/libfoo.so", "foo");
+    Link("usr/lib", "lib");
+    Link("/usr/lib", "abs_lib");
+    Link("../../../etc", "escape_rel");
+    Link("/../../../etc", "escape_abs");
+    Link("../etc/passwd", "dir/up");
+    Link("loop2", "loop1");
+    Link("loop1", "loop2");
+    Link("self", "self");
+    Link("/newfile", "dangling");
+    for (int i = 0; i < 40; ++i) {
+      Link("chain" + std::to_string(i + 1), "chain" + std::to_string(i));
+    }
+    Link("etc/passwd", "chain40");
+
+    RootFD = open(Root.c_str(), O_PATH | O_DIRECTORY | O_CLOEXEC);
+    REQUIRE(RootFD >= 0);
+  }
+
+  ~Tree() {
+    close(RootFD);
+    std::string Cmd = "rm -rf '" + Base + "'";
+    [[maybe_unused]] int Ignored = system(Cmd.c_str());
+  }
+
+  // Opens Path in the root and returns its contents, or "errno:<n>" on failure.
+  std::string Read(const char* Path, int Flags = O_RDONLY) const {
+    int FD = FEX::HLE::OpenInRoot(RootFD, Path, Flags | O_CLOEXEC, 0);
+    if (FD < 0) {
+      return "errno:" + std::to_string(errno);
+    }
+    char Buffer[64] {};
+    ssize_t Size = read(FD, Buffer, sizeof(Buffer) - 1);
+    close(FD);
+    return Size < 0 ? "read-failed" : std::string(Buffer, Size);
+  }
+
+  int Errno(const char* Path, int Flags = O_RDONLY, mode_t Mode = 0) const {
+    int FD = FEX::HLE::OpenInRoot(RootFD, Path, Flags | O_CLOEXEC, Mode);
+    if (FD >= 0) {
+      close(FD);
+      return 0;
+    }
+    return errno;
+  }
+
+  std::string Base;
+  std::string Root;
+  int RootFD = -1;
+
+private:
+  static void Write(const std::string& Path, const char* Data) {
+    int FD = open(Path.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    REQUIRE(FD >= 0);
+    REQUIRE(write(FD, Data, strlen(Data)) == static_cast<ssize_t>(strlen(Data)));
+    close(FD);
+  }
+  void Link(const std::string& Target, const std::string& Name) const {
+    REQUIRE(symlink(Target.c_str(), (Root + "/" + Name).c_str()) == 0);
+  }
+};
+
+const std::string Guest = "guest";
+const std::string Errno(int Error) {
+  return "errno:" + std::to_string(Error);
+}
+} // namespace
+
+TEST_CASE("InRootResolver - plain paths") {
+  Tree T;
+  CHECK(T.Read("/usr/lib/libfoo.so") == "foo");
+  CHECK(T.Read("usr/lib/libfoo.so") == "foo");
+  CHECK(T.Read("//usr///lib/./libfoo.so") == "foo");
+  CHECK(T.Read("/etc/passwd") == Guest);
+}
+
+TEST_CASE("InRootResolver - relative and absolute symlinks") {
+  Tree T;
+  CHECK(T.Read("/lib/libfoo.so") == "foo");
+  CHECK(T.Read("/abs_lib/libfoo.so") == "foo");
+  CHECK(T.Read("/dir/up") == Guest);
+}
+
+TEST_CASE("InRootResolver - dot-dot cannot escape") {
+  Tree T;
+  CHECK(T.Read("/../etc/passwd") == Guest);
+  CHECK(T.Read("/../../../etc/passwd") == Guest);
+  CHECK(T.Read("usr/../../../../etc/passwd") == Guest);
+  CHECK(T.Read("/usr/lib/../../etc/passwd") == Guest);
+  CHECK(T.Read("/escape_rel/passwd") == Guest);
+  CHECK(T.Read("/escape_abs/passwd") == Guest);
+}
+
+TEST_CASE("InRootResolver - symlink loops") {
+  Tree T;
+  CHECK(T.Read("/loop1") == Errno(ELOOP));
+  CHECK(T.Read("/self/x") == Errno(ELOOP));
+  // 40 links are followed, the 41st is refused.
+  CHECK(T.Read("/chain1") == Guest);
+  CHECK(T.Read("/chain0") == Errno(ELOOP));
+}
+
+TEST_CASE("InRootResolver - missing and non-directory components") {
+  Tree T;
+  CHECK(T.Read("/usr/nope/libfoo.so") == Errno(ENOENT));
+  CHECK(T.Read("/nope") == Errno(ENOENT));
+  CHECK(T.Read("") == Errno(ENOENT));
+  CHECK(T.Read("/etc/passwd/x") == Errno(ENOTDIR));
+  CHECK(T.Errno("/etc/passwd/") == ENOTDIR);
+  CHECK(T.Errno(std::string(300, 'x').c_str()) == ENAMETOOLONG);
+}
+
+TEST_CASE("InRootResolver - the root and directories") {
+  Tree T;
+  struct stat RootStat {}, Opened {};
+  REQUIRE(stat(T.Root.c_str(), &RootStat) == 0);
+  for (auto Path : {"/", "/..", "usr/..", "."}) {
+    int FD = FEX::HLE::OpenInRoot(T.RootFD, Path, O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
+    REQUIRE(FD >= 0);
+    REQUIRE(fstat(FD, &Opened) == 0);
+    CHECK(Opened.st_ino == RootStat.st_ino);
+    CHECK(Opened.st_dev == RootStat.st_dev);
+    close(FD);
+  }
+  CHECK(T.Errno("/usr/", O_RDONLY | O_DIRECTORY) == 0);
+  CHECK(T.Errno("/lib/", O_RDONLY | O_DIRECTORY) == 0);
+}
+
+TEST_CASE("InRootResolver - O_NOFOLLOW on the last component") {
+  Tree T;
+  CHECK(T.Errno("/lib", O_RDONLY | O_NOFOLLOW) == ELOOP);
+  int FD = FEX::HLE::OpenInRoot(T.RootFD, "/lib", O_PATH | O_NOFOLLOW | O_CLOEXEC, 0);
+  REQUIRE(FD >= 0);
+  struct stat Stat {};
+  REQUIRE(fstatat(FD, "", &Stat, AT_EMPTY_PATH) == 0);
+  CHECK(S_ISLNK(Stat.st_mode));
+  close(FD);
+  // A link in a middle component is still followed.
+  CHECK(T.Read("/lib/libfoo.so", O_RDONLY | O_NOFOLLOW) == "foo");
+}
+
+TEST_CASE("InRootResolver - O_CREAT through an absolute dangling link stays in the root") {
+  Tree T;
+  CHECK(T.Errno("/dangling", O_WRONLY | O_CREAT | O_EXCL, 0644) == EEXIST);
+  CHECK(T.Errno("/dangling", O_WRONLY | O_CREAT, 0644) == 0);
+  struct stat Stat {};
+  CHECK(stat((T.Root + "/newfile").c_str(), &Stat) == 0);
+  CHECK(access("/newfile", F_OK) != 0);
+}
+
+TEST_CASE("InRootResolver - magic links are refused") {
+  int ProcSelf = open("/proc/self", O_PATH | O_DIRECTORY | O_CLOEXEC);
+  REQUIRE(ProcSelf >= 0);
+  errno = 0;
+  CHECK(FEX::HLE::OpenInRoot(ProcSelf, "exe", O_RDONLY | O_CLOEXEC, 0) == -1);
+  CHECK(errno == EXDEV);
+  CHECK(FEX::HLE::OpenInRoot(ProcSelf, "/fd/0", O_RDONLY | O_CLOEXEC, 0) == -1);
+  CHECK(errno == EXDEV);
+  // Not following the last component is fine.
+  int FD = FEX::HLE::OpenInRoot(ProcSelf, "exe", O_PATH | O_NOFOLLOW | O_CLOEXEC, 0);
+  CHECK(FD >= 0);
+  close(FD);
+  close(ProcSelf);
+}
