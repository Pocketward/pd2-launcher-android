diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/InRootResolver.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/InRootResolver.cpp
new file mode 100644
index 0000000..222771b
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/InRootResolver.cpp
@@ -0,0 +1,246 @@
+/*
+$info$
+tags: LinuxSyscalls|common
+desc: openat2(RESOLVE_IN_ROOT) in userspace, for hosts that do not allow the openat2 syscall
+$end_info$
+*/
+
+#include "LinuxSyscalls/InRootResolver.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <linux/magic.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+namespace FEX::HLE {
+namespace {
+  // Linux's limit on symbolic links followed in one lookup (MAXSYMLINKS); openat2 then fails with ELOOP.
+  constexpr int MaxSymlinks = 40;
+
+  // The directory the walk is in. Owns its fd unless it is the root fd.
+  class Directory final {
+  public:
+    explicit Directory(int Root)
+      : Root {Root}
+      , FD {Root} {}
+    ~Directory() {
+      Release();
+    }
+    Directory(const Directory&) = delete;
+    Directory& operator=(const Directory&) = delete;
+
+    int Get() const {
+      return FD;
+    }
+    void Reset(int New) {
+      Release();
+      FD = New;
+    }
+    void ResetToRoot() {
+      Reset(Root);
+    }
+
+  private:
+    void Release() {
+      if (FD != Root) {
+        int SavedErrno = errno;
+        ::close(FD);
+        errno = SavedErrno;
+      }
+    }
+    const int Root;
+    int FD;
+  };
+
+  bool SameFile(const struct stat& A, const struct stat& B) {
+    return A.st_dev == B.st_dev && A.st_ino == B.st_ino;
+  }
+
+  int Fail(int Error) {
+    errno = Error;
+    return -1;
+  }
+} // namespace
+
+int OpenInRoot(int RootFD, const char* Path, int Flags, mode_t Mode) {
+  if (!Path) {
+    return Fail(EFAULT);
+  }
+  if (Path[0] == '\0') {
+    return Fail(ENOENT);
+  }
+
+  // The rest of the path that is still to be walked. A symbolic link replaces the component that
+  // named it with its target, so the rest moves between two buffers.
+  char Buffers[2][PATH_MAX];
+  int Active = 0;
+  size_t PathLen = strlen(Path);
+  if (PathLen >= PATH_MAX) {
+    return Fail(ENAMETOOLONG);
+  }
+  memcpy(Buffers[Active], Path, PathLen + 1);
+  const char* Rest = Buffers[Active];
+
+  Directory Current {RootFD};
+  // Components walked below the root. `..` at depth 0 stays in the root.
+  size_t Depth = 0;
+  int Symlinks = 0;
+  char Name[NAME_MAX + 1];
+
+  for (;;) {
+    while (*Rest == '/') {
+      ++Rest;
+    }
+
+    if (*Rest == '\0') {
+      // The path names the current directory itself ("/", "dir/", "dir/..").
+      return ::openat(Current.Get(), ".", Flags, Mode);
+    }
+
+    const char* End = strchrnul(Rest, '/');
+    const size_t NameLen = End - Rest;
+    // The last component has nothing after it. A trailing slash makes it a directory component.
+    const bool Last = *End == '\0';
+
+    if (NameLen == 1 && Rest[0] == '.') {
+      Rest = End;
+      continue;
+    }
+
+    if (NameLen == 2 && Rest[0] == '.' && Rest[1] == '.') {
+      Rest = End;
+      if (Depth == 0) {
+        // "If a prefix component of pathname equates to dirfd, then an immediately following ..
+        // component likewise equates to dirfd (just as /.. is traditionally equivalent to /)."
+        continue;
+      }
+      int Parent = ::openat(Current.Get(), "..", O_PATH | O_DIRECTORY | O_CLOEXEC);
+      if (Parent == -1) {
+        return -1;
+      }
+      Current.Reset(Parent);
+      --Depth;
+      if (Depth == 0) {
+        // Back at the root by depth: it must be the root itself, or a directory was moved out
+        // of the root during the walk (openat2 reports such an escape with EXDEV).
+        struct stat RootStat {}, CurrentStat {};
+        if (::fstat(RootFD, &RootStat) == -1 || ::fstat(Current.Get(), &CurrentStat) == -1) {
+          return -1;
+        }
+        if (!SameFile(RootStat, CurrentStat)) {
+          return Fail(EXDEV);
+        }
+        Current.ResetToRoot();
+      }
+      continue;
+    }
+
+    if (NameLen > NAME_MAX) {
+      return Fail(ENAMETOOLONG);
+    }
+    memcpy(Name, Rest, NameLen);
+    Name[NameLen] = '\0';
+
+    bool IsSymlink = false;
+    if (Last) {
+      // open(2): O_NOFOLLOW, and O_CREAT with O_EXCL, do not follow a symbolic link in the last component.
+      const bool FollowLast = !(Flags & O_NOFOLLOW) && !((Flags & O_CREAT) && (Flags & O_EXCL));
+      if (!FollowLast) {
+        return ::openat(Current.Get(), Name, Flags, Mode);
+      }
+
+      struct stat Stat {};
+      if (::fstatat(Current.Get(), Name, &Stat, AT_SYMLINK_NOFOLLOW) == 0 && S_ISLNK(Stat.st_mode)) {
+        IsSymlink = true;
+      } else {
+        // Not a symbolic link (or not there yet, for O_CREAT). O_NOFOLLOW keeps a link that appears
+        // in the meantime from being followed outside the root; the walk then retries it.
+        int FD = ::openat(Current.Get(), Name, Flags | O_NOFOLLOW, Mode);
+        bool BecameSymlink = FD == -1 && errno == ELOOP;
+        if (FD != -1 && (Flags & O_PATH)) {
+          // O_PATH | O_NOFOLLOW opens a symbolic link itself instead of failing.
+          struct stat Opened {};
+          if (::fstat(FD, &Opened) == 0 && S_ISLNK(Opened.st_mode)) {
+            ::close(FD);
+            BecameSymlink = true;
+          }
+        }
+        if (!BecameSymlink) {
+          return FD;
+        }
+        if (++Symlinks > MaxSymlinks) {
+          return Fail(ELOOP);
+        }
+        continue;
+      }
+    } else {
+      int Next = ::openat(Current.Get(), Name, O_PATH | O_NOFOLLOW | O_CLOEXEC);
+      if (Next == -1) {
+        return -1;
+      }
+      struct stat Stat {};
+      if (::fstat(Next, &Stat) == -1) {
+        int SavedErrno = errno;
+        ::close(Next);
+        return Fail(SavedErrno);
+      }
+      if (S_ISLNK(Stat.st_mode)) {
+        ::close(Next);
+        IsSymlink = true;
+      } else if (!S_ISDIR(Stat.st_mode)) {
+        ::close(Next);
+        return Fail(ENOTDIR);
+      } else {
+        Current.Reset(Next);
+        ++Depth;
+        Rest = End;
+        continue;
+      }
+    }
+
+    // Name is a symbolic link that must be followed.
+    if (IsSymlink) {
+      if (++Symlinks > MaxSymlinks) {
+        return Fail(ELOOP);
+      }
+
+      struct statfs FS {};
+      if (::fstatfs(Current.Get(), &FS) == -1) {
+        return -1;
+      }
+      if (FS.f_type == PROC_SUPER_MAGIC) {
+        // procfs links (/proc/self/fd/N, /proc/self/exe, ...) are magic links: RESOLVE_IN_ROOT does not follow them.
+        return Fail(EXDEV);
+      }
+
+      // The target replaces the component: <target>/<rest after the component>.
+      char* Next = Buffers[Active ^ 1];
+      ssize_t TargetLen = ::readlinkat(Current.Get(), Name, Next, PATH_MAX);
+      if (TargetLen == -1) {
+        return -1;
+      }
+      if (TargetLen == 0) {
+        return Fail(ENOENT);
+      }
+      const size_t RestLen = strlen(End);
+      if (static_cast<size_t>(TargetLen) + RestLen >= PATH_MAX) {
+        return Fail(ENAMETOOLONG);
+      }
+      // End is empty or starts with '/', so the target and the rest stay separate components.
+      memcpy(Next + TargetLen, End, RestLen + 1);
+      Active ^= 1;
+      Rest = Next;
+
+      if (Next[0] == '/') {
+        // "Absolute symbolic links are interpreted relative to dirfd."
+        Current.ResetToRoot();
+        Depth = 0;
+      }
+    }
+  }
+}
+} // namespace FEX::HLE
