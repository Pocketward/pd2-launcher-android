+// The guest's /tmp is always the RootFS's own tmp, whether or not the host has a /tmp. Android 13
+// and 14 have none, so every /tmp access already ended there (RootFS lookups first; mkdir, unlink,
+// O_CREAT and chdir through the fallbacks above and below). Android 15 and later have a host /tmp
+// (a tmpfs of the shell user the app cannot write), where the host-first calls stopped with EACCES:
+// Wine's server directory /tmp/.wine-<uid>. Returns `pathname` with its leading "/tmp" replaced by
+// the RootFS's tmp as a host path (kept in `Storage`), any other path unchanged.
+const char* FileManager::RootFSTmp(const char* pathname, fextl::string& Storage) const {
+  if (!pathname || strncmp(pathname, "/tmp", 4) != 0 || (pathname[4] != '\0' && pathname[4] != '/')) {
+    return pathname;
+  }
+  const auto& RootFSPath = LDPath();
+  if (RootFSPath.empty() || RootFSFD == AT_FDCWD) {
+    return pathname;
+  }
+  Storage = RootFSPath;
+  if (Storage.ends_with("/")) {
+    Storage.pop_back();
+  }
+  Storage += pathname;
+  return Storage.c_str();
+}
