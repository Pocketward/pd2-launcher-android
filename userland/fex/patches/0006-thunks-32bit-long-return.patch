+++ b/ThunkLibs/include/common/Host.h
@@ -565,6 +565,24 @@ using as_guest_layout_if = std::conditional_t<Cond, guest_layout<GuestT>, T>;
 template<typename, typename...>
 struct GuestWrapperForHostFunction;
 
+// The guest's type for a host function's return value. On 32-bit guests, long and
+// unsigned long (XIDs such as GLXWindow, GLXPixmap) are 4 bytes; storing the 8-byte
+// host value would write past the guest's packed arguments and clobber its stack.
+template<typename T>
+struct guest_return_type {
+  using type = T;
+};
+#ifdef IS_32BIT_THUNK
+template<>
+struct guest_return_type<unsigned long> {
+  using type = uint32_t;
+};
+template<>
+struct guest_return_type<long> {
+  using type = int32_t;
+};
+#endif
+
