+// For an absolute path whose parent directory does not exist on the host but does in the RootFS:
+// returns an O_PATH fd of the RootFS directory and the last component in `Name`. Otherwise -1.
+// Wine's server creates /tmp/.wine-<uid> this way, and Android has no /tmp.
+int FileManager::OpenRootFSOnlyParent(const char* pathname, char (&Name)[NAME_MAX + 1]) const {
+  if (!pathname || pathname[0] != '/' || RootFSFD == AT_FDCWD) {
+    return -1;
+  }
+  size_t Len = strnlen(pathname, PATH_MAX);
+  if (Len >= PATH_MAX) {
+    return -1;
+  }
+  // mkdir("/tmp/x/") names "x"
+  while (Len > 1 && pathname[Len - 1] == '/') {
+    --Len;
+  }
+  const char* Slash = static_cast<const char*>(memrchr(pathname, '/', Len));
+  const size_t ParentLen = Slash - pathname;
+  const size_t NameLen = Len - ParentLen - 1;
+  if (ParentLen == 0 || NameLen == 0 || NameLen > NAME_MAX) {
+    // The parent is "/", which exists on the host.
+    return -1;
+  }
+  if ((NameLen == 1 && Slash[1] == '.') || (NameLen == 2 && Slash[1] == '.' && Slash[2] == '.')) {
+    return -1;
+  }
+
+  char Parent[PATH_MAX];
+  memcpy(Parent, pathname, ParentLen);
+  Parent[ParentLen] = '\0';
+
+  struct stat HostStat {};
+  if (::stat(Parent, &HostStat) == 0 || (errno != ENOENT && errno != ENOTDIR)) {
+    // The parent exists on the host (or cannot be checked): the host answer stands.
+    return -1;
+  }
+
+  int FD = OpenInRoot(RootFSFD, Parent, O_PATH | O_DIRECTORY | O_CLOEXEC, 0);
+  if (FD == -1) {
+    return -1;
+  }
+  memcpy(Name, Slash + 1, NameLen);
+  Name[NameLen] = '\0';
+  return FD;
+}
+
+uint64_t FileManager::Mkdirat(int dirfd, const char* pathname, mode_t mode) {
+  uint64_t Result = ::mkdirat(dirfd, pathname, mode);
+  if (Result == -1 && (errno == ENOENT || errno == ENOTDIR)) {
+    const int HostErrno = errno;
+    char Name[NAME_MAX + 1];
+    int Parent = OpenRootFSOnlyParent(pathname, Name);
+    if (Parent == -1) {
+      errno = HostErrno;
+      return -1;
+    }
+    Result = ::mkdirat(Parent, Name, mode);
+    const int SavedErrno = errno;
+    ::close(Parent);
+    errno = SavedErrno;
+  }
+  return Result;
+}
+
+uint64_t FileManager::Unlinkat(int dirfd, const char* pathname, int flags) {
+  uint64_t Result = ::unlinkat(dirfd, pathname, flags);
+  if (Result == -1 && (errno == ENOENT || errno == ENOTDIR)) {
+    const int HostErrno = errno;
+    char Name[NAME_MAX + 1];
+    int Parent = OpenRootFSOnlyParent(pathname, Name);
+    if (Parent == -1) {
+      errno = HostErrno;
+      return -1;
+    }
+    Result = ::unlinkat(Parent, Name, flags);
+    const int SavedErrno = errno;
+    ::close(Parent);
+    errno = SavedErrno;
+  }
+  return Result;
+}
