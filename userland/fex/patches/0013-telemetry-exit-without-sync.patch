FEX on Android: the telemetry file is created when FEX starts and rewritten in place at exit, without
a backup rename and without fsync.

Prepare, which FEXInterpreter calls after Initialize, creates <program>.telem when it is missing.
Shutdown opens that file without creating it, truncates and writes it, and does not fsync. An
exiting process changes no directory and waits for no flush, so it ends within the half second
that wineserver gives a Wine process after its socket closes, also on a dirsync filesystem.

 FEXCore/Source/Utils/Telemetry.cpp             | 30 ++++++++++++++++++++----------
 FEXCore/include/FEXCore/Utils/Telemetry.h      |  2 ++
 Source/Tools/FEXInterpreter/FEXInterpreter.cpp |  1 +
 3 files changed, 23 insertions(+), 10 deletions(-)

diff --git a/FEXCore/Source/Utils/Telemetry.cpp b/FEXCore/Source/Utils/Telemetry.cpp
index 9a73b86..dc1dfbf 100644
--- a/FEXCore/Source/Utils/Telemetry.cpp
+++ b/FEXCore/Source/Utils/Telemetry.cpp
@@ -53,21 +53,32 @@ void Initialize() {
   }
 }
 
-void Shutdown(const fextl::string& ApplicationName) {
+static fextl::string TelemetryPath(const fextl::string& ApplicationName) {
+  return Config::GetTelemetryDirectory() + ApplicationName + ".telem";
+}
+
+// The telemetry file is created at start, so that the write at exit changes no directory: on a
+// filesystem mounted dirsync a directory update waits for storage, and an exiting Wine process
+// has already let go of wineserver, which kills it if it is still running half a second later.
+void Prepare(const fextl::string& ApplicationName) {
   if (!Enabled) {
     return;
   }
 
-  auto DataDirectory = Config::GetTelemetryDirectory() + ApplicationName + ".telem";
-
-  // Retain a single backup if the telemetry already existed.
-  auto Backup = DataDirectory + ".bck";
+  const auto Path = TelemetryPath(ApplicationName);
+  if (!FHU::Filesystem::Exists(Path)) {
+    (void)FEXCore::File::File(Path.c_str(), FEXCore::File::FileModes::WRITE | FEXCore::File::FileModes::CREATE);
+  }
+}
 
-  // Failure on rename is okay.
-  (void)FHU::Filesystem::RenameFile(DataDirectory, Backup);
+// At exit the file Prepare made is rewritten in place: no backup rename, no create and no fsync.
+void Shutdown(const fextl::string& ApplicationName) {
+  if (!Enabled) {
+    return;
+  }
 
-  auto File = FEXCore::File::File(DataDirectory.c_str(),
-                                  FEXCore::File::FileModes::WRITE | FEXCore::File::FileModes::CREATE | FEXCore::File::FileModes::TRUNCATE);
+  const auto Path = TelemetryPath(ApplicationName);
+  auto File = FEXCore::File::File(Path.c_str(), FEXCore::File::FileModes::WRITE | FEXCore::File::FileModes::TRUNCATE);
 
   if (File.IsValid()) {
     for (size_t i = 0; i < TelemetryType::TYPE_LAST; ++i) {
@@ -75,7 +86,6 @@ void Shutdown(const fextl::string& ApplicationName) {
       auto& Data = TelemetryValues.at(i);
       fextl::fmt::print(File, "{}: {}\n", Name, Data.load());
     }
-    File.Flush();
   }
 }
 
