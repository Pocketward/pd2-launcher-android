+/*
+$info$
+tags: LinuxSyscalls|common
+desc: Host syscalls that the Android app seccomp policy blocks, and FEX's answers in their place
+$end_info$
+*/
+
+#pragma once
+
+#ifdef ARCHITECTURE_arm64
+#include "LinuxSyscalls/Arm64/SyscallsEnum.h"
+#endif
+
+#include <errno.h>
+
+namespace FEX::HLE {
+class SyscallHandler;
+}
+
+namespace FEX::HLE::Android {
+// Android installs a seccomp filter on every app process (and everything it starts). A blocked
+// host syscall is not executed: the kernel sends SIGSYS, which kills the process. FEX therefore
+// must never issue one. This returns the negated errno that FEX answers instead of issuing host
+// syscall `HostSyscall`, or 0 when Android allows it.
+constexpr int BlockedHostSyscallAnswer(int HostSyscall) {
+#ifdef ARCHITECTURE_arm64
+  switch (HostSyscall) {
+#define ANDROID_BLOCKED_HOST_SYSCALL(name, error) \
+  case FEX::HLE::Arm64::SYSCALL_Arm64_##name: return -(error);
+#include "LinuxSyscalls/Android/BlockedHostSyscalls.inl"
+#undef ANDROID_BLOCKED_HOST_SYSCALL
+  default: return 0;
+  }
+#else
+  return 0;
+#endif
+}
+
+// Replaces the guest syscall handlers whose implementation would issue a blocked host syscall
+// with handlers that answer in userspace. Called last, after every other registration.
+void RegisterAnswers(FEX::HLE::SyscallHandler* Handler);
+} // namespace FEX::HLE::Android
