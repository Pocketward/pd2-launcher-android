+/*
+$info$
+tags: LinuxSyscalls|common
+desc: Userspace answers for guest syscalls whose host syscall Android's app seccomp policy blocks
+$end_info$
+*/
+
+#include "LinuxSyscalls/Android/BlockedHostSyscalls.h"
+#include "LinuxSyscalls/Syscalls.h"
+#include "LinuxSyscalls/ThreadManager.h"
+#include "LinuxSyscalls/x32/Syscalls.h"
+#include "LinuxSyscalls/x64/Syscalls.h"
+
+#include <FEXCore/fextl/vector.h>
+
+#include <algorithm>
+#include <errno.h>
+#include <grp.h>
+#include <limits.h>
+#include <linux/futex.h>
+#include <stdint.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+namespace FEX::HLE::Android {
+namespace {
+  // Every guest syscall that some Android-blocked host syscall would implement must be answered here.
+  // Plain passthroughs need no entry: SyscallPassthroughN answers BlockedHostSyscallAnswer() for them.
+  // The rules follow PROVENANCE.md section 3.2 (pd2launcher android/userland).
+
+  uint64_t NoSys(FEXCore::Core::CpuStateFrame* Frame) {
+    return -ENOSYS;
+  }
+
+  // SysV shm attach/detach: no segment can exist (shmget answers ENOSYS), so the id or address is invalid.
+  uint64_t NoShmSegment(FEXCore::Core::CpuStateFrame* Frame) {
+    return -EINVAL;
+  }
+
+  // set*id: the host calls are blocked (setresuid stays allowed). A request that changes nothing
+  // succeeds; anything else is refused as for an unprivileged process. An Android app never has
+  // CAP_SETUID/CAP_SETGID, so only the effective id would change through setuid/setgid.
+  constexpr uint32_t Unchanged = ~0U;
+
+  uint64_t SetId(uint32_t Id, bool Group) {
+    if (Id == Unchanged) {
+      return -EINVAL;
+    }
+    const uint32_t Effective = Group ? ::getegid() : ::geteuid();
+    return Id == Effective ? 0 : -EPERM;
+  }
+
+  // setreuid/setregid: the saved id follows the new effective id when the real id is given or the
+  // effective id differs from the old real id (setreuid(2)).
+  uint64_t SetReId(uint32_t Real, uint32_t Effective, bool Group) {
+    uid_t R, E, S;
+    if (Group ? ::getresgid(&R, &E, &S) : ::getresuid(&R, &E, &S)) {
+      return -errno;
+    }
+    const uint32_t NewR = Real == Unchanged ? R : Real;
+    const uint32_t NewE = Effective == Unchanged ? E : Effective;
+    const bool SavedFollows = Real != Unchanged || (Effective != Unchanged && Effective != R);
+    const uint32_t NewS = SavedFollows ? NewE : S;
+    return (NewR == R && NewE == E && NewS == S) ? 0 : -EPERM;
+  }
+
+  uint64_t SetResId(uint32_t Real, uint32_t Effective, uint32_t Saved, bool Group) {
+    uid_t R, E, S;
+    if (Group ? ::getresgid(&R, &E, &S) : ::getresuid(&R, &E, &S)) {
+      return -errno;
+    }
+    auto Same = [](uint32_t Requested, uint32_t Current) {
+      return Requested == Unchanged || Requested == Current;
+    };
+    return (Same(Real, R) && Same(Effective, E) && Same(Saved, S)) ? 0 : -EPERM;
+  }
+
+  // setfsuid/setfsgid return the previous filesystem id and cannot fail. Without the syscall the
+  // filesystem id always equals the effective id (execve and setresuid keep them equal).
+  uint64_t SetFsId(bool Group) {
+    return Group ? ::getegid() : ::geteuid();
+  }
+
+  uint64_t SetGroups(size_t Size, const gid_t* List) {
+    if (Size > NGROUPS_MAX) {
+      return -EINVAL;
+    }
+    fextl::vector<gid_t> Requested;
+    if (Size) {
+      FaultSafeUserMemAccess::VerifyIsReadable(List, sizeof(gid_t) * Size);
+      Requested.assign(List, List + Size);
+    }
+    const int Count = ::getgroups(0, nullptr);
+    if (Count < 0) {
+      return -errno;
+    }
+    fextl::vector<gid_t> Current(Count);
+    if (Count && ::getgroups(Count, Current.data()) < 0) {
+      return -errno;
+    }
+    for (auto* Groups : {&Requested, &Current}) {
+      std::sort(Groups->begin(), Groups->end());
+      Groups->erase(std::unique(Groups->begin(), Groups->end()), Groups->end());
+    }
+    return Requested == Current ? 0 : -EPERM;
+  }
+} // namespace
+
+#define ANDROID_ANSWER(name, lambda)                                \
+  do {                                                              \
+    Handler->UnregisterSyscall_64(x64::SYSCALL_x64_##name);         \
+    Handler->UnregisterSyscall_32(x32::SYSCALL_x86_##name);         \
+    REGISTER_SYSCALL_IMPL(name, lambda);                            \
+  } while (false)
+#define ANDROID_ANSWER_X64(name, lambda)                    \
+  do {                                                      \
+    Handler->UnregisterSyscall_64(x64::SYSCALL_x64_##name); \
+    REGISTER_SYSCALL_IMPL_X64(name, lambda);                \
+  } while (false)
+#define ANDROID_ANSWER_X32(name, lambda)                    \
+  do {                                                      \
+    Handler->UnregisterSyscall_32(x32::SYSCALL_x86_##name); \
+    REGISTER_SYSCALL_IMPL_X32(name, lambda);                \
+  } while (false)
+
+void RegisterAnswers(FEX::HLE::SyscallHandler* Handler) {
+  // openat2 is blocked. Guest glibc has no internal user; programs that probe it accept ENOSYS.
+  ANDROID_ANSWER(openat2, NoSys);
+
+  // epoll_pwait2 is blocked (allowed from Android 15). Callers fall back to epoll_pwait.
+  ANDROID_ANSWER(epoll_pwait2, NoSys);
+
+  // set*id family.
+  ANDROID_ANSWER(setuid, [](FEXCore::Core::CpuStateFrame* Frame, uid_t uid) -> uint64_t { return SetId(uid, false); });
+  ANDROID_ANSWER(setgid, [](FEXCore::Core::CpuStateFrame* Frame, gid_t gid) -> uint64_t { return SetId(gid, true); });
+  ANDROID_ANSWER(setreuid,
+                 [](FEXCore::Core::CpuStateFrame* Frame, uid_t ruid, uid_t euid) -> uint64_t { return SetReId(ruid, euid, false); });
+  ANDROID_ANSWER(setregid,
+                 [](FEXCore::Core::CpuStateFrame* Frame, gid_t rgid, gid_t egid) -> uint64_t { return SetReId(rgid, egid, true); });
+  ANDROID_ANSWER(setresgid, [](FEXCore::Core::CpuStateFrame* Frame, gid_t rgid, gid_t egid, gid_t sgid) -> uint64_t {
+    return SetResId(rgid, egid, sgid, true);
+  });
+  ANDROID_ANSWER(setgroups,
+                 [](FEXCore::Core::CpuStateFrame* Frame, size_t size, const gid_t* list) -> uint64_t { return SetGroups(size, list); });
+  ANDROID_ANSWER(setfsuid, [](FEXCore::Core::CpuStateFrame* Frame, uid_t fsuid) -> uint64_t { return SetFsId(false); });
+  ANDROID_ANSWER(setfsgid, [](FEXCore::Core::CpuStateFrame* Frame, gid_t fsgid) -> uint64_t { return SetFsId(true); });
+
+  // x86-64 only.
+  // set_robust_list/get_robust_list are blocked. Nothing would walk a registered list when a thread
+  // dies, so set_robust_list registers nothing and says so with -ENOSYS, as the patched host glibc
+  // does without the syscall (its patch 0002); a guest glibc ignores the answer. get_robust_list then
+  // reports no list for the caller and -EPERM for any other thread, without looking it up.
+  ANDROID_ANSWER_X64(set_robust_list, NoSys);
+  ANDROID_ANSWER_X64(
+    get_robust_list, [](FEXCore::Core::CpuStateFrame* Frame, int pid, struct robust_list_head** head, size_t* len_ptr) -> uint64_t {
+      auto ThreadObject = FEX::HLE::ThreadManager::GetStateObjectFromCPUState(Frame);
+      if (pid != 0 && static_cast<uint32_t>(pid) != ThreadObject->ThreadInfo.TID.load()) {
+        return -EPERM;
+      }
+      FaultSafeUserMemAccess::VerifyIsWritable(head, sizeof(*head));
+      FaultSafeUserMemAccess::VerifyIsWritable(len_ptr, sizeof(*len_ptr));
+      *head = nullptr;
+      *len_ptr = 24; // sizeof(struct robust_list_head) on x86-64.
+      return 0;
+    });
+
+  // accept is blocked; accept4 with no flags is the same call.
+  ANDROID_ANSWER_X64(accept, [](FEXCore::Core::CpuStateFrame* Frame, int sockfd, struct sockaddr* addr, socklen_t* addrlen) -> uint64_t {
+    uint64_t Result = ::syscall(SYSCALL_DEF(accept4), sockfd, addr, addrlen, 0);
+    SYSCALL_ERRNO();
+  });
+
+  // SysV IPC is blocked (the plain passthroughs shmget, semget, msg* already answer ENOSYS).
+  ANDROID_ANSWER_X64(semctl, NoSys);
+  ANDROID_ANSWER_X64(shmat, NoShmSegment);
+  ANDROID_ANSWER_X64(shmdt, NoShmSegment);
+
+  // i386 only.
+  ANDROID_ANSWER_X32(ipc, NoSys);
+  ANDROID_ANSWER_X32(semctl, NoSys);
+  ANDROID_ANSWER_X32(shmat, NoShmSegment);
+  ANDROID_ANSWER_X32(shmdt, NoShmSegment);
+  ANDROID_ANSWER_X32(mq_open, NoSys);
+  ANDROID_ANSWER_X32(mq_timedsend, NoSys);
+  ANDROID_ANSWER_X32(mq_timedreceive, NoSys);
+  ANDROID_ANSWER_X32(mq_notify, NoSys);
+  ANDROID_ANSWER_X32(mq_getsetattr, NoSys);
+  ANDROID_ANSWER_X32(io_pgetevents, NoSys);
+  ANDROID_ANSWER_X32(setuid32, [](FEXCore::Core::CpuStateFrame* Frame, uid_t uid) -> uint64_t { return SetId(uid, false); });
+  ANDROID_ANSWER_X32(setgid32, [](FEXCore::Core::CpuStateFrame* Frame, gid_t gid) -> uint64_t { return SetId(gid, true); });
+  ANDROID_ANSWER_X32(setreuid32,
+                     [](FEXCore::Core::CpuStateFrame* Frame, uid_t ruid, uid_t euid) -> uint64_t { return SetReId(ruid, euid, false); });
+  ANDROID_ANSWER_X32(setregid32,
+                     [](FEXCore::Core::CpuStateFrame* Frame, gid_t rgid, gid_t egid) -> uint64_t { return SetReId(rgid, egid, true); });
+  ANDROID_ANSWER_X32(setresgid32, [](FEXCore::Core::CpuStateFrame* Frame, gid_t rgid, gid_t egid, gid_t sgid) -> uint64_t {
+    return SetResId(rgid, egid, sgid, true);
+  });
+  ANDROID_ANSWER_X32(setgroups32,
+                     [](FEXCore::Core::CpuStateFrame* Frame, size_t size, const gid_t* list) -> uint64_t { return SetGroups(size, list); });
+  ANDROID_ANSWER_X32(setfsuid32, [](FEXCore::Core::CpuStateFrame* Frame, uid_t fsuid) -> uint64_t { return SetFsId(false); });
+  ANDROID_ANSWER_X32(setfsgid32, [](FEXCore::Core::CpuStateFrame* Frame, gid_t fsgid) -> uint64_t { return SetFsId(true); });
+}
+} // namespace FEX::HLE::Android
