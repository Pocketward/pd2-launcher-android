+// faccessat2 without the faccessat2 syscall, which Android's app seccomp policy blocks. Based on
+// glibc 2.41's faccessat() fallback for kernels without faccessat2
+// (sysdeps/unix/sysv/linux/faccessat.c): the faccessat syscall when the flags do not matter,
+// otherwise fstatat, then the faccessat syscall after all once the file is known to be no symlink,
+// and the permission bits only where faccessat cannot answer. AT_EMPTY_PATH is passed on to fstatat.
+// Returns 0, or -1 with errno.
+static int FAccessat2WithoutSyscall(int dirfd, const char* pathname, int mode, int flags) {
+  if (flags & ~(AT_SYMLINK_NOFOLLOW | AT_EACCESS | AT_EMPTY_PATH)) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  // Without AT_SYMLINK_NOFOLLOW and AT_EMPTY_PATH, AT_EACCESS makes no difference while the real
+  // and effective ids are equal.
+  const bool SameIds = ::getuid() == ::geteuid() && ::getgid() == ::getegid();
+  if (flags == 0 || (flags == AT_EACCESS && SameIds)) {
+    return ::syscall(SYSCALL_DEF(faccessat), dirfd, pathname, mode);
+  }
+
+  struct stat Stats {};
+  if (::fstatat(dirfd, pathname, &Stats, flags & (AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH))) {
+    return -1;
+  }
+
+  mode &= (X_OK | W_OK | R_OK);
+  static_assert(R_OK == S_IROTH && W_OK == S_IWOTH && X_OK == S_IXOTH);
+  if (mode == F_OK) {
+    return 0;
+  }
+
+  // Not a symlink, so following the last component changes nothing, and the real ids are the ones to
+  // check (or equal the effective ones): the faccessat syscall answers for the file itself, honouring
+  // read-only and noexec mounts, ACLs and SELinux, which the permission bits below cannot. An empty
+  // path (AT_EMPTY_PATH) names dirfd itself, which faccessat cannot take.
+  if (!S_ISLNK(Stats.st_mode) && ((flags & AT_EACCESS) == 0 || SameIds) && pathname && pathname[0] != '\0') {
+    return ::syscall(SYSCALL_DEF(faccessat), dirfd, pathname, mode);
+  }
+
+  const uid_t uid = (flags & AT_EACCESS) ? ::geteuid() : ::getuid();
+  // The super-user can read and write any file, and execute any file that anyone can execute.
+  if (uid == 0 && ((mode & X_OK) == 0 || (Stats.st_mode & (S_IXUSR | S_IXGRP | S_IXOTH)))) {
+    return 0;
+  }
+
+  const gid_t gid = (flags & AT_EACCESS) ? ::getegid() : ::getgid();
+  auto InGroup = [](gid_t Group) {
+    int Count = ::getgroups(0, nullptr);
+    if (Count <= 0) {
+      return false;
+    }
+    fextl::vector<gid_t> Groups(Count);
+    Count = ::getgroups(Count, Groups.data());
+    return Count > 0 && std::find(Groups.begin(), Groups.begin() + Count, Group) != Groups.begin() + Count;
+  };
+
+  unsigned int Granted;
+  if (uid == Stats.st_uid) {
+    Granted = (Stats.st_mode & (mode << 6)) >> 6;
+  } else if (Stats.st_gid == gid || InGroup(Stats.st_gid)) {
+    Granted = (Stats.st_mode & (mode << 3)) >> 3;
+  } else {
+    Granted = Stats.st_mode & mode;
+  }
+
+  if (Granted == static_cast<unsigned int>(mode)) {
+    return 0;
+  }
+  errno = EACCES;
+  return -1;
+}
