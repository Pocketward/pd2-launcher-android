FEX on Android: open(O_CREAT) of a file whose parent directory exists only in the RootFS.

open, openat and creat with O_CREAT go to the host only. When that fails with ENOENT or ENOTDIR for
an absolute path whose parent does not exist on the host but resolves in the RootFS (patch 0004's
rule and helper), the file is opened relative to that RootFS directory. Wine's esync shm_open
creates /dev/shm/wine-<inode>-esync, which Android lacks and the RootFS has.

diff --git a/Source/Tools/LinuxEmulation/LinuxSyscalls/FileManagement.cpp b/Source/Tools/LinuxEmulation/LinuxSyscalls/FileManagement.cpp
index 8c3fc75..38fbfa9 100644
--- a/Source/Tools/LinuxEmulation/LinuxSyscalls/FileManagement.cpp
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/FileManagement.cpp
@@ -687,11 +687,32 @@ uint64_t FileManager::Open(const char* pathname, int flags, uint32_t mode) {
     ReplaceEmuFd(fd, flags, mode);
   } else {
     fd = ::open(SelfPath, flags, mode);
+    if (fd == -1) {
+      fd = CreateInRootFSOnlyParent(SelfPath, flags, mode);
+    }
   }
 
   return fd;
 }
 
+int FileManager::CreateInRootFSOnlyParent(const char* pathname, int flags, uint32_t mode) const {
+  if (!(flags & O_CREAT) || (errno != ENOENT && errno != ENOTDIR)) {
+    return -1;
+  }
+  const int HostErrno = errno;
+  char Name[NAME_MAX + 1];
+  int Parent = OpenRootFSOnlyParent(pathname, Name);
+  if (Parent == -1) {
+    errno = HostErrno;
+    return -1;
+  }
+  int fd = ::openat(Parent, Name, flags, mode);
+  const int SavedErrno = errno;
+  ::close(Parent);
+  errno = SavedErrno;
+  return fd;
+}
+
 uint64_t FileManager::Close(int fd) {
 #if defined(ASSERTIONS_ENABLED) && ASSERTIONS_ENABLED
   if (CheckIfFDInTrackedSet(fd)) {
@@ -1000,6 +1021,9 @@ uint64_t FileManager::Openat([[maybe_unused]] int dirfs, const char* pathname, i
     ReplaceEmuFd(fd, flags, mode);
   } else {
     fd = ::syscall(SYSCALL_DEF(openat), dirfs, SelfPath, flags, mode);
+    if (fd == -1) {
+      fd = CreateInRootFSOnlyParent(SelfPath, flags, mode);
+    }
   }
 
   return fd;
