# Image for build-panvk.sh: the userland tools image plus what Mesa needs to build PanVK's host
# tools natively (mesa_clc, vtn_bindgen2, panfrost_compile): LLVM, Clang and libclc 19 with the
# SPIR-V translator and SPIRV-Tools. Every package pinned by exact version from the same Debian
# snapshot as the tools image (config.sh); versions resolved with apt-cache policy against it.
ARG TOOLS_IMAGE
FROM ${TOOLS_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        llvm-19-dev=1:19.1.7-3+b1 \
        libclang-19-dev=1:19.1.7-3+b1 \
        libclang-cpp19-dev=1:19.1.7-3+b1 \
        libpolly-19-dev=1:19.1.7-3+b1 \
        clang-19=1:19.1.7-3+b1 \
        libclc-19-dev=1:19.1.7-3 \
        llvm-spirv-19=19.1.6-1 \
        libllvmspirvlib-19-dev=19.1.6-1 \
        spirv-tools=2025.1~rc1-1 \
        zlib1g-dev=1:1.3.dfsg+really1.3.1-1+b1 \
        libzstd-dev=1.5.7+dfsg-1 \
        libdrm-dev=2.4.124-2 \
        gcc=4:14.2.0-1 \
        g++=4:14.2.0-1 \
    && rm -rf /var/lib/apt/lists/*
