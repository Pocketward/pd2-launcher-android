+#define ANDROID_ANSWER_msgsnd ~, ENOSYS
+#define ANDROID_ANSWER_name_to_handle_at ~, ENOSYS
+#define ANDROID_ANSWER_nfsservctl ~, ENOSYS
+#define ANDROID_ANSWER_open_by_handle_at ~, ENOSYS
+#define ANDROID_ANSWER_open_tree ~, EPERM
+#define ANDROID_ANSWER_openat2 ~, ENOSYS
+#define ANDROID_ANSWER_pidfd_getfd ~, ENOSYS
