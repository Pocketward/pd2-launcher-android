--- a/sysdeps/unix/sysv/linux/clock_adjtime.c
+++ b/sysdeps/unix/sysv/linux/clock_adjtime.c
@@ -18,6 +18,7 @@
 
 #include <errno.h>
 #include <stdlib.h>
+#include <string.h>
 #include <time.h>
 #include <sysdep.h>
 #include <sys/timex.h>
@@ -26,27 +27,35 @@
 int
 __clock_adjtime64 (const clockid_t clock_id, struct __timex64 *tx64)
 {
-#ifndef __NR_clock_adjtime64
-# define __NR_clock_adjtime64 __NR_clock_adjtime
-#endif
-  int r = INLINE_SYSCALL_CALL (clock_adjtime64, clock_id, tx64);
-#ifndef __ASSUME_TIME64_SYSCALLS
-  if (r >= 0 || errno != ENOSYS)
-    return r;
-
-  if (tx64->modes & ADJ_SETOFFSET
-      && ! in_int32_t_range (tx64->time.tv_sec))
+  /* The Android app seccomp policy traps clock_adjtime (and adjtimex, ntp_*):
+     it is never issued.  Linux lets any process read CLOCK_REALTIME's state
+     (modes 0, as adjtimex for reading and ntp_gettime ask, or
+     ADJ_OFFSET_SS_READ, as adjtime (NULL, &old) asks); that read is answered
+     here with the kernel's values for a clock no NTP daemon disciplines,
+     since the app cannot see the real ones: unsynchronised (TIME_ERROR), no
+     offset or frequency correction, the current time.  A change gets EPERM,
+     as an unprivileged process gets from Linux.  */
+  if (clock_id == CLOCK_REALTIME
+      && (tx64->modes == 0 || tx64->modes == ADJ_OFFSET_SS_READ))
     {
-      __set_errno (EOVERFLOW);
-      return -1;
+      struct __timespec64 now;
+      if (__clock_gettime64 (CLOCK_REALTIME, &now) != 0)
+        return -1;
+      unsigned int modes = tx64->modes;
+      memset (tx64, 0, sizeof (*tx64));
+      tx64->modes = modes;
+      tx64->maxerror = 16000000;	/* NTP_PHASE_LIMIT, in microseconds.  */
+      tx64->esterror = 16000000;
+      tx64->status = STA_UNSYNC;
+      tx64->constant = 2;		/* The kernel's initial time constant.  */
+      tx64->precision = 1;
+      tx64->tolerance = 500 << 16;	/* MAXFREQ: 500 ppm, scaled by 2^16.  */
+      tx64->time.tv_sec = now.tv_sec;
+      tx64->time.tv_usec = now.tv_nsec / 1000;
+      tx64->tick = 10000;		/* Microseconds a tick at USER_HZ 100.  */
+      return TIME_ERROR;
     }
-
-  struct timex tx32 = valid_timex64_to_timex (*tx64);
-  r = INLINE_SYSCALL_CALL (clock_adjtime, clock_id, &tx32);
-  if (r >= 0)
-    *tx64 = valid_timex_to_timex64 (tx32);
-#endif
-  return r;
+  return INLINE_SYSCALL_ERROR_RETURN_VALUE (EPERM);
 }
 
