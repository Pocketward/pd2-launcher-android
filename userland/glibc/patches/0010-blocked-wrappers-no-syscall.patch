+#define ANDROID_ANSWER_settimeofday ~, EPERM
+#define ANDROID_ANSWER_shmat ~, ENOSYS
+#define ANDROID_ANSWER_shmctl ~, ENOSYS
+#define ANDROID_ANSWER_shmdt ~, ENOSYS
+#define ANDROID_ANSWER_shmget ~, ENOSYS
+#define ANDROID_ANSWER_statmount ~, ENOSYS
+#define ANDROID_ANSWER_swapoff ~, EPERM
+#define ANDROID_ANSWER_swapon ~, EPERM
+#define ANDROID_ANSWER_syslog ~, EPERM
+#define ANDROID_ANSWER_umount2 ~, EPERM
+#define ANDROID_ANSWER_vhangup ~, EPERM
+
+#define ANDROID_ANSWER_SECOND(a, b, ...) b
+#define ANDROID_ANSWER_PROBE(x) ANDROID_ANSWER_SECOND (x, 0, ~)
+#define ANDROID_ANSWER_NAME(name) ANDROID_ANSWER_PROBE (ANDROID_ANSWER_##name)
+#define ANDROID_ANSWER(name) ANDROID_ANSWER_NAME (name)
+
+#if ANDROID_ANSWER (SYSCALL_NAME) != 0 && !SYSCALL_NOERRNO && !SYSCALL_ERRVAL
+
+# define syscall_hidden_def(SYMBOL) hidden_def (SYMBOL)
+
+	.text
+ENTRY (SYSCALL_SYMBOL)
+	mov	x0, #-ANDROID_ANSWER (SYSCALL_NAME)
+	b	.Lsyscall_error
+PSEUDO_END (SYSCALL_SYMBOL)
+
+syscall_hidden_def (SYSCALL_SYMBOL)
+
+#else
+# include_next <syscall-template.S>
+#endif
--- a/sysdeps/unix/sysv/linux/clock_settime.c
+++ b/sysdeps/unix/sysv/linux/clock_settime.c
@@ -32,26 +32,12 @@
       return -1;
     }
 
-#ifndef __NR_clock_settime64
-# define __NR_clock_settime64 __NR_clock_settime
-#endif
-  int ret = INLINE_SYSCALL_CALL (clock_settime64, clock_id, tp);
-
-#ifndef __ASSUME_TIME64_SYSCALLS
-  if (ret == 0 || errno != ENOSYS)
-    return ret;
-
-  if (! in_int32_t_range (tp->tv_sec))
-    {
-      __set_errno (EOVERFLOW);
-      return -1;
-    }
-
-  struct timespec ts32 = valid_timespec64_to_timespec (*tp);
-  ret = INLINE_SYSCALL_CALL (clock_settime, clock_id, &ts32);
-#endif
-
-  return ret;
+  /* The Android app seccomp policy traps clock_settime: it is never issued.
+     Linux refuses any clock but CLOCK_REALTIME with EINVAL, and gives an
+     unprivileged process EPERM for that one.  */
+  if (clock_id != CLOCK_REALTIME)
+    return INLINE_SYSCALL_ERROR_RETURN_VALUE (EINVAL);
+  return INLINE_SYSCALL_ERROR_RETURN_VALUE (EPERM);
 }
 
