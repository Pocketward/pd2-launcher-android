+#define ANDROID_ANSWER_close_range ~, ENOSYS
+#define ANDROID_ANSWER_delete_module ~, EPERM
+#define ANDROID_ANSWER_epoll_pwait2 ~, ENOSYS
+#define ANDROID_ANSWER_fanotify_init ~, ENOSYS
+#define ANDROID_ANSWER_fanotify_mark ~, ENOSYS
+#define ANDROID_ANSWER_finit_module ~, EPERM
+#define ANDROID_ANSWER_fsconfig ~, EPERM
