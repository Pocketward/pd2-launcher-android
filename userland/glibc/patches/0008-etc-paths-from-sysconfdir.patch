+++ b/nss/nss_files/files-alias.c
@@ -42,7 +42,7 @@
 
   if (*stream == NULL)
     {
-      *stream = __nss_files_fopen ("/etc/aliases");
+      *stream = __nss_files_fopen (GLIBC_SYSCONFDIR "/aliases");
 
       if (*stream == NULL)
 	status = errno == EAGAIN ? NSS_STATUS_TRYAGAIN : NSS_STATUS_UNAVAIL;
@@ -58,7 +58,7 @@
 enum nss_status
 _nss_files_setaliasent (void)
 {
-  return __nss_files_data_setent (nss_file_aliasent, "/etc/aliases");
+  return __nss_files_data_setent (nss_file_aliasent, GLIBC_SYSCONFDIR "/aliases");
 }
 libc_hidden_def (_nss_files_setaliasent)
 
@@ -338,7 +338,7 @@
 
   struct nss_files_per_file_data *data;
   enum nss_status status = __nss_files_data_open (&data, nss_file_aliasent,
-						  "/etc/aliases", errnop, NULL);
+						  GLIBC_SYSCONFDIR "/aliases", errnop, NULL);
   if (status != NSS_STATUS_SUCCESS)
     return status;
 
--- a/nss/nss_files/files-init.c
+++ b/nss/nss_files/files-init.c
@@ -41,12 +41,12 @@
 void
 _nss_files_init (void (*cb) (size_t, struct traced_file *))
 {
-  register_file (cb, pwddb, "/etc/passwd", 0);
-  register_file (cb, grpdb, "/etc/group", 0);
-  register_file (cb, hstdb, "/etc/hosts", 0);
-  register_file (cb, hstdb, "/etc/resolv.conf", 1);
-  register_file (cb, servdb, "/etc/services", 0);
-  register_file (cb, netgrdb, "/etc/netgroup", 0);
+  register_file (cb, pwddb, GLIBC_SYSCONFDIR "/passwd", 0);
+  register_file (cb, grpdb, GLIBC_SYSCONFDIR "/group", 0);
+  register_file (cb, hstdb, GLIBC_SYSCONFDIR "/hosts", 0);
+  register_file (cb, hstdb, GLIBC_SYSCONFDIR "/resolv.conf", 1);
+  register_file (cb, servdb, GLIBC_SYSCONFDIR "/services", 0);
+  register_file (cb, netgrdb, GLIBC_SYSCONFDIR "/netgroup", 0);
 }
 libc_hidden_def (_nss_files_init)
 
--- a/nss/nss_files/files-initgroups.c
