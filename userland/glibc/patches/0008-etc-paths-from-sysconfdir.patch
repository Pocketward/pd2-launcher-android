From: User <noreply@users.noreply.github.com>
Subject: [PATCH 08/10] resolver and NSS read their files from sysconfdir

glibc's own code reads resolv.conf, host.conf, gai.conf, nsswitch.conf,
the nss_files and nss_compat databases, netgroup, aliases and the _PATH_*
network files below the configured sysconfdir instead of /etc. Makeconfig
passes -DGLIBC_SYSCONFDIR to every object and the internal include/netdb.h
and include/resolv.h redefine the _PATH_* macros from it; the installed
headers are unchanged. _PATH_BSHELL stays /bin/sh, the system shell on
Android.

Android's /etc is the read-only /system/etc, without resolv.conf.
---
--- a/Makeconfig
+++ b/Makeconfig
@@ -265,6 +265,11 @@
 endif
 inst_sysconfdir = $(install_root)$(sysconfdir)
 
+# The configured sysconfdir as a C string for every object, so that the
+# resolver and NSS read their files below it instead of a hardcoded /etc
+# (on Android /etc is the read-only /system/etc).
+sysconfdir-cppflags = -D'GLIBC_SYSCONFDIR="$(sysconfdir)"'
+
 # Directory for the database files and Makefile for nss_db.
 ifndef vardbdir
 vardbdir = $(localstatedir)/db
@@ -1077,6 +1082,7 @@
 # the implicit -lang-asm and breaks cpp behavior for .S files--notably
 # it causes cpp to stop predefining __ASSEMBLER__.
 CPPFLAGS = $(config-extra-cppflags) $(CPPFLAGS-config) \
+	   $(sysconfdir-cppflags) \
 	   $($(subdir)-CPPFLAGS) \
 	   $(+includes) $(defines) $(module-cppflags) \
 	   -include $(..)include/libc-symbols.h $(sysdep-CPPFLAGS) \
--- a/include/netdb.h
+++ b/include/netdb.h
@@ -3,6 +3,21 @@
 
 #ifndef _ISOMAC
 # include <stdint.h>
+
+/* glibc's own users of these files read them below the configured
+   sysconfdir.  */
+# undef _PATH_HEQUIV
+# define _PATH_HEQUIV		GLIBC_SYSCONFDIR "/hosts.equiv"
+# undef _PATH_HOSTS
+# define _PATH_HOSTS		GLIBC_SYSCONFDIR "/hosts"
+# undef _PATH_NETWORKS
+# define _PATH_NETWORKS		GLIBC_SYSCONFDIR "/networks"
+# undef _PATH_NSSWITCH_CONF
+# define _PATH_NSSWITCH_CONF	GLIBC_SYSCONFDIR "/nsswitch.conf"
+# undef _PATH_PROTOCOLS
+# define _PATH_PROTOCOLS		GLIBC_SYSCONFDIR "/protocols"
+# undef _PATH_SERVICES
+# define _PATH_SERVICES		GLIBC_SYSCONFDIR "/services"
 /* Macros for accessing h_errno from inside libc.  */
 # if IS_IN_LIB
 #  undef  h_errno
--- a/include/resolv.h
+++ b/include/resolv.h
@@ -11,6 +11,11 @@
   while (0)
 # endif
 
+#if !defined _ISOMAC && defined GLIBC_SYSCONFDIR
+/* glibc's resolver reads resolv.conf below the configured sysconfdir;
+   resolv/resolv.h only defines _PATH_RESCONF when it is not set.  */
+# define _PATH_RESCONF GLIBC_SYSCONFDIR "/resolv.conf"
+#endif
 #include <resolv/resolv.h>
 
 # if defined _RESOLV_H_ && !defined _ISOMAC
--- a/resolv/res_hconf.c
+++ b/resolv/res_hconf.c
@@ -48,7 +48,7 @@
 # define fgets_unlocked __fgets_unlocked
 #endif
 
-#define _PATH_HOSTCONF	"/etc/host.conf"
+#define _PATH_HOSTCONF	GLIBC_SYSCONFDIR "/host.conf"
 
 /* Environment vars that all user to override default behavior:  */
 #define ENV_HOSTCONF	"RESOLV_HOST_CONF"
