From: User <noreply@users.noreply.github.com>
Subject: [PATCH 07/10] set*id: answer in user space, never issue a trapped id syscall

setuid, setgid, setreuid, setregid, setresgid, setegid, setgroups,
setfsuid, setfsgid and posix_spawn's POSIX_SPAWN_RESETIDS issue no
id-changing syscall. The new setxid-android.h decides each request from
the current ids with the kernel's rules: a request that leaves every id as
it is returns 0, any other fails with EPERM (EINVAL where Linux answers
that). setfsuid/setfsgid return the current effective id and change
nothing; setfsuid.c and setfsgid.c replace their syscalls.list wrappers.
setresuid and seteuid are unchanged.

The Android app seccomp policy traps these id syscalls (all but setresuid)
with SIGSYS.
---
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/setxid-android.h
@@ -0,0 +1,135 @@
+/* set*id requests answered without a syscall, for the Android app sandbox.  */
+
+#ifndef _SETXID_ANDROID_H
+#define _SETXID_ANDROID_H 1
+
+/* The Android app seccomp policy traps setuid, setgid, setreuid, setregid,
+   setresgid, setgroups, setfsuid and setfsgid; only setresuid is allowed.
+   The functions below decide such a request in user space from the current
+   ids (getresuid, getresgid, geteuid and getgroups are allowed): a request
+   that would leave every id unchanged succeeds, any other request fails
+   with EPERM, which is also what Linux answers an unprivileged process for
+   most of them.  No syscall that changes an id is issued, so there is no
+   need for glibc's all-threads set*id broadcast either.
+
+   The new ids a request would produce follow Linux kernel/sys.c
+   (__sys_setuid, __sys_setreuid, __sys_setresuid and the gid versions).
+   uid_t and gid_t are the same 32-bit type, so one set of helpers serves
+   both.  */
+
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <sysdep.h>
+
+#define SETXID_ANDROID_UNSET ((unsigned int) -1)
+
+static inline int
+setxid_android_answer (bool unchanged)
+{
+  if (unchanged)
+    return 0;
+  return INLINE_SYSCALL_ERROR_RETURN_VALUE (EPERM);
+}
+
+/* Reads the real, effective and saved user (GROUP false) or group (GROUP
+   true) ids.  Returns false if the syscall failed (errno is set).  */
+static inline bool
+setxid_android_current (bool group, unsigned int *r, unsigned int *e,
+			unsigned int *s)
+{
+  int ret = group ? INTERNAL_SYSCALL_CALL (getresgid, r, e, s)
+		  : INTERNAL_SYSCALL_CALL (getresuid, r, e, s);
+  if (INTERNAL_SYSCALL_ERROR_P (ret))
+    {
+      __set_errno (INTERNAL_SYSCALL_ERRNO (ret));
+      return false;
+    }
+  return true;
+}
+
+/* setuid (ID) or setgid (ID).  A privileged caller (effective uid 0) sets
+   the real, effective and saved ids; anyone else may set only the effective
+   id, and only to the real or saved id.  */
+static inline int
+setxid_android_set1 (bool group, unsigned int id)
+{
+  if (id == SETXID_ANDROID_UNSET)
+    return INLINE_SYSCALL_ERROR_RETURN_VALUE (EINVAL);
+  unsigned int r, e, s;
+  if (!setxid_android_current (group, &r, &e, &s))
+    return -1;
+  bool privileged = INTERNAL_SYSCALL_CALL (geteuid) == 0;
+  if (privileged)
+    return setxid_android_answer (r == id && e == id && s == id);
+  return setxid_android_answer ((id == r || id == s) && e == id);
+}
+
+/* setreuid (RID, EID) or setregid (RID, EID).  The saved id becomes the new
+   effective id when the real id is given, or when the effective id is set
+   to something other than the old real id.  */
+static inline int
+setxid_android_set2 (bool group, unsigned int rid, unsigned int eid)
+{
+  unsigned int r, e, s;
+  if (!setxid_android_current (group, &r, &e, &s))
+    return -1;
+  unsigned int nr = rid == SETXID_ANDROID_UNSET ? r : rid;
+  unsigned int ne = eid == SETXID_ANDROID_UNSET ? e : eid;
+  unsigned int ns = s;
+  if (rid != SETXID_ANDROID_UNSET
+      || (eid != SETXID_ANDROID_UNSET && eid != r))
+    ns = ne;
+  return setxid_android_answer (nr == r && ne == e && ns == s);
+}
+
+/* setresgid (RID, EID, SID); -1 leaves an id as it is.  */
+static inline int
+setxid_android_set3 (bool group, unsigned int rid, unsigned int eid,
+		     unsigned int sid)
+{
+  unsigned int r, e, s;
+  if (!setxid_android_current (group, &r, &e, &s))
+    return -1;
+  return setxid_android_answer ((rid == SETXID_ANDROID_UNSET || rid == r)
+				&& (eid == SETXID_ANDROID_UNSET || eid == e)
+				&& (sid == SETXID_ANDROID_UNSET || sid == s));
+}
+
+/* setgroups (N, GROUPS): unchanged when GROUPS is the current supplementary
+   group set (compared as sets, as the kernel keeps them sorted).  */
+static inline int
+setxid_android_setgroups (size_t n, const gid_t *groups)
+{
+  if (n > NGROUPS_MAX)
+    return INLINE_SYSCALL_ERROR_RETURN_VALUE (EINVAL);
+  int count = INTERNAL_SYSCALL_CALL (getgroups, 0, NULL);
+  if (INTERNAL_SYSCALL_ERROR_P (count))
+    return INLINE_SYSCALL_ERROR_RETURN_VALUE (INTERNAL_SYSCALL_ERRNO (count));
+  if ((size_t) count != n)
+    return setxid_android_answer (false);
+  if (n == 0)
+    return 0;
+  gid_t *current = malloc (n * sizeof (gid_t));
+  if (current == NULL)
+    return -1;
+  int got = INTERNAL_SYSCALL_CALL (getgroups, n, current);
+  bool same = !INTERNAL_SYSCALL_ERROR_P (got) && (size_t) got == n;
+  /* Every requested group is current and every current group is
+     requested.  */
+  for (size_t i = 0; same && i < 2 * n; i++)
+    {
+      gid_t want = i < n ? groups[i] : current[i - n];
+      const gid_t *in = i < n ? current : groups;
+      bool found = false;
+      for (size_t j = 0; !found && j < n; j++)
+	found = in[j] == want;
+      same = found;
+    }
+  free (current);
+  return setxid_android_answer (same);
+}
+
+#endif /* setxid-android.h */
--- a/sysdeps/unix/sysv/linux/setuid.c
+++ b/sysdeps/unix/sysv/linux/setuid.c
@@ -17,16 +17,14 @@
 
 #include <errno.h>
 #include <unistd.h>
-#include <setxid.h>
+#include <setxid-android.h>
 
 int
 __setuid (uid_t uid)
 {
-#ifdef __NR_setuid32
-  return INLINE_SETXID_SYSCALL (setuid32, 1, uid);
-#else
-  return INLINE_SETXID_SYSCALL (setuid, 1, uid);
-#endif
+  /* The Android app seccomp policy traps setuid: answer without it
+     (setxid-android.h).  */
+  return setxid_android_set1 (false, uid);
 }
 #ifndef __setuid
 weak_alias (__setuid, setuid)
