--- /dev/null
+++ b/sysdeps/unix/sysv/linux/setfsuid.c
@@ -0,0 +1,14 @@
+/* setfsuid without the setfsuid syscall, for the Android app sandbox.  */
+
+#include <sys/fsuid.h>
+#include <sysdep.h>
+
+/* The Android app seccomp policy traps setfsuid.  Nothing can change the
+   filesystem UID without it, so it is still the effective UID:
+   return that, as setfsuid returns the previous filesystem UID, and
+   change nothing.  */
+int
+setfsuid (uid_t uid)
+{
+  return INTERNAL_SYSCALL_CALL (geteuid);
+}
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/setfsgid.c
@@ -0,0 +1,14 @@
+/* setfsgid without the setfsgid syscall, for the Android app sandbox.  */
+
+#include <sys/fsuid.h>
+#include <sysdep.h>
+
+/* The Android app seccomp policy traps setfsgid.  Nothing can change the
+   filesystem GID without it, so it is still the effective GID:
+   return that, as setfsgid returns the previous filesystem GID, and
+   change nothing.  */
+int
+setfsgid (gid_t gid)
+{
+  return INTERNAL_SYSCALL_CALL (getegid);
+}
