# App userland runtime knobs. relocate.sh installs this as $USERLAND/etc/userland.env with
# @USERLAND@ and @DATA@ replaced. KEY=value lines are the environment the app's service
# gives the programs it starts; commented command lines are how it starts them. Every knob names
# its source (man page in the packaged .deb, or source file and line of the pinned release).
#
# @USERLAND@ = the install prefix; @DATA@ = the app's data folder: config.sh's placeholder, which
# the app rewrites to its canonical data folder as it unpacks the tree.

# --- Libraries ---------------------------------------------------------------------------------
# Only while the userland carries Debian's glibc: its loader searches the absolute Debian paths
# (/lib/aarch64-linux-gnu, /usr/lib/aarch64-linux-gnu), not the prefix. Our loader from
# build-glibc.sh, which searches the prefix, makes this line unnecessary, so relocate.sh drops it with
# PD2_USERLAND_WITH_GLIBC=1.
# Source: glibc ld.so(8), LD_LIBRARY_PATH. Every ELF interpreter is already @USERLAND@/lib/ld-linux-aarch64.so.1
# (relocate.sh) and absolute RUNPATHs are already prefixed.
LD_LIBRARY_PATH=@USERLAND@/usr/lib/aarch64-linux-gnu

# --- Xvfb (built by build-xvfb.sh from xorg-server 21.1.25) -------------------------------------
# Xvfb <display> -screen 0 <W>x<H>x24 -fbfd 3 -extension MIT-SHM \
#      -nolock -nolisten tcp -xkbdir @USERLAND@/usr/share/X11/xkb
#   -fbfd 3             framebuffer in the app's memfd, Xvfb's descriptor 3 (patches/xserver/0003;
#                       Android 11 and later); below Android 11, -fbdir @DATA@/files/tmp/xvfb:
#                       the file DIR/Xvfb_screen0 (man Xvfb, hw/vfb/man/Xvfb.man:66);
#                       never -shmem: SysV shared memory is blocked on Android
#   -extension MIT-SHM  clients fall back to XPutImage (man Xserver, man/Xserver.man:163)
#   -nolock             skips the /tmp lock file and its hard link (os/utils.c LockServer); for
#                       every uid only with patches/xserver/0001
#   -nolisten tcp       (man Xserver, man/Xserver.man:207)
#   -xkbdir DIR         XKB data dir, passed to xkbcomp as -R (man Xserver, man/Xserver.man:422;
#                       xkb/xkbInit.c:745); the compiled-in default is already this path
# No runtime knob, compiled in by build-xvfb.sh (meson options):
#   xkbcomp             @USERLAND@/usr/bin/xkbcomp (xkb_bin_dir; xkb/xkbInit.c:91), run through
#                       /system/bin/sh (patches/xserver/0002; os/utils.c Popen)
#   compiled keymaps    @DATA@/files/tmp/xkb/ (xkb_output_dir; xkb/ddxLoad.c:63-87); the app must
#                       create this directory, else Xvfb falls back to /tmp/, which Android lacks
#   GLX swrast driver   @USERLAND@/usr/lib/aarch64-linux-gnu/dri/swrast_dri.so (DRI_DRIVER_PATH)
# Not relocatable: the X socket path /tmp/.X11-unix/X<n> (xtrans Xtranssock.c:203). xtrans also
# listens on the abstract socket @/tmp/.X11-unix/X<n> (HAVE_ABSTRACT_SOCKETS), which libxcb tries
# first, and which every app on the device shares: hence a display of its own for each app, which
# the app gives Xvfb and its X clients (:0 for the release app, :1 for the development build).

# --- X clients ---------------------------------------------------------------------------------
# libX11's locale database. Source: libX11, XLOCALEDIR (string in libX11.so.6; default /usr/share/X11/locale).
XLOCALEDIR=@USERLAND@/usr/share/X11/locale

# --- Runtime folder ----------------------------------------------------------------------------
# The session's runtime folder, the engine's and the game's Wine processes' XDG_RUNTIME_DIR (the
# app sets it, SessionPaths.runtimeDir): the game's sound ring and its ALSA configuration, which
# the runtime's Wine reads from there (runtime/patches/wine/0003). No sound server runs.
XDG_RUNTIME_DIR=@DATA@/files/tmp/run

# --- GL (Mesa main at config.sh's MESA_COMMIT, built by build-mesa.sh: Zink in libgallium) --------
# GL and Vulkan values are for the game's Wine processes only (the ARM64 Wine loads our Mesa in
# them), so no userland program gets them as such: the app gives the Launcher engine
# PD2_APP_WINE_<NAME>=<value> as <NAME>=<value>, and the engine passes it to every Wine process.
# Source: Mesa docs/envvars.rst (MESA_LOADER_DRIVER_OVERRIDE).
PD2_APP_WINE_MESA_LOADER_DRIVER_OVERRIDE=zink
# The X server has no DRI3 (Xvfb): GLX and Zink's Kopper must not use it.
PD2_APP_WINE_LIBGL_DRI3_DISABLE=1
PD2_APP_WINE_LIBGL_KOPPER_DRI2=1
# glvnd: EGL vendor JSONs are looked up in /etc and /usr/share (string in libEGL.so.1).
# Source: libglvnd README, __EGL_VENDOR_LIBRARY_DIRS / __GLX_VENDOR_LIBRARY_NAME.
PD2_APP_WINE___EGL_VENDOR_LIBRARY_DIRS=@USERLAND@/usr/share/glvnd/egl_vendor.d
PD2_APP_WINE___GLX_VENDOR_LIBRARY_NAME=mesa

# --- Vulkan (Turnip, built by build-mesa.sh) -----------------------------------------------------
# Source: Vulkan-Loader docs/LoaderInterfaceArchitecture.md: VK_DRIVER_FILES (VK_ICD_FILENAMES is
# the older name, still honoured; both strings in libvulkan.so.1 1.4.309). The ICD's library_path
# is absolute (@USERLAND@/usr/lib/aarch64-linux-gnu/libvulkan_freedreno.so).
PD2_APP_WINE_VK_DRIVER_FILES=@USERLAND@/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
PD2_APP_WINE_VK_ICD_FILENAMES=@USERLAND@/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
# Xvfb has no DRI3, and Mesa's X11 Vulkan WSI refuses a hardware driver's surface without it
# ("vulkan: No DRI3 support detected - required for presentation"): Zink cannot create its
# swapchain and every glXSwapBuffers fails with GLXBadCurrentWindow. "sw" makes the WSI copy
# each frame on the CPU (or, with patch 0004, blit it into the app's buffers).
# Source: Mesa docs/envvars.rst, MESA_VK_WSI_DEBUG (src/vulkan/wsi/wsi_common.c).
PD2_APP_WINE_MESA_VK_WSI_DEBUG=sw
# Turnip renders every pass straight to memory (sysmem) instead of choosing GMEM tiles per pass
# (its autotune). D2GL draws thousands of small quads a frame into one framebuffer; tiled, each
# draw goes through the binning pass and is replayed per tile, which on a small-GMEM Adreno costs
# more than the memory traffic it saves.
# Source: Mesa docs/envvars.rst TU_DEBUG,
# src/freedreno/vulkan/tu_util.cc tu_debug_options ("sysmem").
PD2_APP_WINE_TU_DEBUG=sysmem
# OpenGL 3.3 core and GLSL 3.30 for D2GL on every route: here for the App driver (Turnip, and the
# Compatibility driver), and each route below sets the same over it. Zink on Turnip offers more
# (4.0 on an Adreno 610, 4.6 on an Adreno 740), but D2GL's shaders are "#version 330" and only its
# upscaler's follow the version (d2gl upscaler.cpp:460-480); a test phone gave the same frame rate, GPU
# load and picture with 3.3 and 4.6. D2GL saves the version it got in d2gl.json and next asks only
# for a version whose major and minor are each at most the saved ones (d2gl graphic/context.cpp:63-81,
# option/config.cpp:147-148), so a 4.0 saved on Turnip never asked for 3.3 on another route ("Requires
# OpenGL 3.3 or newer!" on VirGL on an Adreno 610 phone). The engine (0.1.14) writes gl_ver 3.3 into d2gl.json
# before each Glide start, and 3.3 on every route keeps the saved value at 3.3.
# Source: Mesa docs/envvars.rst MESA_GL_VERSION_OVERRIDE, MESA_GLSL_VERSION_OVERRIDE.
PD2_APP_WINE_MESA_GL_VERSION_OVERRIDE=3.3
PD2_APP_WINE_MESA_GLSL_VERSION_OVERRIDE=330
# The app's Compatibility graphics driver: the same Turnip with
# PD2_APP_WINE_COMPATIBILITY_<NAME>=<value> over the values above for a Play with it (the app gives
# the engine PD2_APP_COMPATIBILITY_<NAME>=<value>, which the engine uses in place of <NAME> while
# that driver is in use). TU_DEBUG: sysmem (as the standard driver), noubwc turns off
# UBWC compression, nolrz the low-resolution Z pass: the options Mesa names to narrow down a Turnip
# hang or misrendering. Slower, the way out when the standard driver draws wrong or hangs.
# Source: Mesa docs/drivers/freedreno.rst ("Debugging"), docs/envvars.rst TU_DEBUG,
# src/freedreno/vulkan/tu_util.cc tu_debug_options.
PD2_APP_WINE_COMPATIBILITY_TU_DEBUG=sysmem,noubwc,nolrz

# --- Vulkan on Mali (PanVK with our kbase backend, built by build-panvk.sh) ---------------------
# On a Mali GPU (Arm's kbase driver, /dev/mali0, no KGSL) the app gives the engine
# PD2_APP_WINE_MALI_<NAME>=<value> as <NAME>=<value>, a value of the same name replacing the one
# above, and leaves out Turnip's own (TU_DEBUG and the Compatibility driver's values); on an
# Adreno it leaves the Mali values out.
# The ICD's library_path is absolute (@USERLAND@/usr/lib/aarch64-linux-gnu/libvulkan_panfrost.so).
# Source: Vulkan-Loader docs/LoaderInterfaceArchitecture.md (as for Turnip above).
# No value of this set may be named PANVK_<NAME>: PD2_APP_WINE_MALI_PANVK_ is the mali-panvk route's
# prefix (below), which the app keeps out of this set.
PD2_APP_WINE_MALI_VK_DRIVER_FILES=@USERLAND@/usr/share/vulkan/icd.d/panfrost_icd.aarch64.json
PD2_APP_WINE_MALI_VK_ICD_FILENAMES=@USERLAND@/usr/share/vulkan/icd.d/panfrost_icd.aarch64.json
# PanVK refuses a v11 Mali (such as the Mali-G715) as "not well-tested" without this; v10, v12
# and v13 do not read it. Source: Mesa src/panfrost/vulkan/panvk_physical_device.c
# (the arch switch before the physical device is created).
PD2_APP_WINE_MALI_PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
# PanVK has no transform feedback, so Zink offers GL 2.1 only and D2GL gets no 3.3 core context;
# with these Zink reports 3.3 core and compatibility with GLSL 3.30, and D2GL, which uses neither
# transform feedback nor geometry shaders, draws correctly.
# Source: Mesa docs/envvars.rst MESA_GL_VERSION_OVERRIDE, MESA_GLSL_VERSION_OVERRIDE.
PD2_APP_WINE_MALI_MESA_GL_VERSION_OVERRIDE=3.3
PD2_APP_WINE_MALI_MESA_GLSL_VERSION_OVERRIDE=330

# --- Vulkan and GL on the phone's own driver (the system-driver mode, build-sysdrv.sh) ---------
# For GPUs that Turnip and PanVK do not drive: Zink -> Mesa's Venus ICD -> vtest's socket ->
# virglrenderer's server from the APK (android/devdriver/), which the app's service starts as
# libvirgl_test_server.so --venus --no-virgl --socket-path @DATA@/files/tmp/run/vtest.sock, on the
# phone's own Vulkan driver. In that mode the app gives the
# engine PD2_APP_WINE_SYSDRV_<NAME>=<value> as <NAME>=<value>, a value of the same name replacing
# the one above, and leaves out Turnip's own (TU_DEBUG and the Compatibility driver's values).
# The Venus ICD (Mesa main at config.sh's MESA_COMMIT, our WSI patches). Source: Vulkan-Loader
# docs/LoaderInterfaceArchitecture.md (as for Turnip above).
PD2_APP_WINE_SYSDRV_VK_DRIVER_FILES=@USERLAND@/usr/share/vulkan/icd.d/virtio_icd.aarch64.json
PD2_APP_WINE_SYSDRV_VK_ICD_FILENAMES=@USERLAND@/usr/share/vulkan/icd.d/virtio_icd.aarch64.json
# The server's socket; set, it also makes Venus use vtest where no virtio-gpu device exists. The
# engine passes MESA_* variables to Wine processes but not VTEST_* (src/wine_environment.rs), so
# our Venus build also reads MESA_VTEST_SOCKET_NAME (patches/mesa-sysdrv/0001); VTEST_SOCKET_NAME
# is for programs started outside the engine.
# Source: Mesa src/virtio/vulkan/vn_renderer_vtest.c, vtest_init (VTEST_SOCKET_NAME).
PD2_APP_WINE_SYSDRV_MESA_VTEST_SOCKET_NAME=@DATA@/files/tmp/run/vtest.sock
PD2_APP_WINE_SYSDRV_VTEST_SOCKET_NAME=@DATA@/files/tmp/run/vtest.sock
# The mode's GL stack: "mesa" above (the product Mesa's Zink, main) wherever the phone's driver
# meets that Zink's needs; only where it refuses the driver, the app adds PD2_APP_WINE_SYSDRV_OLDER_ZINK_*
# as well (SystemDriver.Zink): Mesa 25.1.9's Zink as glvnd's vendor "pd2sysdrv", glvnd then loads
# libGLX_pd2sysdrv.so.0 with its libgallium-25.1.9.so (build-sysdrv.sh). Open on 25.1.9: PD2's
# menu buttons without text on an Arm driver.
# Source: libglvnd README.md (__GLX_VENDOR_LIBRARY_NAME, libGLX_<vendor>.so.0).
PD2_APP_WINE_SYSDRV_OLDER_ZINK___GLX_VENDOR_LIBRARY_NAME=pd2sysdrv
# OpenGL 3.3 core for D2GL on every phone driver, as on a Mali with PanVK: Zink knows only
# VK_EXT_vertex_attribute_divisor (Arm's drivers have the KHR one) and needs dual-source blending
# for GL 3.3, both of which D2GL does not use (no instanced arrays, no SRC1 blending); Zink on
# Arm's Mali-G715 driver through Venus offered 3.2.
# Where Zink offers more, 3.3 keeps D2GL on the smallest part of the driver.
# Source: Mesa docs/envvars.rst MESA_GL_VERSION_OVERRIDE, MESA_GLSL_VERSION_OVERRIDE.
PD2_APP_WINE_SYSDRV_MESA_GL_VERSION_OVERRIDE=3.3
PD2_APP_WINE_SYSDRV_MESA_GLSL_VERSION_OVERRIDE=330

# --- OpenGL on the phone's own OpenGL ES driver (the system-driver mode's VirGL route) -----------
# For GPUs that the built-in drivers do not support and whose Vulkan driver cannot run Zink: the
# product Mesa's virgl driver (build-mesa.sh) on the GLX software path sends OpenGL over vtest's
# socket to the APK's second virglrenderer server, which the app's service starts as
# libvirgl_test_server_gl.so --use-egl-surfaceless --use-gles --socket-path @DATA@/files/tmp/run/vtest.sock;
# its OpenGL renderer (vrend) draws with the phone's own OpenGL ES 3.0 or later. On this route the
# app gives the engine PD2_APP_WINE_VIRGL_<NAME>=<value> as <NAME>=<value>, a value of the same
# name replacing the one above, and an empty value leaving <NAME> out; Turnip's own (TU_DEBUG and
# the Compatibility driver's values) are left out too.
# The GLX software path with the virgl driver ("virpipe"): no Zink (GLX takes Zink while
# MESA_LOADER_DRIVER_OVERRIDE=zink is set, also on the software path: left out here), no DRI3.
# Source: Mesa docs/envvars.rst (LIBGL_ALWAYS_SOFTWARE, GALLIUM_DRIVER),
# src/gallium/auxiliary/target-helpers/sw_helper.h (sw_screen_create_named: "virpipe"),
# src/glx/glxext.c (MESA_LOADER_DRIVER_OVERRIDE and the zink driver).
PD2_APP_WINE_VIRGL_GALLIUM_DRIVER=virpipe
PD2_APP_WINE_VIRGL_LIBGL_ALWAYS_SOFTWARE=1
PD2_APP_WINE_VIRGL_MESA_LOADER_DRIVER_OVERRIDE=
# The server's socket (the same path as the Venus route's). The engine passes MESA_* variables to
# Wine processes but not VTEST_*, so our Mesa's virgl also reads MESA_VTEST_SOCKET_NAME
# (patches/mesa/0009); VTEST_SOCKET_NAME is for programs started outside the engine.
# Source: Mesa src/gallium/winsys/virgl/vtest/virgl_vtest_socket.c (VTEST_SOCKET_NAME).
PD2_APP_WINE_VIRGL_MESA_VTEST_SOCKET_NAME=@DATA@/files/tmp/run/vtest.sock
PD2_APP_WINE_VIRGL_VTEST_SOCKET_NAME=@DATA@/files/tmp/run/vtest.sock
# OpenGL 3.3 core for D2GL: virgl offers OpenGL 3.x only where the phone's GLES has
# GL_NV_conditional_render (Qualcomm's has not: the guest then offers 2.1) and dual-source blending
# (the server turns it off on Android: devdriver/patches/virglrenderer-gl/0002). D2GL uses
# neither conditional rendering nor SRC1 blending; with 3.3 it gets its core context (also on a
# desktop GLES host). GLSL 3.30 as on the other routes: virgl takes its GLSL level from the
# server, which gives 130 for an OpenGL ES 3.0 host and 310 for most 3.1 hosts, and D2GL's shaders
# are "#version 330": the app greys VirGL where the server gives less than GLSL 3.30 (an OpenGL ES
# 3.0 host, or 3.1 without tessellation, geometry and gpu_shader5 shaders: PhoneGlesDriver.gl33Problem).
# Source: Mesa docs/envvars.rst MESA_GL_VERSION_OVERRIDE, MESA_GLSL_VERSION_OVERRIDE.
PD2_APP_WINE_VIRGL_MESA_GL_VERSION_OVERRIDE=3.3
PD2_APP_WINE_VIRGL_MESA_GLSL_VERSION_OVERRIDE=330

# --- Vulkan on the phone's own driver in the game's process (the libhybris route) --------------
# For Imagination's PowerVR GPUs (the first route there):
# the product Mesa's Zink (the values above) -> the Khronos loader -> our ICD
# libvulkan_pd2hybris.so (build-hybris.sh), which loads the phone's own Vulkan driver
# (/vendor/lib64/hw/vulkan.*.so) into the game's process through libhybris and gives Zink an X11
# swapchain of its own. No server. On this route the app gives the engine
# PD2_APP_WINE_HYBRIS_<NAME>=<value> as <NAME>=<value>, a value of the same name replacing the one
# above, and an empty value leaving <NAME> out; Turnip's own (TU_DEBUG and the Compatibility
# driver's values) are left out too. The app adds HYBRIS_ANDROID_SDK_VERSION (the phone's API
# level: libhybris's linker and hooks for it) and PD2_HYBRIS_STATUS_FILE (the ICD's word on the
# phone's driver, for the app's failure rule). The engine passes HYBRIS_* and PD2_HYBRIS_* to the
# game's Wine processes.
# Sources: Vulkan-Loader docs/LoaderInterfaceArchitecture.md; libhybris hybris/common/hooks.c
# (__hybris_linker_init: HYBRIS_LINKER_DIR, get_android_sdk_version: HYBRIS_ANDROID_SDK_VERSION).
PD2_APP_WINE_HYBRIS_VK_DRIVER_FILES=@USERLAND@/usr/share/vulkan/icd.d/pd2hybris_icd.aarch64.json
PD2_APP_WINE_HYBRIS_VK_ICD_FILENAMES=@USERLAND@/usr/share/vulkan/icd.d/pd2hybris_icd.aarch64.json
# libhybris's linker plugin q.so (the same folder is compiled in; named here so the route does not
# depend on it).
PD2_APP_WINE_HYBRIS_HYBRIS_LINKER_DIR=@USERLAND@/usr/lib/aarch64-linux-gnu/libhybris/linker
# Mesa's software WSI is not on this route (the ICD has its own swapchain).
PD2_APP_WINE_HYBRIS_MESA_VK_WSI_DEBUG=
# OpenGL 3.3 core for D2GL, as on the other phone-driver routes (Zink on the PowerVR driver offers
# 4.6; the Test Lab's PD2 runs on this route had 3.3).
PD2_APP_WINE_HYBRIS_MESA_GL_VERSION_OVERRIDE=3.3
PD2_APP_WINE_HYBRIS_MESA_GLSL_VERSION_OVERRIDE=330

# --- Vulkan and GL on our RADV for Samsung's Xclipse GPUs (the RADV route, build-radv.sh) --------
# For Xclipse GPUs only (DriverChoice): the product Mesa's Zink (glvnd vendor "mesa") on our RADV
# for Xclipse (radv-xclipse, MIT, with our WSI patches: the present counter, the direct present
# into the app's buffers, the app's clock), which opens the GPU's DRM node (/dev/dri/renderD128,
# Samsung's sgpu kernel driver) itself: no server. On that route the app gives the engine
# PD2_APP_WINE_RADV_<NAME>=<value> as <NAME>=<value>, a value of the same name replacing the one
# above, and leaves out Turnip's own (TU_DEBUG and the Compatibility driver's values). The
# engine passes RADV_* variables (RADV_XCLIPSE_LOG and the tree's other switches) to Wine.
# Source: Vulkan-Loader docs/LoaderInterfaceArchitecture.md (as for Turnip above).
PD2_APP_WINE_RADV_VK_DRIVER_FILES=@USERLAND@/usr/share/vulkan/icd.d/radeon_icd.aarch64.json
PD2_APP_WINE_RADV_VK_ICD_FILENAMES=@USERLAND@/usr/share/vulkan/icd.d/radeon_icd.aarch64.json
PD2_APP_WINE_RADV___GLX_VENDOR_LIBRARY_NAME=mesa
PD2_APP_WINE_RADV_MESA_LOADER_DRIVER_OVERRIDE=zink
# OpenGL 3.3 core for D2GL, as on the other routes to a driver the built-in ones do not cover (the
# Test Lab runs of 2026-10-28 on an S24 Exynos ran RADV with these values).
# Source: Mesa docs/envvars.rst MESA_GL_VERSION_OVERRIDE, MESA_GLSL_VERSION_OVERRIDE.
PD2_APP_WINE_RADV_MESA_GL_VERSION_OVERRIDE=3.3
PD2_APP_WINE_RADV_MESA_GLSL_VERSION_OVERRIDE=330

# --- Vulkan and GL on mali-panvk for job-manager Malis (the mali-panvk route, build-mali-panvk.sh)
# For Arm Mali GPUs on kbase's job manager only (Bifrost v6/v7, Valhall v9; DriverChoice): the
# product Mesa's Zink (the values above) on the community PanVK tree mali-panvk (MIT, with our WSI
# patches and our fixes for the tree), which opens /dev/mali0 itself: no server. Our PanVK (the
# Mali values above) stays the driver of the CSF Malis. On that route the app gives the engine
# PD2_APP_WINE_MALI_PANVK_<NAME>=<value> as <NAME>=<value>, a value of the same name replacing the
# one above, and leaves out Turnip's own (TU_DEBUG and the Compatibility driver's values) and the
# CSF Mali values (PD2_APP_WINE_MALI_<NAME>, which never take these). Its ICD is outside icd.d
# (build-mali-panvk.sh), so only these values load the driver.
# Source: Vulkan-Loader docs/LoaderInterfaceArchitecture.md (as for Turnip above).
PD2_APP_WINE_MALI_PANVK_VK_DRIVER_FILES=@USERLAND@/usr/share/mali-panvk/mali_panvk_icd.aarch64.json
PD2_APP_WINE_MALI_PANVK_VK_ICD_FILENAMES=@USERLAND@/usr/share/mali-panvk/mali_panvk_icd.aarch64.json
# OpenGL 3.3 core for D2GL, as on the CSF Malis above. On the job manager the driver has geometry
# shaders and transform feedback, so Zink may offer more; 3.3 keeps D2GL on the smallest part of
# the driver until a game run shows more.
# Source: Mesa docs/envvars.rst MESA_GL_VERSION_OVERRIDE, MESA_GLSL_VERSION_OVERRIDE.
PD2_APP_WINE_MALI_PANVK_MESA_GL_VERSION_OVERRIDE=3.3
PD2_APP_WINE_MALI_PANVK_MESA_GLSL_VERSION_OVERRIDE=330

# --- Fonts -------------------------------------------------------------------------------------
# Source: man fonts-conf(5) (fontconfig-config), FONTCONFIG_FILE; our file lists @USERLAND@/usr/share/fonts.
FONTCONFIG_FILE=@USERLAND@/etc/fonts/fonts.conf

# --- TLS ---------------------------------------------------------------------------------------
# CA bundle written by relocate.sh from ca-certificates' /usr/share/ca-certificates/mozilla.
# Source: OpenSSL SSL_CERT_FILE (also read by rustls-native-certs).
SSL_CERT_FILE=@USERLAND@/etc/ssl/certs/ca-certificates.crt

# --- Name service ------------------------------------------------------------------------------
# @USERLAND@/etc/resolv.conf (placeholder, the app overwrites it), nsswitch.conf and hosts take
# effect only with the glibc patch: glibc reads them from the hard-coded /etc, not sysconfdir.
