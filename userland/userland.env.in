# App userland runtime knobs. relocate.sh installs this as $USERLAND/etc/userland.env with
# @USERLAND@ and @DATA@ replaced. KEY=value lines are the environment the app's service
# gives the programs it starts; commented command lines are how it starts them. Every knob names
# its source (man page in the packaged .deb, or source file and line of the pinned release).
#
# @USERLAND@ = the install prefix; @DATA@ = the app's data folder: config.sh's placeholder, which
# the app rewrites to its canonical data folder as it unpacks the tree.

# --- Libraries ---------------------------------------------------------------------------------
# Only while the userland carries Debian's glibc: its loader searches the absolute Debian paths
# (/lib/aarch64-linux-gnu, /usr/lib/aarch64-linux-gnu), not the prefix. Our loader from
# build-glibc.sh, which searches the prefix, makes this line unnecessary, so relocate.sh drops it with
# PD2_USERLAND_WITH_GLIBC=1 (it would also leak into FEX guests).
# Source: glibc ld.so(8), LD_LIBRARY_PATH. Every ELF interpreter is already @USERLAND@/lib/ld-linux-aarch64.so.1
# (relocate.sh) and absolute RUNPATHs (PulseAudio's .../pulseaudio) are already prefixed.
LD_LIBRARY_PATH=@USERLAND@/usr/lib/aarch64-linux-gnu

# --- Xvfb (built by build-xvfb.sh from xorg-server 21.1.25) -------------------------------------
# Xvfb <display> -screen 0 <W>x<H>x24 -fbfd 3 -extension MIT-SHM \
#      -nolock -nolisten tcp -xkbdir @USERLAND@/usr/share/X11/xkb
#   -fbfd 3             framebuffer in the app's memfd, Xvfb's descriptor 3 (patches/xserver/0003;
#                       Android 11 and later); below Android 11, -fbdir @DATA@/files/tmp/xvfb:
#                       the file DIR/Xvfb_screen0 (man Xvfb, hw/vfb/man/Xvfb.man:66);
#                       never -shmem: SysV shared memory is blocked on Android
#   -extension MIT-SHM  clients fall back to XPutImage (man Xserver, man/Xserver.man:163)
#   -nolock             skips the /tmp lock file and its hard link (os/utils.c LockServer); for
#                       every uid only with patches/xserver/0001
#   -nolisten tcp       (man Xserver, man/Xserver.man:207)
#   -xkbdir DIR         XKB data dir, passed to xkbcomp as -R (man Xserver, man/Xserver.man:422;
#                       xkb/xkbInit.c:745); the compiled-in default is already this path
# No runtime knob, compiled in by build-xvfb.sh (meson options):
#   xkbcomp             @USERLAND@/usr/bin/xkbcomp (xkb_bin_dir; xkb/xkbInit.c:91), run through
#                       /system/bin/sh (patches/xserver/0002; os/utils.c Popen)
#   compiled keymaps    @DATA@/files/tmp/xkb/ (xkb_output_dir; xkb/ddxLoad.c:63-87); the app must
#                       create this directory, else Xvfb falls back to /tmp/, which Android lacks
#   GLX swrast driver   @USERLAND@/usr/lib/aarch64-linux-gnu/dri/swrast_dri.so (DRI_DRIVER_PATH)
# Not relocatable: the X socket path /tmp/.X11-unix/X<n> (xtrans Xtranssock.c:203). xtrans also
# listens on the abstract socket @/tmp/.X11-unix/X<n> (HAVE_ABSTRACT_SOCKETS), which libxcb tries
# first, and which every app on the device shares: hence a display of its own for each app, which
# the app gives Xvfb and its X clients (:0 for the release app, :1 for the development build).

# --- X clients ---------------------------------------------------------------------------------
# libxkbcommon's XKB data root (the Launcher's keymap). Source: libxkbcommon, XKB_CONFIG_ROOT
# (string in libxkbcommon.so.0; compiled-in default /usr/share/X11/xkb).
XKB_CONFIG_ROOT=@USERLAND@/usr/share/X11/xkb
# libX11's locale database. Source: libX11, XLOCALEDIR (string in libX11.so.6; default /usr/share/X11/locale).
XLOCALEDIR=@USERLAND@/usr/share/X11/locale

# --- PulseAudio --------------------------------------------------------------------------------
# pulseaudio -n -F <script> --daemonize=no --use-pid-file=no --exit-idle-time=-1 \
#            --disable-shm=yes -p @USERLAND@/usr/lib/pulse-17.0+dfsg1/modules
#   -n / -F FILE        no default.pa, run our script instead (man pulseaudio(1))
#   -p, --dl-search-path=PATH  module directory; the compiled-in one is the Debian path (man pulseaudio(1))
#   --disable-shm       sockets only: no /dev/shm on Android; --enable-memfd is the alternative
#                       (man pulseaudio(1), man pulse-daemon.conf(5) enable-shm/enable-memfd)
#   --use-pid-file=no, --exit-idle-time=-1   (man pulseaudio(1))
# Runtime and state directories (strings in libpulsecommon-17.0.so; man pulseaudio(1) FILES):
XDG_RUNTIME_DIR=@DATA@/files/tmp/run
PULSE_RUNTIME_PATH=@DATA@/files/tmp/run/pulse
PULSE_STATE_PATH=@DATA@/files/home/.config/pulse

# --- GL (Debian 13 Mesa 25.0.7: Gallium in libgallium, Zink) -------------------------------------
# GL and Vulkan values are the host side of FEX's GL thunk only, so no process gets them as such:
# PD2_APP_FEX_HOSTENV_<NAME>=<value> goes to the Launcher engine alone, which writes it into FEX's
# host-only configuration as "HostEnv": "<NAME>=<value>"; a guest never sees it.
# No LIBGL_DRIVERS_PATH: Mesa 25.0.7 does not read it (docs/relnotes/24.3.0.rst, docs/envvars.rst);
# libgallium is found by the normal library search. dri/zink_dri.so -> libdril_dri.so is ensured
# by relocate.sh (Debian ships it too).
# Source: Mesa docs/envvars.rst (MESA_LOADER_DRIVER_OVERRIDE).
PD2_APP_FEX_HOSTENV_MESA_LOADER_DRIVER_OVERRIDE=zink
# The X server has no DRI3 (Xvfb): GLX and Zink's Kopper must not use it.
PD2_APP_FEX_HOSTENV_LIBGL_DRI3_DISABLE=1
PD2_APP_FEX_HOSTENV_LIBGL_KOPPER_DRI2=1
# glvnd: EGL vendor JSONs are looked up in /etc and /usr/share (string in libEGL.so.1).
# Source: libglvnd README, __EGL_VENDOR_LIBRARY_DIRS / __GLX_VENDOR_LIBRARY_NAME.
PD2_APP_FEX_HOSTENV___EGL_VENDOR_LIBRARY_DIRS=@USERLAND@/usr/share/glvnd/egl_vendor.d
PD2_APP_FEX_HOSTENV___GLX_VENDOR_LIBRARY_NAME=mesa

# --- Vulkan (Turnip, built by build-turnip.sh) ---------------------------------------------------
# Source: Vulkan-Loader docs/LoaderInterfaceArchitecture.md: VK_DRIVER_FILES (VK_ICD_FILENAMES is
# the older name, still honoured; both strings in libvulkan.so.1 1.4.309). The ICD's library_path
# is absolute (@USERLAND@/usr/lib/aarch64-linux-gnu/libvulkan_freedreno.so).
PD2_APP_FEX_HOSTENV_VK_DRIVER_FILES=@USERLAND@/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
PD2_APP_FEX_HOSTENV_VK_ICD_FILENAMES=@USERLAND@/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
# Xvfb has no DRI3, and Mesa's X11 Vulkan WSI refuses a hardware driver's surface without it
# ("vulkan: No DRI3 support detected - required for presentation"): Zink cannot create its
# swapchain and every glXSwapBuffers fails with GLXBadCurrentWindow. "sw" makes the WSI copy
# each frame on the CPU and send it with XPutImage. Source: Mesa docs/envvars.rst,
# MESA_VK_WSI_DEBUG (src/vulkan/wsi/wsi_common.c).
PD2_APP_FEX_HOSTENV_MESA_VK_WSI_DEBUG=sw
# Turnip renders every pass straight to memory (sysmem) instead of choosing GMEM tiles per pass
# (its autotune). D2GL draws thousands of small quads a frame into one framebuffer; tiled, each
# draw goes through the binning pass and is replayed per tile, which on a small-GMEM Adreno costs
# more than the memory traffic it saves.
# Source: Mesa 26.2.3 docs/envvars.rst TU_DEBUG,
# src/freedreno/vulkan/tu_util.cc tu_debug_options ("sysmem").
PD2_APP_FEX_HOSTENV_TU_DEBUG=sysmem
# The app's Compatibility graphics driver: the same Turnip with
# PD2_APP_FEX_COMPATIBILITY_HOSTENV_<NAME>=<value> over the host values above for a Play with it
# (the engine writes them into FEX's HostEnv for that Play, a value of the same name replacing the
# standard one). TU_DEBUG: sysmem (as the standard driver), noubwc turns off
# UBWC compression, nolrz the low-resolution Z pass: the options Mesa names to narrow down a Turnip
# hang or misrendering. Slower, the way out when the standard driver draws wrong or hangs.
# Source: Mesa 26.2.3 docs/drivers/freedreno.rst:507-509, docs/envvars.rst TU_DEBUG,
# src/freedreno/vulkan/tu_util.cc tu_debug_options.
PD2_APP_FEX_COMPATIBILITY_HOSTENV_TU_DEBUG=sysmem,noubwc,nolrz

# --- Vulkan on Mali (PanVK with our kbase backend, built by build-panvk.sh) ---------------------
# On a Mali GPU (Arm's kbase driver, /dev/mali0, no KGSL) the app gives the engine
# PD2_APP_FEX_MALI_HOSTENV_<NAME>=<value> as PD2_APP_FEX_HOSTENV_<NAME>=<value>, a value of the same
# name replacing the one above, and leaves out Turnip's own (TU_DEBUG and the Compatibility
# driver's values); on an Adreno it leaves the Mali values out.
# The ICD's library_path is absolute (@USERLAND@/usr/lib/aarch64-linux-gnu/libvulkan_panfrost.so).
# Source: Vulkan-Loader docs/LoaderInterfaceArchitecture.md (as for Turnip above).
PD2_APP_FEX_MALI_HOSTENV_VK_DRIVER_FILES=@USERLAND@/usr/share/vulkan/icd.d/panfrost_icd.aarch64.json
PD2_APP_FEX_MALI_HOSTENV_VK_ICD_FILENAMES=@USERLAND@/usr/share/vulkan/icd.d/panfrost_icd.aarch64.json
# PanVK refuses a v11 Mali (such as the Mali-G715) as "not well-tested" without this; v10, v12
# and v13 do not read it. Source: Mesa 5bd05bf4 src/panfrost/vulkan/panvk_physical_device.c
# (the arch switch before the physical device is created).
PD2_APP_FEX_MALI_HOSTENV_PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
# PanVK has no transform feedback, so Zink offers GL 2.1 only and D2GL gets no 3.3 core context;
# with these Zink reports 3.3 core and compatibility with GLSL 3.30, and D2GL, which uses neither
# transform feedback nor geometry shaders, draws correctly.
# Source: Mesa docs/envvars.rst MESA_GL_VERSION_OVERRIDE, MESA_GLSL_VERSION_OVERRIDE.
PD2_APP_FEX_MALI_HOSTENV_MESA_GL_VERSION_OVERRIDE=3.3
PD2_APP_FEX_MALI_HOSTENV_MESA_GLSL_VERSION_OVERRIDE=330

# --- FEX (built by build-fex.sh, only with PD2_USERLAND_WITH_FEX=1) -----------------------------
# @USERLAND@/usr/bin/FEX <x86 program> [args]; FEX starts @USERLAND@/usr/bin/FEXServer itself.
# No runtime knob, compiled in (CMAKE_INSTALL_PREFIX=@USERLAND@/usr): host thunks
# @USERLAND@/usr/lib/fex-emu/HostThunks{,_32}, guest thunks @USERLAND@/usr/share/fex-emu/GuestThunks{,_32},
# ThunksDB.json and AppConfig/ in @USERLAND@/usr/share/fex-emu (strings in FEX).
# FEXServer's socket and lock files go to XDG_RUNTIME_DIR (above), else TMPDIR, else /tmp
# (FEX-2609.1 Source/Common/FEXServerClient.cpp:87-100). FEX's config directory is $HOME/.fex-emu/
# if it exists, else $XDG_CONFIG_HOME/fex-emu/ or $HOME/.config/fex-emu/ (Source/Common/Config.cpp:680-708);
# the RootFS is FEX_ROOTFS or that config's RootFS. The app provisions both.
# App-provided FEX, for the Launcher engine only: the entry point
# (build-entry.sh; it execs FEX with the same arguments and environment) and the thunk folders the
# Launcher writes into FEX's configuration (FEX adds _32 for 32-bit guests). The Launcher sets
# FEX's RootFS, configuration, data and cache folders and server socket itself.
PD2_APP_FEX=@USERLAND@/usr/bin/pd2-fex
PD2_APP_FEX_THUNKS_HOST=@USERLAND@/usr/lib/fex-emu/HostThunks
PD2_APP_FEX_THUNKS_GUEST=@USERLAND@/usr/share/fex-emu/GuestThunks

# --- Fonts -------------------------------------------------------------------------------------
# Source: man fonts-conf(5) (fontconfig-config), FONTCONFIG_FILE; our file lists @USERLAND@/usr/share/fonts.
FONTCONFIG_FILE=@USERLAND@/etc/fonts/fonts.conf

# --- TLS ---------------------------------------------------------------------------------------
# CA bundle written by relocate.sh from ca-certificates' /usr/share/ca-certificates/mozilla.
# Source: OpenSSL SSL_CERT_FILE (also read by rustls-native-certs).
SSL_CERT_FILE=@USERLAND@/etc/ssl/certs/ca-certificates.crt

# --- Name service ------------------------------------------------------------------------------
# @USERLAND@/etc/resolv.conf (placeholder, the app overwrites it), nsswitch.conf and hosts take
# effect only with the glibc patch: glibc reads them from the hard-coded /etc, not sysconfdir.
